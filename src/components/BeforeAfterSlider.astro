---
export interface Props {
  beforeImage: string;
  afterImage: string;
  beforeLabel?: string;
  afterLabel?: string;
}

const { 
  beforeImage, 
  afterImage, 
  beforeLabel = "RAW (Before)", 
  afterLabel = "Graded (After)" 
} = Astro.props;
---
<div class="eg-slider-container relative w-full h-[400px] md:h-[500px] rounded-2xl overflow-hidden cursor-ew-resize group select-none shadow-xl border border-[#e7e4dc]">
    <!-- After Image (Background, Full Width) -->
    <img src={afterImage} alt={afterLabel} class="absolute inset-0 w-full h-full object-cover pointer-events-none" />
    
    <!-- Before Image (Clipped overlay) -->
    <div class="eg-slider-before-wrapper absolute inset-0 w-1/2 h-full overflow-hidden border-r-2 border-white shadow-[1px_0_15px_rgba(0,0,0,0.5)]">
        <img src={beforeImage} alt={beforeLabel} class="absolute inset-0 w-[100vw] h-full object-cover max-w-none pointer-events-none" style="width: calc(100% * (1 / (50/100)));" />
    </div>

    <!-- Labels -->
    <div class="absolute top-4 left-4 bg-black/60 backdrop-blur-md text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full shadow-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
        {beforeLabel}
    </div>
    <div class="absolute top-4 right-4 bg-[#e0692a]/90 backdrop-blur-md text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full shadow-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
        {afterLabel}
    </div>

    <!-- Drag Handle -->
    <div class="eg-slider-handle absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 bg-white/90 backdrop-blur-sm rounded-full shadow-2xl flex items-center justify-center pointer-events-none transition-transform group-hover:scale-110">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 9l-4 3 4 3m8-6l4 3-4 3" />
        </svg>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const sliders = document.querySelectorAll('.eg-slider-container');
        
        sliders.forEach(slider => {
            const beforeWrapper = slider.querySelector('.eg-slider-before-wrapper') as HTMLElement;
            const beforeImage = beforeWrapper.querySelector('img') as HTMLElement;
            const handle = slider.querySelector('.eg-slider-handle') as HTMLElement;
            
            let isDragging = false;
            
            const updateSlider = (e: MouseEvent | TouchEvent) => {
                const rect = slider.getBoundingClientRect();
                let clientX = e.type.includes('mouse') ? (e as MouseEvent).clientX : (e as TouchEvent).touches[0].clientX;
                
                // Calculate percentage (0 to 100)
                let percent = ((clientX - rect.left) / rect.width) * 100;
                percent = Math.max(0, Math.min(percent, 100)); // Clamp
                
                // Update CSS
                beforeWrapper.style.width = `${percent}%`;
                handle.style.left = `${percent}%`;
                
                // Keep inner image fixed width to match container exactly
                beforeImage.style.width = `${rect.width}px`;
            };

            // Fix image width on resize
            const fixImageWidth = () => {
                const rect = slider.getBoundingClientRect();
                beforeImage.style.width = `${rect.width}px`;
            };
            window.addEventListener('resize', fixImageWidth);
            fixImageWidth(); // Init

            // Mouse Events
            slider.addEventListener('mousedown', (e) => {
                isDragging = true;
                updateSlider(e as MouseEvent);
            });
            window.addEventListener('mouseup', () => isDragging = false);
            window.addEventListener('mousemove', (e) => {
                if (isDragging) updateSlider(e as MouseEvent);
            });

            // Touch Events
            slider.addEventListener('touchstart', (e) => {
                isDragging = true;
                updateSlider(e as TouchEvent);
            }, { passive: true });
            window.addEventListener('touchend', () => isDragging = false);
            window.addEventListener('touchmove', (e) => {
                if (isDragging) updateSlider(e as TouchEvent);
            }, { passive: true });
        });
    });
</script>
