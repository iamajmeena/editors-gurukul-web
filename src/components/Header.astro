</header>

<!-- Mobile Slide-Out Navigation Drawer Overlay -->
<div id="eg-mobile-drawer" class="fixed inset-0 z-[9999] bg-black/60 backdrop-blur-sm hidden flex-col justify-end md:hidden">
    <div class="bg-white w-full max-h-[85vh] rounded-t-3xl p-6 overflow-y-auto shadow-2xl flex flex-col gap-4 border-t-2 border-[#0a5f61]">
        <div class="flex justify-between items-center pb-3 border-b border-[#e7e4dc]">
            <a href="/" class="font-['Bebas_Neue'] text-2xl tracking-wide text-[#15181c] no-underline">EDITORS<span class="text-[#e0692a]">GURUKUL</span></a>
            <button type="button" id="eg-mobile-close-btn" class="w-9 h-9 rounded-full bg-[#f4f3ef] text-[#15181c] font-extrabold flex items-center justify-center cursor-pointer text-lg">✕</button>
        </div>

        <nav class="flex flex-col gap-2 font-semibold">
            <a href="/" class="p-3 rounded-xl hover:bg-[#e4f3f2] text-[#15181c]">🏠 Home</a>
            <a href="/digital-store" class="p-3 rounded-xl bg-[#e4f3f2] text-[#0a5f61] font-extrabold">🛒 Digital Products Store</a>
            <a href="/trending-github-repos" class="p-3 rounded-xl bg-amber-50 text-amber-900 border border-amber-300 font-extrabold">⭐ Trending GitHub Repos</a>
            <a href="/guides" class="p-3 rounded-xl hover:bg-[#e4f3f2] text-[#0a5f61] font-bold">📚 All Guides Index</a>
            <a href="/camera-guides" class="p-3 rounded-xl hover:bg-[#e4f3f2] text-[#4b5058]">📷 Camera Guides</a>
            <a href="/lens-guides" class="p-3 rounded-xl hover:bg-[#e4f3f2] text-[#4b5058]">🔎 Lens Guides</a>
            <a href="/lighting-guides" class="p-3 rounded-xl hover:bg-[#e4f3f2] text-[#4b5058]">💡 Lighting Guides</a>
            <a href="/filmmaking-guides" class="p-3 rounded-xl hover:bg-[#e4f3f2] text-[#4b5058]">🎥 Filmmaking &amp; Gear</a>
            <a href="/storytelling-guides" class="p-3 rounded-xl hover:bg-[#e4f3f2] text-[#4b5058]">✍️ Storytelling &amp; Craft</a>
            <a href="/career-guides" class="p-3 rounded-xl hover:bg-[#e4f3f2] text-[#4b5058]">💼 Career &amp; Business</a>
            <a href="/free-resources" class="p-3 rounded-xl hover:bg-[#e4f3f2] text-[#4b5058]">🎁 Free Resources &amp; LUTs</a>
            <a href="/my-gear" class="p-3 rounded-xl hover:bg-[#e4f3f2] text-[#4b5058]">⚡ My Gear List</a>
        </nav>


        <a href="https://www.ajaykmeena.com/courses/Decoding-DaVinci-Resolve-20--The-Ultimate-course-for-Video-Editing-Color-Grading--AI-Powered-Filmmaking-69b89bb32c97f8fb76db7ee8" target="_blank" rel="noopener noreferrer" class="w-full py-3.5 bg-[#e0692a] text-white font-extrabold text-center rounded-full shadow-lg hover:bg-[#c85720] no-underline mt-2">Decoding DaVinci 2.0 🎓</a>
    </div>
</div>

<script is:inline>
  (function() {
    var toggleBtn = document.getElementById('eg-mobile-toggle-btn');
    var closeBtn = document.getElementById('eg-mobile-close-btn');
    var drawer = document.getElementById('eg-mobile-drawer');

    if (toggleBtn && drawer) {
      toggleBtn.addEventListener('click', function() {
        drawer.classList.remove('hidden');
        drawer.classList.add('flex');
        document.body.style.overflow = 'hidden';
      });
    }

    if (closeBtn && drawer) {
      closeBtn.addEventListener('click', function() {
        drawer.classList.add('hidden');
        drawer.classList.remove('flex');
        document.body.style.overflow = '';
      });
    }

    if (drawer) {
      drawer.addEventListener('click', function(e) {
        if (e.target === drawer) {
          drawer.classList.add('hidden');
          drawer.classList.remove('flex');
          document.body.style.overflow = '';
        }
      });
    }
  })();
</script>

