---
const { darkTheme = false } = Astro.props;
---
<header class={darkTheme ? "bg-[#130924]/95 backdrop-blur-md border-b border-[#3b1d5c] sticky top-0 z-50 py-3 px-6 shadow-2xl" : "bg-white/90 backdrop-blur-md border-b border-[#e7e4dc] sticky top-0 z-50 py-3 px-6"}>
    <div class="max-w-6xl mx-auto flex justify-between items-center">
        <!-- Logo: Original Orange on normal pages, Electric Purple on darkTheme pages -->
        <a href="/" class={darkTheme ? "font-['Bebas_Neue'] text-2xl tracking-wide text-white no-underline block" : "font-['Bebas_Neue'] text-2xl tracking-wide text-[#15181c] no-underline block"}>EDITORS<span class={darkTheme ? "text-[#c084fc]" : "text-[#e0692a]"}>GURUKUL</span></a>
        
        <!-- Desktop Navigation -->
        <nav class="hidden md:flex gap-6 items-center">
            <a href="/" class={darkTheme ? "text-[#e9d5ff] font-semibold text-[0.95rem] hover:text-[#c084fc] no-underline" : "text-[#4b5058] font-semibold text-[0.95rem] hover:text-[#0a5f61] no-underline"}>Home</a>
            <a href="/free-websites" class={darkTheme ? "text-[#c084fc] font-bold text-[0.95rem] hover:text-white no-underline" : "text-[#c084fc] font-bold text-[0.95rem] hover:text-[#7c3aed] no-underline"}>Free Tools</a>
            <a href="/glyph-motions.html" class="text-[#b7ff32] font-bold text-[0.95rem] hover:text-[#9ae62b] no-underline inline-flex items-center gap-1"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h3l2-7 4 14 2-7h7"/></svg>Glyph Motions</a>
            <a href="/my-gear" class={darkTheme ? "text-[#e9d5ff] font-semibold text-[0.95rem] hover:text-[#c084fc] no-underline" : "text-[#4b5058] font-semibold text-[0.95rem] hover:text-[#0a5f61] no-underline"}>My Gear</a>
            <a href="https://www.ajaykmeena.com/courses/Decoding-DaVinci-Resolve-20--The-Ultimate-course-for-Video-Editing-Color-Grading--AI-Powered-Filmmaking-69b89bb32c97f8fb76db7ee8" target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-[#8b5cf6] text-white font-bold text-sm rounded-full hover:bg-[#7c3aed] transition-colors no-underline shadow-lg border border-[#c084fc]/50">Decoding DaVinci 2.0 <svg class="w-4 h-4 inline-block align-[-3px] ml-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3L2 8l10 5 10-5-10-5z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/></svg></a>
        </nav>

        <!-- Mobile Menu Toggle Button -->
        <button type="button" id="eg-mobile-toggle-btn" class={darkTheme ? "md:hidden flex items-center justify-center p-2 rounded-lg border border-[#4c247d] text-white hover:bg-[#25133d] cursor-pointer" : "md:hidden flex items-center justify-center p-2 rounded-lg border border-[#e7e4dc] text-[#15181c] hover:bg-[#f4f3ef] cursor-pointer"} aria-label="Toggle navigation menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>
</header>

<!-- Mobile Slide-Out Navigation Drawer (Dynamic Theme for High Contrast) -->
<div id="eg-mobile-drawer" class="fixed inset-0 z-[9999] bg-black/80 backdrop-blur-md hidden flex-col justify-end md:hidden">
    <div class={darkTheme ? "bg-[#160b2b] text-white w-full max-h-[85vh] rounded-t-3xl p-6 overflow-y-auto shadow-2xl flex flex-col gap-4 border-t-2 border-[#8b5cf6]" : "bg-white text-[#15181c] w-full max-h-[85vh] rounded-t-3xl p-6 overflow-y-auto shadow-2xl flex flex-col gap-4 border-t-2 border-[#e0692a]"}>
        <div class="flex justify-between items-center pb-3 border-b border-[#e7e4dc] dark:border-[#3b1d5c]">
            <a href="/" class={darkTheme ? "font-['Bebas_Neue'] text-2xl tracking-wide text-white no-underline block" : "font-['Bebas_Neue'] text-2xl tracking-wide text-[#15181c] no-underline block"}>EDITORS<span class={darkTheme ? "text-[#c084fc]" : "text-[#e0692a]"}>GURUKUL</span></a>
            <button type="button" id="eg-mobile-close-btn" aria-label="Close menu" class={darkTheme ? "w-9 h-9 rounded-full bg-[#2a134a] text-white font-extrabold flex items-center justify-center cursor-pointer text-lg" : "w-9 h-9 rounded-full bg-[#f4f3ef] text-[#15181c] font-extrabold flex items-center justify-center cursor-pointer text-lg"}><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        </div>

        <nav class="flex flex-col gap-2 font-semibold">
            <a href="/" class={darkTheme ? "p-3 rounded-xl hover:bg-[#2e1552] text-white no-underline" : "p-3 rounded-xl hover:bg-[#f4f3ef] text-[#15181c] no-underline"}><svg class="w-4 h-4 inline-block align-[-3px] mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11l8-7 8 7"/><path d="M6 10v9a1 1 0 001 1h3v-5a2 2 0 014 0v5h3a1 1 0 001-1v-9"/></svg>Home</a>
            <a href="/free-websites" class="p-3 rounded-xl bg-[#7c3aed] text-white font-extrabold shadow-lg no-underline"><svg class="w-4 h-4 inline-block align-[-3px] mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.2 2.3 2.2 15.2 0 17M12 3.5c-2.2 2.3-2.2 15.2 0 17"/></svg>Free Tools</a>
            <a href="/glyph-motions.html" class="p-3 rounded-xl bg-[#1a2b0a] text-[#b7ff32] font-extrabold shadow-lg no-underline border border-[#b7ff32]/40"><svg class="w-4 h-4 inline-block align-[-3px] mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h3l2-7 4 14 2-7h7"/></svg>Glyph Motions</a>
            <a href="/my-gear" class={darkTheme ? "p-3 rounded-xl hover:bg-[#2e1552] text-[#e9d5ff] no-underline" : "p-3 rounded-xl hover:bg-[#f4f3ef] text-[#4b5058] no-underline"}><svg class="w-4 h-4 inline-block align-[-3px] mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2.5L5 14h6l-1 7.5 9-13h-6l1-6z"/></svg>My Gear List</a>
        </nav>

        <a href="https://www.ajaykmeena.com/courses/Decoding-DaVinci-Resolve-20--The-Ultimate-course-for-Video-Editing-Color-Grading--AI-Powered-Filmmaking-69b89bb32c97f8fb76db7ee8" target="_blank" rel="noopener noreferrer" class="w-full py-3.5 bg-[#e0692a] text-white font-extrabold text-center rounded-full shadow-lg hover:bg-[#c8561b] no-underline mt-2">Decoding DaVinci 2.0 <svg class="w-4 h-4 inline-block align-[-3px] ml-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3L2 8l10 5 10-5-10-5z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/></svg></a>
    </div>
</div>

<script is:inline>
  (function() {
    var toggleBtn = document.getElementById('eg-mobile-toggle-btn');
    var closeBtn = document.getElementById('eg-mobile-close-btn');
    var drawer = document.getElementById('eg-mobile-drawer');

    if (toggleBtn && drawer) {
      toggleBtn.addEventListener('click', function() {
        drawer.classList.remove('hidden');
        drawer.classList.add('flex');
        document.body.style.overflow = 'hidden';
      });
    }

    if (closeBtn && drawer) {
      closeBtn.addEventListener('click', function() {
        drawer.classList.add('hidden');
        drawer.classList.remove('flex');
        document.body.style.overflow = '';
      });
    }

    if (drawer) {
      drawer.addEventListener('click', function(e) {
        if (e.target === drawer) {
          drawer.classList.add('hidden');
          drawer.classList.remove('flex');
          document.body.style.overflow = '';
        }
      });
    }
  })();
</script>
