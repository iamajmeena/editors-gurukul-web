---
const { darkTheme = false } = Astro.props;
---
<header class={darkTheme ? "bg-[#130924]/95 backdrop-blur-md border-b border-[#3b1d5c] sticky top-0 z-50 py-3 px-6 shadow-2xl" : "bg-white/90 backdrop-blur-md border-b border-[#e7e4dc] sticky top-0 z-50 py-3 px-6"}>
    <div class="max-w-6xl mx-auto flex justify-between items-center">
        <!-- Logo: Original Orange on normal pages, Electric Purple on darkTheme pages -->
        <a href="/" class={darkTheme ? "font-['Bebas_Neue'] text-2xl tracking-wide text-white no-underline block" : "font-['Bebas_Neue'] text-2xl tracking-wide text-[#15181c] no-underline block"}>EDITORS<span class={darkTheme ? "text-[#c084fc]" : "text-[#e0692a]"}>GURUKUL</span></a>
        
        <!-- Desktop Navigation -->
        <nav class="hidden md:flex gap-6 items-center">
            <a href="/" class={darkTheme ? "text-[#e9d5ff] font-semibold text-[0.95rem] hover:text-[#c084fc] no-underline" : "text-[#4b5058] font-semibold text-[0.95rem] hover:text-[#0a5f61] no-underline"}>Home</a>
            <div class="relative group">
                <button type="button" class={darkTheme ? "text-[#e9d5ff] font-semibold text-[0.95rem] hover:text-[#c084fc] inline-flex items-center gap-1 cursor-pointer bg-transparent border-0" : "text-[#4b5058] font-semibold text-[0.95rem] hover:text-[#0a5f61] inline-flex items-center gap-1 cursor-pointer bg-transparent border-0"}>
                    All Guides &amp; Tools
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>
                <div class={darkTheme ? "absolute left-0 mt-2 w-64 bg-[#1a0c33] border border-[#4c247d] rounded-xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 py-1 max-h-[80vh] overflow-y-auto" : "absolute left-0 mt-2 w-64 bg-white border border-[#e7e4dc] rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 py-1 max-h-[80vh] overflow-y-auto"}>
                    <a href="/instagram-follower-counter" class="block px-4 py-2.5 text-sm font-extrabold text-[#e1306c] hover:bg-[#e1306c]/20 no-underline border-b border-[#e1306c]/30">🔥 Live IG Follower Counter</a>
                    <a href="/guides" class={darkTheme ? "block px-4 py-2.5 text-sm font-semibold text-[#e9d5ff] hover:bg-[#2e1552] hover:text-white no-underline" : "block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61] no-underline"}>All Guides Index</a>
                    <a href="/guides#davinci-resolve" class={darkTheme ? "block px-4 py-2.5 text-sm font-semibold text-[#e9d5ff] hover:bg-[#2e1552] hover:text-white no-underline" : "block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61] no-underline"}>🎬 DaVinci Resolve Guides</a>
                    <a href="/camera-guides" class={darkTheme ? "block px-4 py-2.5 text-sm font-semibold text-[#e9d5ff] hover:bg-[#2e1552] hover:text-white no-underline" : "block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61] no-underline"}>📷 Camera Guides</a>
                    <a href="/lens-guides" class={darkTheme ? "block px-4 py-2.5 text-sm font-semibold text-[#e9d5ff] hover:bg-[#2e1552] hover:text-white no-underline" : "block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61] no-underline"}>🔎 Lens Guides</a>
                    <a href="/lighting-guides" class={darkTheme ? "block px-4 py-2.5 text-sm font-semibold text-[#e9d5ff] hover:bg-[#2e1552] hover:text-white no-underline" : "block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61] no-underline"}>💡 Lighting Guides</a>
                    <a href="/filmmaking-guides" class={darkTheme ? "block px-4 py-2.5 text-sm font-semibold text-[#e9d5ff] hover:bg-[#2e1552] hover:text-white no-underline" : "block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61] no-underline"}>🎥 Filmmaking &amp; Gear</a>
                    <a href="/storytelling-guides" class={darkTheme ? "block px-4 py-2.5 text-sm font-semibold text-[#e9d5ff] hover:bg-[#2e1552] hover:text-white no-underline" : "block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61] no-underline"}>✍️ Storytelling &amp; Craft</a>
                    <a href="/career-guides" class={darkTheme ? "block px-4 py-2.5 text-sm font-semibold text-[#e9d5ff] hover:bg-[#2e1552] hover:text-white no-underline" : "block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61] no-underline"}>💼 Career &amp; Business</a>
                    <a href="/trending-github-repos" class="block px-4 py-2.5 text-sm font-bold text-[#c084fc] hover:bg-[#2e1552] no-underline">⭐ Trending GitHub Repos</a>
                    <a href="/free-resources" class={darkTheme ? "block px-4 py-2.5 text-sm font-semibold text-[#e9d5ff] hover:bg-[#2e1552] hover:text-white no-underline" : "block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61] no-underline"}>🎁 Free Resources &amp; LUTs</a>
                </div>
            </div>
            <a href="/instagram-follower-counter" class="text-[#e1306c] font-extrabold text-[0.95rem] hover:opacity-80 no-underline flex items-center gap-1">📸 Live IG Counter</a>
            <a href="/trending-github-repos" class={darkTheme ? "text-[#c084fc] font-bold text-[0.95rem] hover:text-white no-underline" : "text-[#c084fc] font-bold text-[0.95rem] hover:text-[#7c3aed] no-underline"}>GitHub Repos</a>
            <a href="/my-gear" class={darkTheme ? "text-[#e9d5ff] font-semibold text-[0.95rem] hover:text-[#c084fc] no-underline" : "text-[#4b5058] font-semibold text-[0.95rem] hover:text-[#0a5f61] no-underline"}>My Gear</a>
            <a href="/digital-store" class={darkTheme ? "text-[#c084fc] font-extrabold text-[0.95rem] hover:text-white flex items-center gap-1 no-underline" : "text-[#0a5f61] font-extrabold text-[0.95rem] hover:text-[#e0692a] flex items-center gap-1 no-underline"}>🛒 Digital Store</a>
            <a href="https://www.ajaykmeena.com/courses/Decoding-DaVinci-Resolve-20--The-Ultimate-course-for-Video-Editing-Color-Grading--AI-Powered-Filmmaking-69b89bb32c97f8fb76db7ee8" target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-[#8b5cf6] text-white font-bold text-sm rounded-full hover:bg-[#7c3aed] transition-colors no-underline shadow-lg border border-[#c084fc]/50">Decoding DaVinci 2.0 🎓</a>
        </nav>

        <!-- Mobile Menu Toggle Button -->
        <button type="button" id="eg-mobile-toggle-btn" class={darkTheme ? "md:hidden flex items-center justify-center p-2 rounded-lg border border-[#4c247d] text-white hover:bg-[#25133d] cursor-pointer" : "md:hidden flex items-center justify-center p-2 rounded-lg border border-[#e7e4dc] text-[#15181c] hover:bg-[#f4f3ef] cursor-pointer"} aria-label="Toggle navigation menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>
</header>

<!-- Mobile Slide-Out Navigation Drawer (Dynamic Theme for High Contrast) -->
<div id="eg-mobile-drawer" class="fixed inset-0 z-[9999] bg-black/80 backdrop-blur-md hidden flex-col justify-end md:hidden">
    <div class={darkTheme ? "bg-[#160b2b] text-white w-full max-h-[85vh] rounded-t-3xl p-6 overflow-y-auto shadow-2xl flex flex-col gap-4 border-t-2 border-[#8b5cf6]" : "bg-white text-[#15181c] w-full max-h-[85vh] rounded-t-3xl p-6 overflow-y-auto shadow-2xl flex flex-col gap-4 border-t-2 border-[#e0692a]"}>
        <div class="flex justify-between items-center pb-3 border-b border-[#e7e4dc] dark:border-[#3b1d5c]">
            <a href="/" class={darkTheme ? "font-['Bebas_Neue'] text-2xl tracking-wide text-white no-underline block" : "font-['Bebas_Neue'] text-2xl tracking-wide text-[#15181c] no-underline block"}>EDITORS<span class={darkTheme ? "text-[#c084fc]" : "text-[#e0692a]"}>GURUKUL</span></a>
            <button type="button" id="eg-mobile-close-btn" class={darkTheme ? "w-9 h-9 rounded-full bg-[#2a134a] text-white font-extrabold flex items-center justify-center cursor-pointer text-lg" : "w-9 h-9 rounded-full bg-[#f4f3ef] text-[#15181c] font-extrabold flex items-center justify-center cursor-pointer text-lg"}>✕</button>
        </div>

        <nav class="flex flex-col gap-2 font-semibold">
            <a href="/" class={darkTheme ? "p-3 rounded-xl hover:bg-[#2e1552] text-white no-underline" : "p-3 rounded-xl hover:bg-[#f4f3ef] text-[#15181c] no-underline"}>🏠 Home</a>
            <a href="/instagram-follower-counter" class="p-3 rounded-xl bg-[#e1306c] text-white font-extrabold shadow-lg no-underline">📸 Live IG Follower Counter</a>
            <a href="/digital-store" class={darkTheme ? "p-3 rounded-xl bg-[#2e1552] text-[#c084fc] font-extrabold no-underline" : "p-3 rounded-xl bg-[#fff6f0] text-[#e0692a] font-extrabold no-underline"}>🛒 Digital Products Store</a>
            <a href="/trending-github-repos" class="p-3 rounded-xl bg-[#7c3aed] text-white font-extrabold shadow-lg no-underline">⭐ Trending GitHub Repos</a>
            <a href="/guides" class={darkTheme ? "p-3 rounded-xl hover:bg-[#2e1552] text-[#e9d5ff] font-bold no-underline" : "p-3 rounded-xl hover:bg-[#f4f3ef] text-[#4b5058] font-bold no-underline"}>📚 All Guides Index</a>
            <a href="/camera-guides" class={darkTheme ? "p-3 rounded-xl hover:bg-[#2e1552] text-[#e9d5ff] no-underline" : "p-3 rounded-xl hover:bg-[#f4f3ef] text-[#4b5058] no-underline"}>📷 Camera Guides</a>
            <a href="/lens-guides" class={darkTheme ? "p-3 rounded-xl hover:bg-[#2e1552] text-[#e9d5ff] no-underline" : "p-3 rounded-xl hover:bg-[#f4f3ef] text-[#4b5058] no-underline"}>🔎 Lens Guides</a>
            <a href="/lighting-guides" class={darkTheme ? "p-3 rounded-xl hover:bg-[#2e1552] text-[#e9d5ff] no-underline" : "p-3 rounded-xl hover:bg-[#f4f3ef] text-[#4b5058] no-underline"}>💡 Lighting Guides</a>
            <a href="/filmmaking-guides" class={darkTheme ? "p-3 rounded-xl hover:bg-[#2e1552] text-[#e9d5ff] no-underline" : "p-3 rounded-xl hover:bg-[#f4f3ef] text-[#4b5058] no-underline"}>🎥 Filmmaking &amp; Gear</a>
            <a href="/storytelling-guides" class={darkTheme ? "p-3 rounded-xl hover:bg-[#2e1552] text-[#e9d5ff] no-underline" : "p-3 rounded-xl hover:bg-[#f4f3ef] text-[#4b5058] no-underline"}>✍️ Storytelling &amp; Craft</a>
            <a href="/career-guides" class={darkTheme ? "p-3 rounded-xl hover:bg-[#2e1552] text-[#e9d5ff] no-underline" : "p-3 rounded-xl hover:bg-[#f4f3ef] text-[#4b5058] no-underline"}>💼 Career &amp; Business</a>
            <a href="/free-resources" class={darkTheme ? "p-3 rounded-xl hover:bg-[#2e1552] text-[#e9d5ff] no-underline" : "p-3 rounded-xl hover:bg-[#f4f3ef] text-[#4b5058] no-underline"}>🎁 Free Resources &amp; LUTs</a>
            <a href="/my-gear" class={darkTheme ? "p-3 rounded-xl hover:bg-[#2e1552] text-[#e9d5ff] no-underline" : "p-3 rounded-xl hover:bg-[#f4f3ef] text-[#4b5058] no-underline"}>⚡ My Gear List</a>
        </nav>

        <a href="https://www.ajaykmeena.com/courses/Decoding-DaVinci-Resolve-20--The-Ultimate-course-for-Video-Editing-Color-Grading--AI-Powered-Filmmaking-69b89bb32c97f8fb76db7ee8" target="_blank" rel="noopener noreferrer" class="w-full py-3.5 bg-[#e0692a] text-white font-extrabold text-center rounded-full shadow-lg hover:bg-[#c8561b] no-underline mt-2">Decoding DaVinci 2.0 🎓</a>
    </div>
</div>

<script is:inline>
  (function() {
    var toggleBtn = document.getElementById('eg-mobile-toggle-btn');
    var closeBtn = document.getElementById('eg-mobile-close-btn');
    var drawer = document.getElementById('eg-mobile-drawer');

    if (toggleBtn && drawer) {
      toggleBtn.addEventListener('click', function() {
        drawer.classList.remove('hidden');
        drawer.classList.add('flex');
        document.body.style.overflow = 'hidden';
      });
    }

    if (closeBtn && drawer) {
      closeBtn.addEventListener('click', function() {
        drawer.classList.add('hidden');
        drawer.classList.remove('flex');
        document.body.style.overflow = '';
      });
    }

    if (drawer) {
      drawer.addEventListener('click', function(e) {
        if (e.target === drawer) {
          drawer.classList.add('hidden');
          drawer.classList.remove('flex');
          document.body.style.overflow = '';
        }
      });
    }
  })();
</script>
