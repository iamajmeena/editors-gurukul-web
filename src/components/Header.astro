<header class="bg-white/90 backdrop-blur-md border-b border-[#e7e4dc] sticky top-0 z-50 py-3 px-6">
    <div class="max-w-[1100px] mx-auto flex justify-between items-center">
        <a href="/" class="font-['Bebas_Neue'] text-2xl tracking-wide text-[#15181c] no-underline">EDITORS<span class="text-[#e0692a]">GURUKUL</span></a>
        
        <!-- Desktop Navigation -->
        <nav class="hidden md:flex gap-6 items-center">
            <a href="/" class="text-[#4b5058] font-semibold text-[0.95rem] hover:text-[#0a5f61]">Home</a>
            <div class="relative group">
                <button type="button" class="text-[#4b5058] font-semibold text-[0.95rem] hover:text-[#0a5f61] inline-flex items-center gap-1 cursor-pointer">
                    All Guides
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>
                <div class="absolute left-0 mt-2 w-64 bg-white border border-[#e7e4dc] rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 py-1 max-h-[80vh] overflow-y-auto">
                    <a href="/guides" class="block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61]">All Guides Index</a>
                    <a href="/guides#davinci-resolve" class="block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61]">🎬 DaVinci Resolve Guides</a>
                    <a href="/camera-guides" class="block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61]">📷 Camera Guides</a>
                    <a href="/lens-guides" class="block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61]">🔎 Lens Guides</a>
                    <a href="/lighting-guides" class="block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61]">💡 Lighting Guides</a>
                    <a href="/filmmaking-guides" class="block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61]">🎥 Filmmaking &amp; Gear</a>
                    <a href="/storytelling-guides" class="block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61]">✍️ Storytelling &amp; Craft</a>
                    <a href="/career-guides" class="block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61]">💼 Career &amp; Business</a>
                    <a href="/trending-github-repos" class="block px-4 py-2.5 text-sm font-bold text-[#e0692a] hover:bg-[#e4f3f2]">⭐ Trending GitHub Repos</a>
                    <a href="/free-resources" class="block px-4 py-2.5 text-sm font-semibold text-[#4b5058] hover:bg-[#e4f3f2] hover:text-[#0a5f61]">🎁 Free Resources &amp; LUTs</a>
                </div>
            </div>
            <a href="/trending-github-repos" class="text-[#4b5058] font-semibold text-[0.95rem] hover:text-[#0a5f61]">GitHub Repos</a>
            <a href="/my-gear" class="text-[#4b5058] font-semibold text-[0.95rem] hover:text-[#0a5f61]">My Gear</a>
            <a href="/digital-store" class="text-[#0a5f61] font-extrabold text-[0.95rem] hover:text-[#e0692a] flex items-center gap-1">🛒 Digital Store</a>
            <a href="https://www.ajaykmeena.com/courses/Decoding-DaVinci-Resolve-20--The-Ultimate-course-for-Video-Editing-Color-Grading--AI-Powered-Filmmaking-69b89bb32c97f8fb76db7ee8" target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-[#e0692a] text-white font-bold text-sm rounded-full hover:bg-[#c85720] transition-colors no-underline shadow-sm">Decoding DaVinci 2.0 🎓</a>
        </nav>

        <!-- Mobile Menu Toggle Button -->
        <button type="button" id="eg-mobile-toggle-btn" class="md:hidden flex items-center justify-center p-2 rounded-lg border border-[#e7e4dc] text-[#15181c] hover:bg-[#f4f3ef] cursor-pointer" aria-label="Toggle navigation menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
