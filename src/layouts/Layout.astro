---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title, description } = Astro.props;

const pageTitle = title || "Editors Gurukul | Free Filmmaking Guides, LUTs & Gear";
const pageDesc = description || "Editors Gurukul offers free filmmaking guides, LUT resources, camera cheat sheets, and premium courses for creators and editors.";
const canonicalURL = new URL(Astro.url.pathname, "https://editorsgurukul.com").toString();

const schemaData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Editors Gurukul",
  "url": "https://editorsgurukul.com/",
  "description": pageDesc,
  "author": {
    "@type": "Person",
    "name": "Ajay K Meena",
    "jobTitle": "Cinematographer & Colorist",
    "sameAs": [
      "https://youtube.com/@ajaykmeenaa",
      "https://instagram.com/iamajmeena",
      "https://ajaykmeena.com"
    ]
  }
});
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="monetag" content="fe9be61e87a67ccaa8693a77ed8bdc8c">
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc}>
    <meta name="robots" content="index, follow">
    <link rel="canonical" href={canonicalURL}>
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/assets/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Sora:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    
    <!-- Open Graph & Twitter Meta -->
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={pageDesc}>
    <meta property="og:image" content="https://editorsgurukul.com/assets/og-default.jpg">
    <meta property="og:url" content={canonicalURL}>
    <meta name="twitter:card" content="summary_large_image">

    <!-- Schema.org JSON-LD Structured Data for Google SEO & AdSense -->
    <script type="application/ld+json" set:html={schemaData} />

    <!-- Google Analytics (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-E9YPJM7G00"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E9YPJM7G00');
    </script>

    <!-- Monetag MultiTag Ad Tags (Zone 11473498 & Zone 265803) - 100% Unconditional Direct Loading -->
    <script is:inline data-cfasync="false" src="https://3nbf4.com/act/files/tag.min.js?z=11473498" async></script>
    <script is:inline src="https://quge5.com/88/tag.min.js" data-zone="265803" async data-cfasync="false"></script>
</head>
<body class="bg-[#faf9f6] text-[#15181c] font-['Sora',sans-serif]">
    <Header />
    <main class="min-h-screen">
        <slot />
    </main>
    <Footer />

    <!-- Floating Hindi Toggle -->
    <button id="eg-lang-toggle-btn" class="eg-lang-toggle notranslate" type="button" onclick="window.egToggleHindi ? window.egToggleHindi() : null">
        हिंदी में पढ़ें
    </button>

    <!-- Anti-AdBlocker Detection Fullscreen Modal & Script -->
    <div id="eg-adblock-modal" class="hidden fixed inset-0 z-[999999] bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
      <div class="bg-white border-2 border-[#e0692a] p-8 rounded-3xl max-w-md w-full text-center shadow-2xl animate-fade-in">
        <div class="w-16 h-16 bg-[#fdece0] text-[#e0692a] rounded-full flex items-center justify-center mx-auto mb-4 text-3xl font-extrabold">
          🛡️
        </div>
        <h2 class="text-2xl font-extrabold text-[#15181c] mb-3">
          AdBlocker Detected!
        </h2>
        <p class="text-sm text-[#4b5058] leading-relaxed mb-6">
          Please <strong>disable your AdBlocker</strong> (or pause AdGuard, uBlock, Brave Shield) for <u>editorsgurukul.com</u> to access the Free iPhone Music Apps Guide and PDF Download.
        </p>
        <button onclick="window.location.reload()" class="w-full py-4 bg-[#0a5f61] text-white font-extrabold text-base rounded-full hover:bg-[#074749] transition-all shadow-lg cursor-pointer">
          ↻ I Have Disabled AdBlocker (Refresh)
        </button>
        <p class="text-xs text-[#9ca3af] mt-4 mb-0">
          Thank you for supporting free content on Editors Gurukul!
        </p>
      </div>
    </div>

    <script is:inline>
      (function() {
        // Create bait element to test AdBlocker
        function checkAdBlock() {
          var bait = document.createElement('div');
          bait.className = 'adsbygoogle ad-zone ad-space page-ad sponsor-ad';
          bait.style.cssText = 'position:absolute;left:-9999px;top:-9999px;height:10px;width:10px;';
          document.body.appendChild(bait);

          var isBlocked = false;
          
          // Test 1: Element height/visibility check
          if (bait.offsetParent === null || bait.offsetHeight === 0 || bait.offsetLeft === 0) {
            isBlocked = true;
          }

          // Test 2: Network fetch check to Monetag ad server
          fetch('https://3nbf4.com/act/files/tag.min.js?z=11473498', { method: 'HEAD', mode: 'no-cors' })
            .then(function() {
              if (isBlocked) triggerAdBlockModal();
            })
            .catch(function() {
              isBlocked = true;
              triggerAdBlockModal();
            });

          document.body.removeChild(bait);
        }

        function triggerAdBlockModal() {
          var modal = document.getElementById('eg-adblock-modal');
          if (modal) {
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          }
        }

        window.addEventListener('load', function() {
          setTimeout(checkAdBlock, 800);
        });
      })();
    </script>

    <script is:inline src="/assets/site-manifest.js"></script>
    <script is:inline src="/assets/site-chrome.js"></script>
</body>
</html>
