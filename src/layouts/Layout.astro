---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title, description, enableAds = false, darkTheme = false } = Astro.props;

const pageTitle = title || "Editors Gurukul | Free Filmmaking Guides, LUTs & Gear";
const pageDesc = description || "Editors Gurukul offers free filmmaking guides, LUT resources, camera cheat sheets, and premium courses for creators and editors.";
const canonicalURL = new URL(Astro.url.pathname, "https://editorsgurukul.com").toString();

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
const schemaType = isHome ? "WebSite" : "TechArticle";

const schemaData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": schemaType,
  "name": pageTitle,
  "headline": pageTitle,
  "description": pageDesc,
  "url": canonicalURL,
  "mainEntityOfPage": canonicalURL,
  "inLanguage": "en",
  "datePublished": "2026-01-15T08:00:00+05:30",
  "dateModified": "2026-08-01T22:00:00+05:30",
  "proficiencyLevel": "Beginner to Professional",
  "image": "https://editorsgurukul.com/assets/og-default.jpg",
  "author": {
    "@type": "Person",
    "name": "Ajay K Meena",
    "jobTitle": "Cinematographer & Colorist",
    "sameAs": [
      "https://youtube.com/@ajaykmeenaa",
      "https://instagram.com/iamajmeena",
      "https://ajaykmeena.com"
    ]
  },
  "publisher": {
    "@type": "Organization",
    "name": "Editors Gurukul",
    "url": "https://editorsgurukul.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://editorsgurukul.com/assets/og-default.jpg"
    }
  }
});

---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="monetag" content="fe9be61e87a67ccaa8693a77ed8bdc8c">
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc}>
    <meta name="robots" content="index, follow">
    <link rel="canonical" href={canonicalURL}>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/assets/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Sora:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    
    <!-- Open Graph & Twitter Meta -->
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={pageDesc}>
    <meta property="og:image" content="https://editorsgurukul.com/assets/og-default.jpg">
    <meta property="og:url" content={canonicalURL}>
    <meta name="twitter:card" content="summary_large_image">

    <!-- Schema.org JSON-LD Structured Data for Google SEO & AdSense -->
    <script type="application/ld+json" set:html={schemaData} />

    <!-- Google Analytics (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-E9YPJM7G00"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E9YPJM7G00');
    </script>

    {enableAds && (
      <>
        <!-- Monetag MultiTag Ad Tags (Zone 11473498 & Zone 265803) - 100% Unconditional Direct Loading -->
        <script is:inline data-cfasync="false" src="https://3nbf4.com/act/files/tag.min.js?z=11473498" async></script>
        <script is:inline src="https://quge5.com/88/tag.min.js" data-zone="265803" async data-cfasync="false"></script>

        <!-- Anti-AdBlock Bait Scripts -->
        <script is:inline src="/assets/ads.js"></script>
        <script is:inline src="/assets/adframe.js"></script>
      </>
    )}
</head>
<body class={darkTheme ? "bg-[#0d0714] text-white font-['Sora',sans-serif]" : "bg-[#faf9f6] text-[#15181c] font-['Sora',sans-serif]"}>
    <!-- Top Reading Progress Bar -->
    <div id="eg-reading-progress" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-[#0a5f61] via-[#0f8b8d] to-[#e0692a] z-[10000] w-0 transition-all duration-75"></div>
    <script is:inline>
      (function() {
        var progress = document.getElementById('eg-reading-progress');
        if (progress) {
          window.addEventListener('scroll', function() {
            var totalHeight = document.documentElement.scrollHeight - window.innerHeight;
            if (totalHeight > 0) {
              var pct = (window.scrollY / totalHeight) * 100;
              progress.style.width = Math.min(100, Math.max(0, pct)) + '%';
            }
          });
        }
      })();
    </script>

    <Header darkTheme={darkTheme} />

    <main class="min-h-screen">
        <slot />
    </main>
    <Footer darkTheme={darkTheme} />

    <!-- Floating Hindi Toggle -->
    <button id="eg-lang-toggle-btn" class="eg-lang-toggle notranslate" type="button" onclick="window.egToggleHindi ? window.egToggleHindi() : null">
        हिंदी में पढ़ें
    </button>

    {enableAds && (
      <>
        <!-- Hardened Anti-AdBlocker Detection Fullscreen Modal & Script -->
        <div id="eg-adblock-modal" class="hidden fixed inset-0 z-[9999999] bg-black/95 backdrop-blur-2xl flex items-center justify-center p-4">
          <div class="bg-white border-4 border-[#e0692a] p-8 rounded-3xl max-w-md w-full text-center shadow-2xl animate-fade-in">
            <div class="w-20 h-20 bg-[#fdece0] text-[#e0692a] rounded-full flex items-center justify-center mx-auto mb-4 text-4xl font-extrabold shadow-inner">
              🛡️
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[#15181c] mb-3">
              AdBlocker Detected!
            </h2>
            <p class="text-sm text-[#4b5058] leading-relaxed mb-6">
              Please <strong>disable your Mobile / PC AdBlocker</strong> (Brave Shield, AdGuard iOS, uBlock, AdBlock Plus) for <u>editorsgurukul.com</u> to access content and free downloads.
            </p>
            <button onclick="window.location.reload()" class="w-full py-4 bg-[#0a5f61] text-white font-extrabold text-base rounded-full hover:bg-[#074749] transition-all shadow-lg cursor-pointer transform active:scale-95">
              ↻ I Have Disabled AdBlocker (Refresh Page)
            </button>
            <p class="text-xs text-[#9ca3af] mt-4 mb-0">
              Thank you for supporting free guides on Editors Gurukul!
            </p>
          </div>
        </div>

        <script is:inline>
          (function() {
            function triggerAdBlockModal() {
              var modal = document.getElementById('eg-adblock-modal');
              if (modal) {
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
                document.body.style.pointerEvents = 'none';
                modal.style.pointerEvents = 'auto';
              }
            }

            function runHardenedAdBlockCheck() {
              var isBlocked = false;

              // Check 1: Bait Files (ads.js & adframe.js)
              if (window.hasNoAdBlock !== true || window.canRunAds !== true) {
                isBlocked = true;
              }

              // Check 2: DOM Bait Element
              var bait = document.createElement('div');
              bait.className = 'adsbygoogle ad-zone ad-space page-ad sponsor-ad pub_300x250';
              bait.style.cssText = 'position:absolute!important;left:-9999px!important;top:-9999px!important;height:100px!important;width:100px!important;';
              document.body.appendChild(bait);

              var style = window.getComputedStyle ? window.getComputedStyle(bait, null) : null;
              if (bait.offsetParent === null || bait.offsetHeight === 0 || (style && (style.getPropertyValue('display') === 'none' || style.getPropertyValue('visibility') === 'hidden'))) {
                isBlocked = true;
              }
              if (document.body.contains(bait)) {
                document.body.removeChild(bait);
              }

              if (isBlocked) {
                triggerAdBlockModal();
                return;
              }

              // Check 3: Hardened Mobile Network Request Probe (Catches iOS Brave Shield, AdGuard iOS & Android AdBlockers)
              try {
                var probe = new Image();
                probe.onerror = function() {
                  triggerAdBlockModal();
                };
                probe.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?cb=' + Date.now();
              } catch (e) {
                triggerAdBlockModal();
              }
            }

            // Fast execution loop for Mobile & Desktop
            if (document.readyState === 'complete' || document.readyState === 'interactive') {
              runHardenedAdBlockCheck();
            } else {
              document.addEventListener('DOMContentLoaded', runHardenedAdBlockCheck);
              window.addEventListener('load', runHardenedAdBlockCheck);
            }

            // Real-time interval check every 1.5 seconds
            setInterval(runHardenedAdBlockCheck, 1500);
          })();
        </script>
      </>
    )}

    <script is:inline src="/assets/site-manifest.js"></script>
    <script is:inline src="/assets/site-chrome.js"></script>
</body>
</html>
