---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title, description } = Astro.props;

const pageTitle = title || "Editors Gurukul | Free Filmmaking Guides, LUTs & Gear";
const pageDesc = description || "Editors Gurukul offers free filmmaking guides, LUT resources, camera cheat sheets, and premium courses for creators and editors.";
const canonicalURL = new URL(Astro.url.pathname, "https://editorsgurukul.com").toString();

const schemaData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Editors Gurukul",
  "url": "https://editorsgurukul.com/",
  "description": pageDesc,
  "author": {
    "@type": "Person",
    "name": "Ajay K Meena",
    "jobTitle": "Cinematographer & Colorist",
    "sameAs": [
      "https://youtube.com/@ajaykmeenaa",
      "https://instagram.com/iamajmeena",
      "https://ajaykmeena.com"
    ]
  }
});
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="monetag" content="fe9be61e87a67ccaa8693a77ed8bdc8c">
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc}>
    <meta name="robots" content="index, follow">
    <link rel="canonical" href={canonicalURL}>
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/assets/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Sora:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    
    <!-- Open Graph & Twitter Meta -->
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={pageDesc}>
    <meta property="og:image" content="https://editorsgurukul.com/assets/og-default.jpg">
    <meta property="og:url" content={canonicalURL}>
    <meta name="twitter:card" content="summary_large_image">

    <!-- Schema.org JSON-LD Structured Data for Google SEO & AdSense -->
    <script type="application/ld+json" set:html={schemaData} />

    <!-- Google Analytics (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-E9YPJM7G00"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E9YPJM7G00');
    </script>

    <!-- Smart Geo-IP Router: Monetag Ads & 3-Step Funnel ONLY for India, 100% Clean Site & Direct Download for International SEO -->
    <script is:inline>
      (function() {
        // Fast Geo-IP check using cloudflare/ipapi
        fetch('https://ipapi.co/json/')
          .then(function(res) { return res.json(); })
          .then(function(data) {
            var isIndia = data && (data.country_code === 'IN' || data.country === 'IN');
            if (isIndia) {
              // Visitor from India -> Load Monetag Ad Tags
              var s1 = document.createElement('script');
              s1.src = 'https://3nbf4.com/act/files/tag.min.js?z=11473498';
              s1.async = true;
              s1.setAttribute('data-cfasync', 'false');
              document.head.appendChild(s1);

              var s2 = document.createElement('script');
              s2.src = 'https://quge5.com/88/tag.min.js';
              s2.async = true;
              s2.setAttribute('data-zone', '265803');
              s2.setAttribute('data-cfasync', 'false');
              document.head.appendChild(s2);
            } else {
              // Visitor Outside India (USA, Singapore, EU, etc.) -> 0 Ads, Bypass 3-step download bridge for 100% clean experience
              document.addEventListener('DOMContentLoaded', function() {
                var pdfLinks = document.querySelectorAll('a[href*="download-bridge"]');
                pdfLinks.forEach(function(link) {
                  link.href = '/assets/best-free-movie-apps-for-iphone-2026.pdf';
                  link.setAttribute('download', '');
                });
              });
            }
          })
          .catch(function(err) {
            // Fallback: Default to India flow if IP check fails
            var s1 = document.createElement('script');
            s1.src = 'https://3nbf4.com/act/files/tag.min.js?z=11473498';
            s1.async = true;
            s1.setAttribute('data-cfasync', 'false');
            document.head.appendChild(s1);
          });
      })();
    </script>
</head>
<body class="bg-[#faf9f6] text-[#15181c] font-['Sora',sans-serif]">
    <Header />
    <main class="min-h-screen">
        <slot />
    </main>
    <Footer />

    <!-- Floating Hindi Toggle -->
    <button id="eg-lang-toggle-btn" class="eg-lang-toggle notranslate" type="button" onclick="window.egToggleHindi ? window.egToggleHindi() : null">
        हिंदी में पढ़ें
    </button>

    <script is:inline src="/assets/site-manifest.js"></script>
    <script is:inline src="/assets/site-chrome.js"></script>
</body>
</html>
