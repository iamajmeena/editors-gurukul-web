---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title, description, enableAds = false, darkTheme = false } = Astro.props;

const pageTitle = title || "Editors Gurukul | Free Filmmaking Guides, LUTs & Gear";
const pageDesc = description || "Editors Gurukul offers free filmmaking guides, LUT resources, camera cheat sheets, and premium courses for creators and editors.";
const canonicalURL = new URL(Astro.url.pathname, "https://editorsgurukul.com").toString();

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
const schemaType = isHome ? "WebSite" : "TechArticle";

const schemaData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": schemaType,
  "name": pageTitle,
  "headline": pageTitle,
  "description": pageDesc,
  "url": canonicalURL,
  "mainEntityOfPage": canonicalURL,
  "inLanguage": "en",
  "datePublished": "2026-01-15T08:00:00+05:30",
  "dateModified": "2026-08-01T22:00:00+05:30",
  "proficiencyLevel": "Beginner to Professional",
  "image": "https://editorsgurukul.com/assets/og-default.jpg",
  "author": {
    "@type": "Person",
    "name": "Ajay K Meena",
    "jobTitle": "Cinematographer & Colorist",
    "sameAs": [
      "https://youtube.com/@ajaykmeenaa",
      "https://instagram.com/iamajmeena",
      "https://ajaykmeena.com"
    ]
  },
  "publisher": {
    "@type": "Organization",
    "name": "Editors Gurukul",
    "url": "https://editorsgurukul.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://editorsgurukul.com/assets/og-default.jpg"
    }
  }
});

---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc}>
    <meta name="robots" content="index, follow">
    <link rel="canonical" href={canonicalURL}>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/assets/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Sora:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    
    <!-- Open Graph & Twitter Meta -->
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={pageDesc}>
    <meta property="og:image" content="https://editorsgurukul.com/assets/og-default.jpg">
    <meta property="og:url" content={canonicalURL}>
    <meta name="twitter:card" content="summary_large_image">

    <!-- Schema.org JSON-LD Structured Data for Google SEO & AdSense -->
    <script type="application/ld+json" set:html={schemaData} />

    <!-- Google Analytics (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-E9YPJM7G00"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E9YPJM7G00');
    </script>


</head>
<body class={darkTheme ? "dark-portal bg-[#0d0714] text-white font-['Sora',sans-serif]" : "bg-[#faf9f6] text-[#15181c] font-['Sora',sans-serif]"}>
    <!-- Top Reading Progress Bar -->
    <div id="eg-reading-progress" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-[#0a5f61] via-[#0f8b8d] to-[#e0692a] z-[10000] w-0 transition-all duration-75"></div>
    <script is:inline>
      (function() {
        var progress = document.getElementById('eg-reading-progress');
        if (progress) {
          window.addEventListener('scroll', function() {
            var totalHeight = document.documentElement.scrollHeight - window.innerHeight;
            if (totalHeight > 0) {
              var pct = (window.scrollY / totalHeight) * 100;
              progress.style.width = Math.min(100, Math.max(0, pct)) + '%';
            }
          });
        }
      })();
    </script>

    <Header darkTheme={darkTheme} />

    <main class="min-h-screen">
        <slot />
    </main>
    <Footer darkTheme={darkTheme} />

    <!-- Floating Hindi Toggle -->
    <button id="eg-lang-toggle-btn" class="eg-lang-toggle notranslate" type="button" onclick="window.egToggleHindi ? window.egToggleHindi() : null">
        हिंदी में पढ़ें
    </button>

    <script is:inline src="/assets/site-manifest.js"></script>
    <script is:inline src="/assets/site-chrome.js"></script>
</body>
</html>
