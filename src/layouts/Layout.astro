---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title || "Editors Gurukul"}</title>
    <meta name="description" content={description || "Editors Gurukul offers free filmmaking guides, LUT resources, camera cheat sheets, and premium courses."}>
    <link rel="icon" href="/assets/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Google Analytics (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-E9YPJM7G00"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E9YPJM7G00');
    </script>
</head>
<body class="bg-[#faf9f6] text-[#15181c] font-['Sora',sans-serif]">
    <Header />
    <main class="min-h-screen">
        <slot />
    </main>
    <Footer />

    <!-- Floating Hindi Toggle -->
    <button id="eg-lang-toggle-btn" class="eg-lang-toggle notranslate" type="button" onclick="window.egToggleHindi ? window.egToggleHindi() : null">
        हिंदी में पढ़ें
    </button>

    <script is:inline src="/assets/site-manifest.js"></script>
    <script is:inline src="/assets/site-chrome.js"></script>
</body>
</html>
