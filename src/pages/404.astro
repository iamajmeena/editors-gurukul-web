---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found | Editors Gurukul" description="The page you're looking for doesn't exist or may have moved.">
  <section class="max-w-2xl mx-auto px-6 py-24 text-center">
    <p class="text-[#e0692a] font-extrabold text-sm tracking-widest mb-4">404 ERROR</p>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-[#15181c] mb-6">Page Not Found</h1>
    <p class="text-[#4b5058] text-lg mb-10">
      The guide or page you're looking for doesn't exist or may have been moved.
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a href="/" class="px-6 py-3 bg-[#0a5f61] text-white font-bold rounded-full hover:bg-[#074749] transition-all">
        ← Back to Home
      </a>
      <a href="/guides" class="px-6 py-3 border-2 border-[#0a5f61] text-[#0a5f61] font-bold rounded-full hover:bg-[#0a5f61] hover:text-white transition-all">
        Browse All Guides
      </a>
    </div>
  </section>
</Layout>
