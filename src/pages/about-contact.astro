---
import Layout from '../layouts/Layout.astro';

export const title = "About / Contact | Editors Gurukul";
export const category = "editing-fundamentals";
---
<Layout title="About / Contact | Editors Gurukul" description="Get in touch with Ajay K Meena — cinematographer, colorist, and founder of Editors Gurukul. Collaboration and business inquiries welcome.">


  <div class="container" style="max-width:800px;margin:40px auto;padding:0 20px;">
    <div class="card" style="background:#fff;padding:32px;border-radius:16px;border:1px solid #e7e4dc;box-shadow:0 4px 20px rgba(0,0,0,0.05);">
      <h1 style="font-size:2rem;font-weight:800;color:#15181c;margin-bottom:16px;">About Editors Gurukul</h1>
      <p style="font-size:1.05rem;line-height:1.7;color:#4b5058;margin-bottom:20px;">
        <strong>Editors Gurukul</strong> is India's leading educational resource hub and knowledge platform dedicated to video editors, cinematographers, colorists, and solo filmmakers. Our mission is to democratize high-end post-production workflows and cinematic camera storytelling through free, accessible, practical tutorials and guides.
      </p>
      
      <h2 style="font-size:1.4rem;font-weight:700;color:#0a5f61;margin-top:32px;margin-bottom:12px;">Meet the Founder &amp; Instructor</h2>
      <p style="font-size:1rem;line-height:1.7;color:#4b5058;margin-bottom:20px;">
        Founded by <strong>Ajay K. Meena</strong> — an experienced Director of Photography (DOP), DaVinci Resolve colorist, and creator of the acclaimed <em>Decoding DaVinci 2.0</em> course. With years of real-world shooting and post-production experience across music videos, corporate commercials, and cinematic storytelling, Ajay shares proven onset workflows, camera settings, color management pipelines, and industry best practices without fluff.
      </p>

      <div style="background:#faf9f6;border-left:4px solid #0a5f61;padding:20px;border-radius:8px;margin:28px 0;">
        <h3 style="font-size:1.15rem;font-weight:700;color:#15181c;margin-top:0;margin-bottom:10px;">Our E-E-A-T Guarantee</h3>
        <p style="font-size:0.95rem;line-height:1.6;color:#4b5058;margin:0;">
          All tutorials, comparisons, and technical guides published on Editors Gurukul are rigorously tested on production-grade editing rigs and real camera hardware. We prioritize technical precision (LUFS standards, ACES color management, sensor dynamic range analysis) over automated or generic AI content.
        </p>
      </div>

      <h2 style="font-size:1.4rem;font-weight:700;color:#0a5f61;margin-top:32px;margin-bottom:12px;">Get in Touch</h2>
      <p style="font-size:1rem;line-height:1.7;color:#4b5058;margin-bottom:16px;">
        Whether you have technical questions about a DaVinci Resolve node tree, want to report a broken link, or are interested in professional business collaborations and sponsorships, we would love to hear from you:
      </p>
      <ul style="line-height:2;font-size:1rem;color:#15181c;">
        <li>📧 <strong>Email Support:</strong> <a href="mailto:contact@ajaykmeena.com" style="color:#0a5f61;font-weight:600;">contact@ajaykmeena.com</a></li>
        <li>▶️ <strong>YouTube Channel:</strong> <a href="https://youtube.com/@ajaykmeenaa" target="_blank" rel="noopener noreferrer" style="color:#e0692a;font-weight:600;">@ajaykmeenaa</a></li>
        <li>📸 <strong>Instagram Handle:</strong> <a href="https://instagram.com/iamajmeena" target="_blank" rel="noopener noreferrer" style="color:#e1306c;font-weight:600;">@iamajmeena</a></li>
      </ul>
    </div>
  </div>
  



</Layout>
