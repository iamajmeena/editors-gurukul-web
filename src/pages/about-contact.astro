---
import Layout from '../layouts/Layout.astro';

export const title = "About / Contact | Editors Gurukul";
export const category = "editing-fundamentals";
---
<Layout title="About / Contact | Editors Gurukul" description="Get in touch with Ajay K Meena — cinematographer, colorist, and founder of Editors Gurukul. Collaboration and business inquiries welcome.">


  <div class="container">
    <div class="card">
      <h1>About / Contact</h1>
      <p>Editors Gurukul is a creator-focused resource hub for filmmakers, editors, and content creators who want practical tutorials, cinematic guides, LUT resources, and workflow tips.</p>
      <p>If you want to connect for collaborations, feedback, or business inquiries, please reach out through the contact details listed on the main website or social channels.</p>
      <p>We welcome questions from creators who want to improve their editing and color grading workflow.</p>
    </div>
  </div>
  



</Layout>
