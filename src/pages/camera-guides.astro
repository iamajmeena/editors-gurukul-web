---
import Layout from '../layouts/Layout.astro';

const allPages = Object.values(import.meta.glob('./*.astro', { eager: true })) as any[];
const excludeList = ['index.astro', 'about-contact.astro', 'privacy-policy.astro', 'terms.astro', 'guides.astro', 'free-resources.astro', 'my-gear.astro', 'camera-guides.astro', 'lens-guides.astro', 'lighting-guides.astro', 'filmmaking-guides.astro', 'storytelling-guides.astro', 'career-guides.astro', 'decoding-davinci-20-course.astro'];

const cameraGuides = allPages.filter(page => {
  const filename = page.file.split('/').pop() || '';
  const cat = page.category || '';
  return !excludeList.includes(filename) && (cat === 'camera' || cat === 'editing-fundamentals');
}).map(page => {
  const filename = page.file.split('/').pop() || '';
  const path = '/' + filename.replace('.astro', '');
  return {
    path,
    title: page.title || filename.replace(/-/g, ' ').replace('.astro', ''),
    desc: page.description || ''
  };
});
---

<Layout title="Camera Guides | Editors Gurukul" description="Practical camera education for beginners and creators — codec, log, HDR, budget camera picks, and hands-on technique guides, all in one place.">

  <div class="container">
    <div class="card">
      <h1>Camera Guides</h1>
      <p>Practical camera education for beginners and creators who want better visuals without overcomplicating the process.</p>
      <div class="grid" id="eg-camera-grid">
        {cameraGuides.map(g => (
          <div class="item">
            <h3>{g.title}</h3>
            <p>{g.desc}</p>
            <a class="btn" href={g.path}>Open Guide</a>
          </div>
        ))}
      </div>
      <p style="margin-top:20px;"><a href="/my-gear">See My Gear →</a> · <a href="/free-resources">All Free Resources →</a> · <a href="/guides">All Guides →</a></p>
    </div>
  </div>

</Layout>
