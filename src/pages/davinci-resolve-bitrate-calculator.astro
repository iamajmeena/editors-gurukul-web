---
import Layout from '../layouts/Layout.astro';
import FAQBlock from '../components/FAQBlock.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

export const title = "DaVinci Resolve File Size & Bitrate Calculator (2026)";
export const category = "davinci-resolve";
export const description = "Free DaVinci Resolve render file size & bitrate calculator — estimate 1080p, 4K & 8K export file sizes for H.264, H.265, ProRes 422 HQ, and DNxHR.";
---
<Layout title={title} description={description}>

  <header class="text-center max-w-4xl mx-auto px-4 pt-8 pb-4">
    <span class="hero-pill shadow-sm">🧮 INTERACTIVE FILMMAKER TOOL</span>
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4">DaVinci Resolve File Size &amp; Bitrate Calculator</h1>
    <p class="hero-subtitle text-lg text-[#4b5058] max-w-2xl mx-auto mb-6">
      Calculate exact export file sizes (GB/TB) and target bitrates for H.264, H.265, ProRes 422, and DNxHR before rendering in DaVinci Resolve.
    </p>
  </header>

  <main class="max-w-4xl mx-auto px-6 pb-16">

    <!-- Interactive Calculator Card -->
    <div class="bg-white border-2 border-[#0a5f61]/20 rounded-3xl p-6 sm:p-10 shadow-2xl mb-12">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        
        <!-- Resolution Dropdown -->
        <div>
          <label for="calc-res" class="block text-sm font-bold text-[#15181c] mb-2">1. Timeline Resolution</label>
          <select id="calc-res" class="w-full p-3.5 bg-[#f4f3ef] border border-[#e7e4dc] rounded-xl font-bold text-[#15181c] focus:outline-none focus:border-[#0a5f61]">
            <option value="1080">1080p Full HD (1920 x 1080)</option>
            <option value="4K" selected>4K UHD (3840 x 2160)</option>
            <option value="4KDCI">4K DCI (4096 x 2160)</option>
            <option value="8K">8K DCI (8192 x 4320)</option>
          </select>
        </div>

        <!-- Frame Rate Dropdown -->
        <div>
          <label for="calc-fps" class="block text-sm font-bold text-[#15181c] mb-2">2. Frame Rate (FPS)</label>
          <select id="calc-fps" class="w-full p-3.5 bg-[#f4f3ef] border border-[#e7e4dc] rounded-xl font-bold text-[#15181c] focus:outline-none focus:border-[#0a5f61]">
            <option value="24" selected>24 fps (Cinema Standard)</option>
            <option value="25">25 fps (PAL / Commercial)</option>
            <option value="30">30 fps (YouTube Standard)</option>
            <option value="60">60 fps (Smooth Motion / Sports)</option>
            <option value="120">120 fps (Slow Motion)</option>
          </select>
        </div>

        <!-- Codec / Quality Dropdown -->
        <div>
          <label for="calc-codec" class="block text-sm font-bold text-[#15181c] mb-2">3. Export Codec / Quality Preset</label>
          <select id="calc-codec" class="w-full p-3.5 bg-[#f4f3ef] border border-[#e7e4dc] rounded-xl font-bold text-[#15181c] focus:outline-none focus:border-[#0a5f61]">
            <option value="h264_low">H.264 (Low / Web Proxy ~15-25 Mbps)</option>
            <option value="h264_high" selected>H.264 (YouTube 4K High ~65-85 Mbps)</option>
            <option value="h265">H.265 / HEVC (High Efficiency ~45-60 Mbps)</option>
            <option value="prores_lt">Apple ProRes 422 LT (~220 Mbps)</option>
            <option value="prores_422">Apple ProRes 422 (~500 Mbps)</option>
            <option value="prores_hq">Apple ProRes 422 HQ Master (~750 Mbps)</option>
            <option value="prores_4444">Apple ProRes 4444 (+ Alpha ~1150 Mbps)</option>
          </select>
        </div>

        <!-- Duration Input -->
        <div>
          <label for="calc-minutes" class="block text-sm font-bold text-[#15181c] mb-2">4. Video Duration (Minutes)</label>
          <input type="number" id="calc-minutes" value="10" min="1" max="600" class="w-full p-3.5 bg-[#f4f3ef] border border-[#e7e4dc] rounded-xl font-bold text-[#15181c] focus:outline-none focus:border-[#0a5f61]" />
        </div>

      </div>

      <!-- Results Display Panel -->
      <div class="bg-gradient-to-br from-[#0a5f61] to-[#0f8b8d] text-white p-6 sm:p-8 rounded-2xl shadow-xl flex flex-col sm:flex-row justify-between items-center gap-6">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-white/80">Estimated Render Output Size</span>
          <div class="text-4xl sm:text-5xl font-extrabold tracking-tight mt-1" id="calc-result-size">4.88 GB</div>
          <p class="text-xs text-white/80 mt-2 mb-0" id="calc-result-bitrate">Target Bitrate: 65.0 Mbps (~8.1 MB/s)</p>
        </div>

        <div class="w-full sm:w-auto text-left sm:text-right border-t sm:border-t-0 sm:border-l border-white/20 pt-4 sm:pt-0 sm:pl-6">
          <div class="text-xs font-mono font-bold uppercase tracking-wider text-white/80">Req. Storage Speed</div>
          <div class="text-xl font-bold text-white mt-1" id="calc-result-speed">UHS-I SD or Fast SSD</div>
          <div class="text-xs text-white/70 mt-1" id="calc-result-time">Est. Export Time: ~1.5 - 3 mins</div>
        </div>
      </div>

    </div>

    <!-- Educational Context Section -->
    <article class="prose max-w-none">
      <h2>How Bitrate Impacts Your Render File Size in DaVinci Resolve</h2>
      <p>File size in video editing is governed by a simple mathematical formula: <strong>File Size = (Bitrate × Duration in Seconds) ÷ 8</strong>. The resolution (1080p vs 4K) does not directly dictate file size — the bit rate you allocate in DaVinci Resolve's Deliver page is what controls the exact gigabyte footprint on your hard drive.</p>
      
      <table>
        <thead>
          <tr><th>Codec</th><th>Best Used For</th><th>4K 24fps Bitrate Range</th></tr>
        </thead>
        <tbody>
          <tr><td><strong>H.264 (MP4 / MOV)</strong></td><td>YouTube uploads, client web previews, Instagram Reels</td><td>45 – 80 Mbps</td></tr>
          <tr><td><strong>H.265 (HEVC)</strong></td><td>4K HDR, drone clips, high-compression web master</td><td>30 – 55 Mbps</td></tr>
          <tr><td><strong>ProRes 422 HQ</strong></td><td>Broadcast masters, commercial archival, color grading passes</td><td>500 – 750 Mbps</td></tr>
          <tr><td><strong>ProRes 4444</strong></td><td>VFX plates with Alpha Transparency channel</td><td>1,000 – 1,400 Mbps</td></tr>
        </tbody>
      </table>
    </article>

    <FAQBlock items={[
      {q: "Why is my exported 4K file much bigger than expected?", a: "If you leave Bitrate set to 'Automatic (Best)' in DaVinci Resolve, the render engine allocates maximum bitrate (up to 100+ Mbps for 4K). Switch Bitrate mode to 'Restrict to' and enter a specific target like 65,000 Kbps for YouTube."},
      {q: "Is ProRes 422 HQ better than H.264 for YouTube?", a: "YouTube converts all uploaded videos to its own VP09 or AV1 codecs. Uploading a ProRes 422 HQ master ensures YouTube receives maximum dynamic range and zero pre-compression artifacts."}
    ]} />

    <RelatedArticles category="davinci-resolve" />

  </main>

  <script is:inline>
    (function() {
      var resEl = document.getElementById('calc-res');
      var fpsEl = document.getElementById('calc-fps');
      var codecEl = document.getElementById('calc-codec');
      var minEl = document.getElementById('calc-minutes');

      var resultSize = document.getElementById('calc-result-size');
      var resultBitrate = document.getElementById('calc-result-bitrate');
      var resultSpeed = document.getElementById('calc-result-speed');
      var resultTime = document.getElementById('calc-result-time');

      function calculate() {
        if (!resEl || !fpsEl || !codecEl || !minEl) return;

        var fps = parseFloat(fpsEl.value);
        var minutes = parseFloat(minEl.value) || 1;
        var seconds = minutes * 60;
        var codec = codecEl.value;
        var res = resEl.value;

        // Base bitrate in Mbps at 24fps 4K
        var baseMbps = 65;
        if (codec === 'h264_low') baseMbps = 20;
        if (codec === 'h264_high') baseMbps = 65;
        if (codec === 'h265') baseMbps = 45;
        if (codec === 'prores_lt') baseMbps = 220;
        if (codec === 'prores_422') baseMbps = 500;
        if (codec === 'prores_hq') baseMbps = 750;
        if (codec === 'prores_4444') baseMbps = 1150;

        // FPS Multiplier
        var fpsMult = fps / 24;

        // Res Multiplier
        var resMult = 1.0;
        if (res === '1080') resMult = 0.35;
        if (res === '4KDCI') resMult = 1.05;
        if (res === '8K') resMult = 3.5;

        var finalMbps = baseMbps * fpsMult * resMult;
        var totalMB = (finalMbps * seconds) / 8;
        var totalGB = totalMB / 1024;

        if (totalGB >= 1024) {
          resultSize.textContent = (totalGB / 1024).toFixed(2) + ' TB';
        } else if (totalGB >= 1) {
          resultSize.textContent = totalGB.toFixed(2) + ' GB';
        } else {
          resultSize.textContent = totalMB.toFixed(0) + ' MB';
        }

        resultBitrate.textContent = 'Target Bitrate: ' + finalMbps.toFixed(1) + ' Mbps (~' + (finalMbps / 8).toFixed(1) + ' MB/s)';

        if (finalMbps > 500) {
          resultSpeed.textContent = 'NVMe SSD / RAID Storage';
        } else if (finalMbps > 150) {
          resultSpeed.textContent = 'SATA SSD / V60 SD Card';
        } else {
          resultSpeed.textContent = 'Standard SD Card / HDD';
        }

        var estRenderMin = (minutes * (finalMbps / 120)).toFixed(1);
        resultTime.textContent = 'Est. Render Time: ~' + (estRenderMin < 0.5 ? '< 1 min' : estRenderMin + ' mins');
      }

      [resEl, fpsEl, codecEl, minEl].forEach(function(el) {
        if (el) el.addEventListener('change', calculate);
        if (el) el.addEventListener('input', calculate);
      });

      calculate();
    })();
  </script>

</Layout>
