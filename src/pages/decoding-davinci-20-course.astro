---
import Layout from '../layouts/Layout.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';

export const title = "Decoding DaVinci Resolve 20 Course | Ajay K. Meena";
export const category = "course";
---
<Layout title="Decoding DaVinci Resolve 20 — The Ultimate Course | Ajay K. Meena" description="Master DaVinci Resolve 20 with Ajay K. Meena — 18 modules, 115+ lessons covering video editing, professional color grading, Fusion compositing, Fairlight audio mixing & AI-powered filmmaking.">

<style>
  /* ── Hero ── */
  .course-hero {
    background: linear-gradient(135deg, #0a0f1e 0%, #0f2a2b 50%, #150f0a 100%);
    position: relative;
    overflow: hidden;
    padding: 80px 24px 64px;
    text-align: center;
  }
  .course-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 20% 50%, rgba(230,105,42,0.18) 0%, transparent 60%),
                radial-gradient(ellipse at 80% 30%, rgba(10,95,97,0.22) 0%, transparent 55%);
    pointer-events: none;
  }
  .hero-badge {
    display: inline-block;
    padding: 6px 18px;
    background: rgba(230,105,42,0.15);
    border: 1px solid rgba(230,105,42,0.5);
    color: #f4a76a;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border-radius: 999px;
    margin-bottom: 24px;
  }
  .hero-title {
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.1;
    margin: 0 auto 16px;
    max-width: 860px;
  }
  .hero-title span { color: #e0692a; }
  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: #9ec8c9;
    max-width: 680px;
    margin: 0 auto 12px;
    line-height: 1.6;
  }
  .hero-meta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    margin: 32px auto 40px;
  }
  .hero-meta-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #c4c4c4;
    font-size: 0.9rem;
  }
  .hero-meta-item .icon { font-size: 1.2rem; }
  .hero-cta {
    display: inline-block;
    padding: 18px 48px;
    background: linear-gradient(135deg, #e0692a, #c85720);
    color: #fff;
    font-size: 1.1rem;
    font-weight: 800;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 0 32px rgba(230,105,42,0.5);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    animation: pulseGlow 2.5s infinite;
  }
  .hero-cta:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 0 48px rgba(230,105,42,0.7);
    color: #fff;
    text-decoration: none;
  }
  @keyframes pulseGlow {
    0%, 100% { box-shadow: 0 0 24px rgba(230,105,42,0.4); }
    50%       { box-shadow: 0 0 48px rgba(230,105,42,0.75); }
  }

  /* ── Shared section wrapper ── */
  .course-section {
    max-width: 960px;
    margin: 0 auto;
    padding: 56px 24px;
  }
  .section-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #e0692a;
    margin-bottom: 10px;
  }
  .section-title {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 900;
    color: #15181c;
    margin-bottom: 12px;
    line-height: 1.15;
  }
  .section-desc {
    color: #4b5058;
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 700px;
    margin-bottom: 40px;
  }
  .divider {
    border: none;
    border-top: 1px solid #e7e4dc;
    margin: 0;
  }

  /* ── Pages grid ── */
  .pages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }
  .page-card {
    background: #faf9f6;
    border: 1px solid #e7e4dc;
    border-radius: 16px;
    padding: 28px 24px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .page-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.1);
  }
  .page-card .pc-icon {
    width: 44px; height: 44px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.3rem;
    margin-bottom: 14px;
  }
  .page-card h3 { font-size: 1rem; font-weight: 800; color: #15181c; margin-bottom: 8px; }
  .page-card p  { font-size: 0.88rem; color: #4b5058; line-height: 1.6; margin: 0; }
  .page-card ul { list-style: none; padding: 0; margin: 0; }
  .page-card ul li {
    font-size: 0.82rem;
    color: #4b5058;
    padding: 3px 0;
    padding-left: 16px;
    position: relative;
  }
  .page-card ul li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: #e0692a;
  }

  /* ── Modules accordion ── */
  .module-list { display: flex; flex-direction: column; gap: 12px; }
  details.module-item {
    background: #faf9f6;
    border: 1px solid #e7e4dc;
    border-radius: 12px;
    overflow: hidden;
  }
  details.module-item[open] { border-color: #e0692a; }
  details.module-item summary {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 22px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  details.module-item summary::-webkit-details-marker { display: none; }
  .mod-num {
    width: 32px; height: 32px;
    border-radius: 8px;
    background: #e0692a;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .mod-info { flex: 1; }
  .mod-title { font-size: 0.98rem; font-weight: 700; color: #15181c; }
  .mod-meta  { font-size: 0.78rem; color: #8a8a8a; margin-top: 2px; }
  .mod-chevron {
    font-size: 0.8rem;
    color: #e0692a;
    transition: transform 0.25s ease;
  }
  details.module-item[open] .mod-chevron { transform: rotate(90deg); }
  .mod-lessons {
    padding: 0 22px 18px 68px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .lesson-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.83rem;
    color: #4b5058;
    padding: 5px 0;
    border-bottom: 1px solid #f0ede7;
  }
  .lesson-item:last-child { border-bottom: none; }
  .lesson-item .l-icon { font-size: 0.75rem; color: #e0692a; flex-shrink: 0; }

  /* ── Skills pills ── */
  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .skill-pill {
    padding: 8px 18px;
    background: #faf9f6;
    border: 1.5px solid #e7e4dc;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #15181c;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }
  .skill-pill:hover {
    background: #fff3ea;
    border-color: #e0692a;
    color: #e0692a;
  }

  /* ── Value Adds ── */
  .value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }
  .value-card {
    background: #faf9f6;
    border: 1px solid #e7e4dc;
    border-radius: 16px;
    padding: 28px 22px;
    transition: transform 0.25s ease;
  }
  .value-card:hover { transform: translateY(-4px); }
  .value-card .vc-icon { font-size: 1.6rem; margin-bottom: 12px; }
  .value-card h3 { font-size: 1rem; font-weight: 800; color: #15181c; margin-bottom: 8px; }
  .value-card p  { font-size: 0.86rem; color: #4b5058; line-height: 1.65; margin: 0; }

  /* ── Mentor ── */
  .mentor-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  @media (max-width: 640px) { .mentor-wrap { grid-template-columns: 1fr; } }
  .mentor-img {
    border-radius: 20px;
    width: 100%;
    object-fit: cover;
    aspect-ratio: 4/3;
    box-shadow: 0 16px 48px rgba(0,0,0,0.15);
  }
  .mentor-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #e0692a;
    margin-bottom: 10px;
  }
  .mentor-name { font-size: 2rem; font-weight: 900; color: #15181c; margin-bottom: 4px; }
  .mentor-role { font-size: 0.9rem; color: #8a8a8a; margin-bottom: 20px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; }
  .mentor-bio  { font-size: 0.95rem; color: #4b5058; line-height: 1.75; }
  .mentor-stats {
    display: flex;
    gap: 28px;
    margin-top: 28px;
    flex-wrap: wrap;
  }
  .stat-item .stat-val { font-size: 1.6rem; font-weight: 900; color: #e0692a; }
  .stat-item .stat-lbl { font-size: 0.78rem; color: #8a8a8a; font-weight: 600; }

  /* ── CTA bottom ── */
  .cta-bottom {
    background: linear-gradient(135deg, #0a5f61, #0f8b8d);
    border-radius: 24px;
    padding: 64px 32px;
    text-align: center;
    margin: 0 24px 56px;
    max-width: 960px;
    margin-left: auto;
    margin-right: auto;
  }
  .cta-bottom h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 900; color: #fff; margin-bottom: 12px; }
  .cta-bottom p  { color: rgba(255,255,255,0.8); font-size: 1.05rem; margin-bottom: 32px; }
  .cta-bottom a {
    display: inline-block;
    padding: 18px 48px;
    background: #fff;
    color: #0a5f61;
    font-weight: 800;
    font-size: 1.05rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.25s ease, background 0.25s ease;
  }
  .cta-bottom a:hover { transform: scale(1.05); background: #e4f3f2; text-decoration: none; }
</style>

<!-- ════════════════════════════════════════════
     HERO
════════════════════════════════════════════ -->
<section class="course-hero">
  <div class="hero-badge">⭐ Flagship Course — DaVinci Resolve 20</div>
  <h1 class="hero-title">Decoding <span>DaVinci Resolve 20</span></h1>
  <p class="hero-subtitle">The Ultimate Course for Video Editing, Color Grading &amp; AI-Powered Filmmaking</p>
  <div class="hero-meta">
    <span class="hero-meta-item"><span class="icon">📦</span> 18 Modules</span>
    <span class="hero-meta-item"><span class="icon">🎬</span> 115+ Lessons</span>
    <span class="hero-meta-item"><span class="icon">♾️</span> Lifetime Access</span>
    <span class="hero-meta-item"><span class="icon">📜</span> Certificate of Completion</span>
    <span class="hero-meta-item"><span class="icon">🇮🇳</span> Hindi + English</span>
  </div>
  <a href="https://www.ajaykmeena.com/courses/Decoding-DaVinci-Resolve-20--The-Ultimate-course-for-Video-Editing-Color-Grading--AI-Powered-Filmmaking-69b89bb32c97f8fb76db7ee8"
     target="_blank" rel="noopener noreferrer"
     class="hero-cta">Enroll Now on Graphy ↗</a>
</section>

<hr class="divider" />

<!-- ════════════════════════════════════════════
     ALL 6 PAGES COVERED
════════════════════════════════════════════ -->
<section class="course-section">
  <p class="section-label">Complete Coverage</p>
  <h2 class="section-title">Every Page of DaVinci Resolve — Covered</h2>
  <p class="section-desc">From import to export — this complete masterclass examines all six foundational workspaces within DaVinci Resolve in uncompromising professional depth.</p>

  <div class="pages-grid">
    <!-- Media Page -->
    <div class="page-card">
      <div class="pc-icon" style="background:#e8f4f5;">🗂️</div>
      <h3>Media Page</h3>
      <p>Organized starting point for every project.</p>
      <ul style="margin-top:10px;">
        <li>Importing media &amp; structuring production bins</li>
        <li>Proxy workflow setup</li>
        <li>Metadata tagging &amp; flagging</li>
        <li>Smart bins &amp; power bins</li>
      </ul>
    </div>
    <!-- Cut Page -->
    <div class="page-card">
      <div class="pc-icon" style="background:#fef3ea;">✂️</div>
      <h3>Cut Page</h3>
      <p>Lightning-fast cutting for rapid assembly edits.</p>
      <ul style="margin-top:10px;">
        <li>Source tape &amp; sync bin workflows</li>
        <li>Razor &amp; dynamic trim tools</li>
        <li>J-Cuts, L-Cuts &amp; split edits</li>
        <li>Quick export &amp; review</li>
      </ul>
    </div>
    <!-- Edit Page -->
    <div class="page-card">
      <div class="pc-icon" style="background:#f0eef9;">🎞️</div>
      <h3>Edit Page</h3>
      <p>Full-featured NLE for advanced timeline editing.</p>
      <ul style="margin-top:10px;">
        <li>Multi-cam editing &amp; angle switching</li>
        <li>Speed ramp &amp; Speed Warp AI</li>
        <li>Titles, transitions &amp; open FX</li>
        <li>Compound clips &amp; nesting</li>
      </ul>
    </div>
    <!-- Fusion Page -->
    <div class="page-card">
      <div class="pc-icon" style="background:#eaf5ea;">🔮</div>
      <h3>Fusion Page</h3>
      <p>Node-based VFX &amp; motion graphics compositing.</p>
      <ul style="margin-top:10px;">
        <li>Delta Keyer / Green screen keying</li>
        <li>Node tree workflow fundamentals</li>
        <li>Text+ animations &amp; macros</li>
        <li>Particle systems &amp; masks</li>
      </ul>
    </div>
    <!-- Color Page -->
    <div class="page-card">
      <div class="pc-icon" style="background:#fff3ea;">🎨</div>
      <h3>Color Page</h3>
      <p>Industry-standard professional color grading tools.</p>
      <ul style="margin-top:10px;">
        <li>Color science foundation &amp; scopes</li>
        <li>Serial, parallel &amp; layer nodes</li>
        <li>Power windows &amp; tracking</li>
        <li>Shot matching &amp; HDR grading</li>
      </ul>
    </div>
    <!-- Fairlight Page -->
    <div class="page-card">
      <div class="pc-icon" style="background:#fce8f0;">🎚️</div>
      <h3>Fairlight Page</h3>
      <p>Professional audio post-production &amp; mixing.</p>
      <ul style="margin-top:10px;">
        <li>Audio editing &amp; clip gain</li>
        <li>EQ, compression &amp; FX plugins</li>
        <li>LUFS loudness standards</li>
        <li>Dialogue cleanup &amp; ADR</li>
      </ul>
    </div>
  </div>
</section>

<hr class="divider" />

<!-- ════════════════════════════════════════════
     BEFORE / AFTER
════════════════════════════════════════════ -->
<section class="course-section" style="padding-top:40px; padding-bottom:40px;">
  <p class="section-label">Real Results</p>
  <h2 class="section-title">See the Transformation</h2>
  <p class="section-desc">Examine the cinematic visual transformation achieved using the exact node tree structures and grading methodologies taught inside this masterclass:</p>
  <BeforeAfterSlider
    beforeImage="/assets/assets/davinci-resolve-wb-portrait-before.webp"
    afterImage="/assets/assets/davinci-resolve-wb-portrait-after.webp"
    beforeLabel="Flat LOG"
    afterLabel="Graded Result"
  />
</section>

<hr class="divider" />

<!-- ════════════════════════════════════════════
     FULL COURSE CURRICULUM — 18 MODULES
════════════════════════════════════════════ -->
<section class="course-section">
  <p class="section-label">Full Curriculum</p>
  <h2 class="section-title">18 Modules · 115+ Lessons</h2>
  <p class="section-desc">Course modules are released through a scheduled rolling deployment—foundational training modules are ready immediately upon enrollment, with advanced masterclasses expanding your library continuously.</p>

  <div class="module-list">
    <details class="module-item" open>
      <summary>
        <span class="mod-num">01</span>
        <span class="mod-info">
          <div class="mod-title">DaVinci Resolve 20 — Installation &amp; Interface Orientation</div>
          <div class="mod-meta">6 Lessons · Foundation</div>
        </span>
        <span class="mod-chevron">▶</span>
      </summary>
      <div class="mod-lessons">
        <div class="lesson-item"><span class="l-icon">▶</span>Free vs Studio — determining which edition fits your production goals</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Installation &amp; GPU/VRAM requirements</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Project Manager — setting up libraries &amp; understanding database structures</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Interface layout &amp; keyboard shortcut philosophy</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Preferences — timeline frame rate, color science, auto-save</div>
        <div class="lesson-item"><span class="l-icon">▶</span>System optimisation for smooth playback</div>
      </div>
    </details>

    <details class="module-item">
      <summary>
        <span class="mod-num">02</span>
        <span class="mod-info">
          <div class="mod-title">Media Page — Mastering Import, Bins &amp; Proxy Workflows</div>
          <div class="mod-meta">7 Lessons · Organisation</div>
        </span>
        <span class="mod-chevron">▶</span>
      </summary>
      <div class="mod-lessons">
        <div class="lesson-item"><span class="l-icon">▶</span>Media storage locations &amp; linking missing clips</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Smart bins, power bins &amp; metadata tagging</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Proxy generation &amp; proxy workflow for slower machines</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Syncing audio &amp; video using waveform / timecode</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Transcoding vs optimised media</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Scene detect &amp; automatic clip splitting</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Flagging, starring &amp; rating clips efficiently</div>
      </div>
    </details>

    <details class="module-item">
      <summary>
        <span class="mod-num">03</span>
        <span class="mod-info">
          <div class="mod-title">Cut Page Mastery — Fast Assembly Editing</div>
          <div class="mod-meta">8 Lessons · Editing</div>
        </span>
        <span class="mod-chevron">▶</span>
      </summary>
      <div class="mod-lessons">
        <div class="lesson-item"><span class="l-icon">▶</span>Source tape &amp; sync bin approach</div>
        <div class="lesson-item"><span class="l-icon">▶</span>In/Out points &amp; insert vs overwrite edits</div>
        <div class="lesson-item"><span class="l-icon">▶</span>J-Cuts &amp; L-Cuts — split audio-video edits</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Razor tool vs blade mode</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Dynamic trim (Trim Edit Mode)</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Quick export for client review</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Cut page vs Edit page — selecting the optimal workspace for speed and control</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Rough cut to polished cut workflow</div>
      </div>
    </details>

    <details class="module-item">
      <summary>
        <span class="mod-num">04</span>
        <span class="mod-info">
          <div class="mod-title">Edit Page Mastery — Advanced Timeline Editing</div>
          <div class="mod-meta">12 Lessons · Editing</div>
        </span>
        <span class="mod-chevron">▶</span>
      </summary>
      <div class="mod-lessons">
        <div class="lesson-item"><span class="l-icon">▶</span>Timeline tracks, flags &amp; markers</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Slip, Slide, Roll &amp; Ripple trim tools</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Speed ramp — smooth slow motion techniques</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Speed Warp AI — frame interpolation magic</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Compound clips &amp; nesting for complex sequences</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Multicam editing &amp; angle switching</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Transitions — custom &amp; built-in</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Open FX plugin integration</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Titles &amp; generators — Text+ basics</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Edit Index &amp; timeline markers for collaboration</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Stacked timelines &amp; sub-timelines</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Smart Reframe AI for social media crops</div>
      </div>
    </details>

    <details class="module-item">
      <summary>
        <span class="mod-num">05</span>
        <span class="mod-info">
          <div class="mod-title">Fusion Page — Node-Based Compositing &amp; VFX</div>
          <div class="mod-meta">10 Lessons · VFX</div>
        </span>
        <span class="mod-chevron">▶</span>
      </summary>
      <div class="mod-lessons">
        <div class="lesson-item"><span class="l-icon">▶</span>Fusion node tree — navigating and structuring visual compositing flows</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Delta Keyer — green/blue screen keying</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Planar tracker &amp; 3D camera tracker</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Text+ motion graphics &amp; animations</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Masks — polygon, B-spline, paint</div>
        <div class="lesson-item"><span class="l-icon">▶</span>Merge node &amp; blending modes</div>
