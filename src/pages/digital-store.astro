---
<Layout title={title} description={description}>

  <!-- Hero Header -->
  <header class="text-center max-w-4xl mx-auto px-4 pt-10 pb-6">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#0a5f61]/10 text-[#0a5f61] font-mono text-xs font-bold rounded-full uppercase tracking-wider mb-4 border border-[#0a5f61]/20">
      🛒 OFFICIAL CREATOR ASSETS STORE
    </div>
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[#15181c] mb-4">
      Digital Products &amp; Filmmaking Assets
    </h1>
    <p class="text-lg text-[#4b5058] max-w-2xl mx-auto mb-6 leading-relaxed">
      High-converting 3D LUTs, DaVinci Resolve Studio setups, CapCut Pro desktop bundles, and 2TB video editing assets crafted by DOP &amp; Colorist <strong>Ajay K Meena</strong>.
    </p>

    <!-- Trust Badges Bar -->
    <div class="flex flex-wrap items-center justify-center gap-6 text-xs font-bold text-[#15181c] bg-white p-4 rounded-2xl border border-[#e7e4dc] shadow-sm max-w-2xl mx-auto">
      <span class="flex items-center gap-1.5"><span class="text-emerald-600">✓</span> Instant On-Screen Download</span>
      <span class="flex items-center gap-1.5"><span class="text-emerald-600">✓</span> 100% Safe Razorpay UPI Checkout</span>
      <span class="flex items-center gap-1.5"><span class="text-emerald-600">✓</span> Lifetime Drive Access</span>
    </div>
  </header>

  <!-- Product Grid Section -->
  <main class="max-w-[1100px] mx-auto px-6 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 my-8">
      {products.map(p => (
        <div class="bg-white border-2 border-[#e7e4dc] hover:border-[#0a5f61] rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 flex flex-col justify-between group transform hover:-translate-y-1">
          <div>
            <!-- Thumbnail Image Container -->
            <div class="relative overflow-hidden aspect-video bg-[#15181c]">
              <img src={p.thumbnail} alt={p.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              <span class="absolute top-3 left-3 px-3 py-1 bg-[#e0692a] text-white text-[0.7rem] font-extrabold uppercase tracking-wider rounded-full shadow-md">
                {p.badge}
              </span>
              <span class="absolute bottom-3 right-3 px-3 py-1 bg-black/80 backdrop-blur-md text-white text-xs font-bold rounded-lg border border-white/20">
                {p.buyers}
              </span>
            </div>

            <!-- Card Content -->
            <div class="p-6">
              <span class="text-xs font-bold text-[#0a5f61] uppercase tracking-wider">{p.category}</span>
              <h3 class="text-xl font-bold text-[#15181c] mt-1 mb-2 leading-snug group-hover:text-[#0a5f61] transition-colors">
                {p.title}
              </h3>
              
              <div class="flex items-center gap-2 text-xs font-semibold text-amber-500 mb-4">
                <span>{p.rating}</span>
                <span class="text-gray-300">•</span>
                <span class="text-emerald-600 font-bold">100% Instant Delivery</span>
              </div>

              <!-- Key Features List -->
              <ul class="space-y-2 mb-6 text-xs text-[#4b5058]">
                {p.features.map(f => (
                  <li class="flex items-start gap-2">
                    <span class="text-[#0a5f61] font-bold shrink-0">✓</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Price & Buy Action Footer -->
          <div class="p-6 pt-0 border-t border-[#e7e4dc] bg-[#faf9f6]">
            <div class="flex items-baseline justify-between mb-4 mt-4">
              <div>
                <span class="text-2xl font-extrabold text-[#15181c]">{p.price}</span>
                <span class="text-xs text-gray-400 line-through ml-2">{p.originalPrice}</span>
              </div>
              <span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 font-extrabold text-xs rounded-md">
                {p.discount}
              </span>
            </div>

            <!-- Razorpay Buy Button -->
            <button 
              type="button" 
              data-product-id={p.id}
              data-product-title={p.title}
              data-product-price={p.price}
              data-razorpay-url={p.razorpayLink}
              class="eg-buy-now-btn w-full py-3.5 bg-[#0a5f61] text-white font-extrabold text-sm rounded-2xl hover:bg-[#074749] transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>🛒 Buy Now &amp; Instant Download</span>
            </button>
          </div>

        </div>
      ))}
    </div>

    <!-- Universal Payment Modal Handler Script -->
    <script is:inline>
      (function() {
        var buyBtns = document.querySelectorAll('.eg-buy-now-btn');
        buyBtns.forEach(function(btn) {
          btn.addEventListener('click', function() {
            var url = btn.getAttribute('data-razorpay-url');
            var title = btn.getAttribute('data-product-title');
            var price = btn.getAttribute('data-product-price');

            // Open Razorpay Link or Custom Razorpay Popup
            if (url && url !== '#') {
              window.open(url, '_blank');
            } else {
              alert('Payment link for ' + title + ' (' + price + ') will open here via Razorpay.');
            }
          });
        });
      })();
    </script>

    <!-- FAQ & Guaranteed Delivery Banner -->
    <div class="mt-16 bg-gradient-to-r from-[#0a5f61] to-[#0f8b8d] text-white p-8 sm:p-10 rounded-3xl shadow-xl text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3 text-white">100% Guaranteed Instant Content Delivery</h2>
      <p class="text-white/90 text-sm sm:text-base max-w-2xl mx-auto mb-6">
        No waiting for email magic links or platform login bugs. As soon as your Razorpay UPI / Card payment completes, your high-speed Google Drive download link opens right on your screen!
      </p>
      <div class="inline-flex items-center gap-3 px-6 py-3 bg-white text-[#15181c] font-black text-sm rounded-full shadow-lg">
        🛡️ Protected by 24/7 VIP Customer Support
      </div>
    </div>

    <FAQBlock items={storeFaqs} />

  </main>

</Layout>
