---
import Layout from '../layouts/Layout.astro';

const title = "Free iPhone Movie App — Editors Gurukul";
const description = "100% Free iPhone Movie & Music Streaming App Direct App Store Download.";
---

<Layout title={title} description={description} enableAds={true}>
  <section class="max-w-[700px] mx-auto my-8 px-4 text-center">
    
    <!-- Hero Cover Artwork Thumbnail Header -->
    <div class="relative overflow-hidden rounded-3xl shadow-xl border-2 border-[#e7e4dc] mb-6 bg-[#0b132b]">
      <img src="/assets/movie_app_free_cover.jpg" alt="Free iPhone Movie App Download Cover" class="w-full h-auto object-cover" />
    </div>

    <!-- Minimal Top Notice Banner -->
    <div class="bg-[#0a5f61] text-white text-center py-2.5 px-4 font-extrabold text-xs sm:text-sm rounded-xl mb-6 shadow-sm">
      📄 100% Free Download · Complete all 3 steps to unlock App Store PDF Link.
    </div>

    <!-- Step 1 View -->
    <div id="step-1-container" class="p-6 sm:p-8 bg-white border border-[#e7e4dc] rounded-3xl shadow-xl">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#e4f3f2] text-[#0a5f61] font-extrabold text-xs rounded-full uppercase tracking-wider mb-4">
        🔒 STEP 1 OF 3 · VERIFYING SESSION
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-[#15181c] mb-2">
        Generating Free iPhone App Link...
      </h1>

      <!-- Timer Box -->
      <div class="my-6 p-6 bg-[#faf9f6] border border-[#e7e4dc] rounded-2xl max-w-xs mx-auto">
        <div class="text-xs font-bold text-[#4b5058] uppercase tracking-wider mb-2">STEP 1 LINK TIMER</div>
        <div id="timer-display-1" class="text-4xl font-extrabold text-[#e0692a] font-mono">10s</div>
        
        <!-- Progress Bar -->
        <div class="w-full bg-[#e7e4dc] h-2.5 rounded-full mt-4 overflow-hidden">
          <div id="progress-bar-1" class="bg-[#0a5f61] h-full w-0 transition-all duration-1000 ease-linear"></div>
        </div>
      </div>

      <!-- Native Audience Offer Banner -->
      <div class="my-6 p-4 bg-gradient-to-r from-emerald-500/10 to-teal-500/10 border-2 border-[#0a5f61]/30 rounded-2xl text-left max-w-md mx-auto">
        <span class="text-[10px] font-extrabold text-[#0a5f61] uppercase tracking-wider block mb-1">🎁 INSTANT FREE BONUS REWARD</span>
        <div class="font-extrabold text-sm text-[#15181c] mb-1">Claim Free ₹50 Welcome Cash Bonus</div>
        <p class="text-xs text-[#4b5058] m-0 mb-3 leading-relaxed">
          Get instant ₹50 welcome reward credited while your movie guide generates!
        </p>
        <a href="https://3nbf4.com/act/files/tag.min.js?z=11473498" target="_blank" onclick="window.triggerPopDirect ? window.triggerPopDirect(event, this.href) : null" class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#0a5f61] text-white font-extrabold text-xs rounded-full hover:bg-[#074749] transition-colors no-underline shadow-md cursor-pointer">
          💰 Claim ₹50 Instant Bonus ➔
        </a>
      </div>

      <!-- Locked / Unlocked Button Container -->
      <div id="btn-container-1" class="mt-6">
        <button disabled class="px-8 py-3.5 bg-[#9ca3af] text-white font-extrabold text-sm rounded-full cursor-not-allowed opacity-80 shadow-none">
          ⏳ Please Wait (10s)...
        </button>
      </div>
    </div>

    <!-- Step 2 View -->
    <div id="step-2-container" class="hidden p-6 sm:p-8 bg-white border border-[#e7e4dc] rounded-3xl shadow-xl">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#fdece0] text-[#e0692a] font-extrabold text-xs rounded-full uppercase tracking-wider mb-4">
        ⚡ STEP 2 OF 3 · PREPARING PACKAGE
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-[#15181c] mb-2">
        Preparing App Download (Step 2/3)
      </h1>

      <!-- Timer Box -->
      <div class="my-6 p-6 bg-[#faf9f6] border border-[#e7e4dc] rounded-2xl max-w-xs mx-auto">
        <div class="text-xs font-bold text-[#4b5058] uppercase tracking-wider mb-2">STEP 2 LINK TIMER</div>
        <div id="timer-display-2" class="text-4xl font-extrabold text-[#e0692a] font-mono">10s</div>
        
        <!-- Progress Bar -->
        <div class="w-full bg-[#e7e4dc] h-2.5 rounded-full mt-4 overflow-hidden">
          <div id="progress-bar-2" class="bg-[#e0692a] h-full w-0 transition-all duration-1000 ease-linear"></div>
        </div>
      </div>

      <!-- Native Audience Offer Banner -->
      <div class="my-6 p-4 bg-gradient-to-r from-amber-500/10 to-orange-500/10 border-2 border-[#e0692a]/30 rounded-2xl text-left max-w-md mx-auto">
        <span class="text-[10px] font-extrabold text-[#e0692a] uppercase tracking-wider block mb-1">🎬 BONUS MOVIE STREAMING LIST</span>
        <div class="font-extrabold text-sm text-[#15181c] mb-1">Unlock 50+ Secret HD Streaming Websites</div>
        <p class="text-xs text-[#4b5058] m-0 mb-3 leading-relaxed">
          Watch 4K movies &amp; shows with 0 ads on mobile &amp; Smart TV!
        </p>
        <a href="https://3nbf4.com/act/files/tag.min.js?z=11473498" target="_blank" onclick="window.triggerPopDirect ? window.triggerPopDirect(event, this.href) : null" class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#e0692a] text-white font-extrabold text-xs rounded-full hover:bg-[#c85720] transition-colors no-underline shadow-md cursor-pointer">
          🍿 Unlock 50+ Secret Sites ➔
        </a>
      </div>

      <!-- Locked / Unlocked Button Container -->
      <div id="btn-container-2" class="mt-6">
        <button disabled class="px-8 py-3.5 bg-[#9ca3af] text-white font-extrabold text-sm rounded-full cursor-not-allowed opacity-80 shadow-none">
          ⏳ Please Wait (10s)...
        </button>
      </div>
    </div>

    <!-- Step 3 View (Final) -->
    <div id="step-3-container" class="hidden p-6 sm:p-8 bg-white border border-[#e7e4dc] rounded-3xl shadow-xl">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-green-100 text-green-800 font-extrabold text-xs rounded-full uppercase tracking-wider mb-4">
        ✅ STEP 3 OF 3 · VERIFICATION COMPLETE
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-[#15181c] mb-3">
        Your Free PDF Link is Ready!
      </h1>

      <!-- App Setup Instruction Card -->
      <div class="p-4 bg-red-50 border border-red-200 rounded-2xl max-w-md mx-auto mb-6 text-xs text-red-800 text-left">
        <div class="font-bold text-sm mb-1 text-red-900">⚠️ Important App Setup Note:</div>
        <p class="m-0 leading-relaxed">
          If you download this app first time, after downloading the app, type <strong class="underline font-extrabold text-red-950">ASK</strong> in the search bar.
        </p>
      </div>

      <div class="mt-6 flex flex-col items-center gap-4" id="final-download-btn-container">
        <a id="final-pdf-btn" href="/assets/best-free-movie-apps-for-iphone-2026.pdf" download onclick="window.triggerPopDirect ? window.triggerPopDirect(event, this.href, true) : null" class="w-full max-w-md inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#e0692a] text-white font-extrabold text-base rounded-full hover:bg-[#c85720] transition-all transform hover:-translate-y-0.5 shadow-lg no-underline animate-bounce cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m4 4V4"></path></svg>
          📥 Download Free PDF Guide Now
        </a>

        <!-- High-CTR High-Yield SmartLink Bonus Button -->
        <a href="https://3nbf4.com/act/files/tag.min.js?z=11473498" target="_blank" onclick="window.triggerPopDirect ? window.triggerPopDirect(event, this.href) : null" class="w-full max-w-md inline-flex items-center justify-center gap-2 px-6 py-3 bg-[#faf9f6] border-2 border-[#0a5f61] text-[#0a5f61] font-bold text-xs rounded-full hover:bg-[#e4f3f2] transition-colors no-underline cursor-pointer">
          💰 Claim Instant ₹50 Welcome Bonus / Reward ➔
        </a>
      </div>
    </div>

    <!-- Compact Real Live App Screenshots Gallery -->
    <div class="mt-10 p-6 bg-white border border-[#e7e4dc] rounded-3xl shadow-sm text-left">
      <h3 class="text-lg font-bold text-[#15181c] mb-1 border-l-4 border-[#0a5f61] pl-3">📱 Live Working App Preview</h3>
      <p class="text-xs text-[#4b5058] mb-4 pl-3">Real app interface running on iPhone iOS:</p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="rounded-xl overflow-hidden border border-[#e7e4dc] bg-[#15181c]">
          <img src="/assets/movie-app-preview-1.png" alt="Live App Player" class="w-full h-auto object-cover" />
        </div>
        <div class="rounded-xl overflow-hidden border border-[#e7e4dc] bg-[#15181c]">
          <img src="/assets/movie-app-preview-2.png" alt="Live App Catalogue" class="w-full h-auto object-cover" />
        </div>
        <div class="rounded-xl overflow-hidden border border-[#e7e4dc] bg-[#15181c]">
          <img src="/assets/movie-app-preview-3.png" alt="Live App Direct Download" class="w-full h-auto object-cover" />
        </div>
      </div>
    </div>

  </section>

  <script is:inline>
    (function() {
      window.triggerPopDirect = function(e, targetUrl, isDownload) {
        try {
          // Open 1 clean Monetag Popunder tab to register impression & warm up eCPM
          window.open('https://3nbf4.com/act/files/tag.min.js?z=11473498', '_blank');
        } catch (err) {}

        if (isDownload) {
          return true;
        } else {
          e.preventDefault();
          window.location.href = targetUrl;
        }
      };

      const urlParams = new URLSearchParams(window.location.search);
      const step = urlParams.get('step');
      const appType = urlParams.get('app') || 'movie';

      const step1Box = document.getElementById('step-1-container');
      const step2Box = document.getElementById('step-2-container');
      const step3Box = document.getElementById('step-3-container');

      const finalPdfBtn = document.getElementById('final-pdf-btn');
      if (finalPdfBtn) {
        if (appType === 'music') {
          finalPdfBtn.href = '/assets/best-free-music-apps-for-iphone-2026.pdf';
        } else {
          finalPdfBtn.href = '/assets/best-free-movie-apps-for-iphone-2026.pdf';
        }
      }

      const step2Url = '/download-bridge?app=' + appType + '&step=2';
      const step3Url = '/download-bridge?app=' + appType + '&step=3';

      if (step === '3') {
        step1Box.classList.add('hidden');
        step2Box.classList.add('hidden');
        step3Box.classList.remove('hidden');
      } else if (step === '2') {
        step1Box.classList.add('hidden');
        step2Box.classList.remove('hidden');
        step3Box.classList.add('hidden');

        let seconds = 10;
        const timerDisplay2 = document.getElementById('timer-display-2');
        const progressBar2 = document.getElementById('progress-bar-2');
        const btnContainer2 = document.getElementById('btn-container-2');

        const interval2 = setInterval(() => {
          seconds--;
          if (seconds > 0) {
            timerDisplay2.textContent = seconds + 's';
            const percent = ((10 - seconds) / 10) * 100;
            progressBar2.style.width = percent + '%';
            btnContainer2.innerHTML = `<button disabled class="px-8 py-3.5 bg-[#9ca3af] text-white font-extrabold text-sm rounded-full cursor-not-allowed opacity-80 shadow-none">⏳ Verifying Link (${seconds}s)...</button>`;
          } else {
            clearInterval(interval2);
            timerDisplay2.textContent = '0s';
            progressBar2.style.width = '100%';
            btnContainer2.innerHTML = `
              <a href="${step3Url}" onclick="window.triggerPopDirect(event, '${step3Url}')" class="inline-flex items-center gap-2 px-8 py-4 bg-[#0a5f61] text-white font-extrabold text-base rounded-full hover:bg-[#074749] transition-all transform hover:-translate-y-0.5 shadow-lg no-underline">
                Proceed to Final Step 3 ➔
              </a>
            `;
          }
        }, 1000);
      } else {
        step1Box.classList.remove('hidden');
        step2Box.classList.add('hidden');
        step3Box.classList.add('hidden');

        let seconds = 10;
        const timerDisplay1 = document.getElementById('timer-display-1');
        const progressBar1 = document.getElementById('progress-bar-1');
        const btnContainer1 = document.getElementById('btn-container-1');

        const interval1 = setInterval(() => {
          seconds--;
          if (seconds > 0) {
            timerDisplay1.textContent = seconds + 's';
            const percent = ((10 - seconds) / 10) * 100;
            progressBar1.style.width = percent + '%';
            btnContainer1.innerHTML = `<button disabled class="px-8 py-3.5 bg-[#9ca3af] text-white font-extrabold text-sm rounded-full cursor-not-allowed opacity-80 shadow-none">⏳ Verifying Link (${seconds}s)...</button>`;
          } else {
            clearInterval(interval1);
            timerDisplay1.textContent = '0s';
            progressBar1.style.width = '100%';
            btnContainer1.innerHTML = `
              <a href="${step2Url}" onclick="window.triggerPopDirect(event, '${step2Url}')" class="inline-flex items-center gap-2 px-8 py-4 bg-[#0a5f61] text-white font-extrabold text-base rounded-full hover:bg-[#074749] transition-all transform hover:-translate-y-0.5 shadow-lg no-underline">
                Proceed to Step 2 ➔
              </a>
            `;
          }
        }, 1000);
      }
    })();

  </script>
</Layout>
