---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Preparing Your Download | Editors Gurukul" description="">

  <div class="card">
    <a href="/" class="brand notranslate">EDITORS GURUKUL</a>
    <h1>Your download link is getting ready...</h1>
    <p>Please wait a few seconds while we finish preparing the final link for you.</p>
    <div class="timer" id="timer">10</div>
    <button id="continueBtn" disabled>Preparing...</button>
  </div>
  <script is:inline is:inline>
    const params = new URLSearchParams(window.location.search);
    const target = params.get('target') || '/';
    const timerEl = document.getElementById('timer');
    const btn = document.getElementById('continueBtn');
    let seconds = 10;
    const interval = setInterval(() => {
      seconds -= 1;
      timerEl.textContent = seconds;
      if (seconds <= 0) {
        clearInterval(interval);
        btn.disabled = false;
        btn.textContent = 'Click to Continue';
      }
    }, 1000);
    btn.addEventListener('click', () => {
      if (btn.disabled) return;
      window.location.href = target;
    });
  </script>

</Layout>
