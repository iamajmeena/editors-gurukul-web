---
import Layout from '../layouts/Layout.astro';

const title = "Download Bridge — Editors Gurukul";
const description = "Generating secure PDF download link for Editors Gurukul iPhone Movie Apps Guide.";
---

<Layout title={title} description={description}>
  <section class="max-w-[700px] mx-auto my-12 px-4 text-center">
    
    <!-- Step 1 View (Default) -->
    <div id="step-1-container" class="p-8 bg-white border border-[#e7e4dc] rounded-3xl shadow-xl">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#e4f3f2] text-[#0a5f61] font-extrabold text-xs rounded-full uppercase tracking-wider mb-4">
        🔒 SECURE DOWNLOAD · STEP 1 OF 2
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-[#15181c] mb-3">
        Generating iPhone Movie Apps PDF Link...
      </h1>

      <p class="text-sm text-[#4b5058] max-w-md mx-auto mb-6">
        Please wait a few seconds while we verify and prepare your high-speed PDF download package.
      </p>

      <!-- Timer Box -->
      <div class="my-6 p-6 bg-[#faf9f6] border border-[#e7e4dc] rounded-2xl max-w-xs mx-auto">
        <div class="text-xs font-bold text-[#4b5058] uppercase tracking-wider mb-2">LINK GENERATING IN</div>
        <div id="timer-display" class="text-4xl font-extrabold text-[#e0692a] font-mono">12s</div>
        
        <!-- Progress Bar -->
        <div class="w-full bg-[#e7e4dc] h-2.5 rounded-full mt-4 overflow-hidden">
          <div id="progress-bar" class="bg-[#0a5f61] h-full w-0 transition-all duration-1000 ease-linear"></div>
        </div>
      </div>

      <!-- Plain Text Scroll Notice -->
      <div class="my-6 py-2.5 px-4 bg-[#e4f3f2] text-[#0a5f61] font-bold text-xs rounded-xl border border-[#0a5f61]/20">
        👇 Scroll down for link status
      </div>

      <!-- Locked / Unlocked Button Container -->
      <div id="btn-container-1" class="mt-6">
        <button disabled class="px-8 py-3.5 bg-[#9ca3af] text-white font-extrabold text-sm rounded-full cursor-not-allowed opacity-80 shadow-none">
          ⏳ Please Wait (12s)...
        </button>
      </div>
    </div>

    <!-- Step 2 View (Hidden by default) -->
    <div id="step-2-container" class="hidden p-8 bg-white border border-[#e7e4dc] rounded-3xl shadow-xl">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-green-100 text-green-800 font-extrabold text-xs rounded-full uppercase tracking-wider mb-4">
        ✅ LINK READY · STEP 2 OF 2
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-[#15181c] mb-3">
        Your PDF Download is Ready!
      </h1>

      <p class="text-sm text-[#4b5058] max-w-md mx-auto mb-4">
        Click the button below to download the official iPhone Free Movie Apps Guide (PDF).
      </p>

      <!-- App Setup Instruction Card -->
      <div class="p-4 bg-red-50 border border-red-200 rounded-2xl max-w-md mx-auto mb-6 text-xs text-red-800 text-left">
        <div class="font-bold text-sm mb-1 text-red-900">⚠️ Important App Setup Note:</div>
        <p class="m-0 leading-relaxed">
          If you download this app first time, after downloading the app, type <strong class="underline font-extrabold text-red-950">ASK</strong> in the app.
        </p>
      </div>

      <div class="mt-6">
        <a href="/assets/best-free-movie-apps-for-iphone-2026.pdf" download class="inline-flex items-center gap-2 px-8 py-4 bg-[#e0692a] text-white font-extrabold text-base rounded-full hover:bg-[#c85720] transition-all transform hover:-translate-y-0.5 shadow-lg no-underline">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          📥 Download Free PDF Guide Now
        </a>
      </div>
    </div>

  </section>

  <script is:inline>
    (function() {
      const urlParams = new URLSearchParams(window.location.search);
      const step = urlParams.get('step');

      const step1Box = document.getElementById('step-1-container');
      const step2Box = document.getElementById('step-2-container');

      if (step === '2') {
        step1Box.classList.add('hidden');
        step2Box.classList.remove('hidden');
      } else {        // Default Step 1 Countdown Logic
        let seconds = 12;
        const timerDisplay = document.getElementById('timer-display');
        const progressBar = document.getElementById('progress-bar');
        const btnContainer = document.getElementById('btn-container-1');

        const interval = setInterval(() => {
          seconds--;
          if (seconds > 0) {
            timerDisplay.textContent = seconds + 's';
            const percent = ((12 - seconds) / 12) * 100;
            progressBar.style.width = percent + '%';
            btnContainer.innerHTML = `<button disabled class="px-8 py-3.5 bg-[#9ca3af] text-white font-extrabold text-sm rounded-full cursor-not-allowed opacity-80 shadow-none">⏳ Please Wait (${seconds}s)...</button>`;
          } else {
            clearInterval(interval);
            timerDisplay.textContent = '0s';
            progressBar.style.width = '100%';
            btnContainer.innerHTML = `
              <a href="/download-bridge?step=2" class="inline-flex items-center gap-2 px-8 py-4 bg-[#0a5f61] text-white font-extrabold text-base rounded-full hover:bg-[#074749] transition-all transform hover:-translate-y-0.5 shadow-lg no-underline animate-bounce">
                Continue to Final Step (2/2) ➔
              </a>
            `;
          }
        }, 1000);
      }
    })();
  </script>
</Layout>
