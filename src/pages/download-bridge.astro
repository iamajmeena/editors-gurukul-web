---
import Layout from '../layouts/Layout.astro';

export const title = "Redirecting... | Editors Gurukul";
export const category = "free-resources";
---
<Layout title="Redirecting... | Editors Gurukul" description="">

  <div class="card max-w-[600px] mx-auto my-12 p-8 text-center bg-white border border-[#e7e4dc] rounded-2xl shadow-sm">
    <h1 class="text-2xl font-bold mb-4">Redirecting to your resource...</h1>
    <p class="text-[#4b5058] mb-6">If you are not redirected automatically within a second, click the button below.</p>
    <a id="continueBtn" class="inline-block px-6 py-3 bg-[#0a5f61] text-white font-bold rounded-full text-decoration-none" href="#">Click to Continue →</a>
  </div>
  <script is:inline>
    const params = new URLSearchParams(window.location.search);
    const target = params.get('target') || '/free-resources';
    const btn = document.getElementById('continueBtn');
    if (btn) btn.href = target;
    // Instant redirect without any 10-second timer delay
    window.location.href = target;
  </script>

</Layout>
