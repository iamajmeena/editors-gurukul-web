---
import Layout from '../layouts/Layout.astro';

export const title = "Editors Gurukul | Free Camera Settings Guide";
export const category = "camera";
---
<Layout title="Editors Gurukul | Free Camera Settings Guide" description="Download a free PDF guide to camera settings — frame rates, shutter angles, ISO, and white balance for a cinematic look on any camera.">



    <!-- Main Product Layout -->
    <main class="max-w-5xl mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">

        <!-- Left Column: Product Details -->
        <div>
            <!-- Visual Showcase Thumbnail -->
            <div class="aspect-video bg-tealSoft rounded-xl shadow-sm mb-8 flex flex-col items-center justify-center border border-line overflow-hidden p-6">
                <div class="text-4xl mb-3">📷</div>
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-inkSoft">Free Camera Guide</p>
                <p class="text-center text-inkSoft text-sm mt-2">Practical settings for cinematic shots, low light, and better exposure.</p>
            </div>

            <h1 class="font-display text-4xl text-gray-900 mb-4 tracking-wide">Ultimate Filmmaking Camera Settings</h1>
            <p class="text-inkSoft mb-6 leading-relaxed">
                Dial in the exact settings used to achieve a cinematic look. This free PDF covers frame rates, shutter angles, ISO tricks, and proper white balance techniques for your camera system.
            </p>

            <ul class="space-y-3 text-sm text-inkSoft font-medium">
                <li class="flex items-center"><span class="text-accentColor font-bold mr-2">✓</span> Universal settings for Sony, Canon, and Lumix</li>
                <li class="flex items-center"><span class="text-accentColor font-bold mr-2">✓</span> Low-light optimization techniques</li>
                <li class="flex items-center"><span class="text-accentColor font-bold mr-2">✓</span> 100% Free Download</li>
            </ul>
        </div>

        <!-- Right Column: Ad Placement & Download Timer Card -->
        <div class="bg-cardBg rounded-2xl p-8 border border-line shadow-sm flex flex-col items-center text-center">

            <h3 class="text-xl font-bold text-gray-900 mb-2">Get the guide</h3>
            <p class="text-sm text-inkSoft mb-6">If you want the full PDF version, send a quick note and I’ll share it directly.</p>

            <div class="w-full space-y-3">
                <a href="mailto:editorsgurukul@gmail.com?subject=Camera%20Settings%20Guide%20Request" class="w-full block bg-accentColor hover:opacity-90 text-white font-bold py-3.5 px-6 rounded-xl transition-all shadow-sm text-center">
                    Email for the PDF
                </a>
                <a href="/free-resources.html" class="w-full block bg-tealSoft hover:opacity-80 text-gray-800 font-semibold py-3.5 px-6 rounded-xl transition-all text-center">
                    Browse more free resources
                </a>
            </div>

        </div>
    </main>
    



</Layout>
