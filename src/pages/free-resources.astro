---
import Layout from '../layouts/Layout.astro';

export const title = "Free Resources | Editors Gurukul";
export const category = "free-resources";
---
<Layout title="Free Resources | Editors Gurukul" description="Every free filmmaking download on Editors Gurukul — camera guides, DaVinci Resolve cheat sheets, LUTs, and more, all in one place.">


  <div class="container">
    <div class="card">
      <h1>Free Resources</h1>
      <p>Explore practical filmmaking guides for cameras, color, editing, and workflow improvement.</p>
      <h2 style="font-size:1.1rem; margin-top:20px;">Camera Guides</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;">
        <div style="border:1px solid var(--line);border-radius:12px;padding:14px;background:var(--bg);">
          <h3 style="margin:0 0 6px;">Best Camera Under ₹50,000</h3>
          <p style="margin:0 0 10px;">Budget-friendly camera options for creators.</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a class="btn" href="/download-bridge?target=/1-best-camera-under-50000.html" style="margin-top:0;">Get the Guide</a>
          </div>
        </div>
        <div style="border:1px solid var(--line);border-radius:12px;padding:14px;background:var(--bg);">
          <h3 style="margin:0 0 6px;">Master Your Camera</h3>
          <p style="margin:0 0 10px;">Practical settings and technique advice.</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a class="btn" href="/download-bridge?target=/5-master-your-camera.html" style="margin-top:0;">Get the Guide</a>
          </div>
        </div>
      </div>

      <h2 style="font-size:1.1rem; margin-top:24px;">NLE Comparison Guides</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;">
        <div style="border:1px solid var(--line);border-radius:12px;padding:14px;background:var(--bg);">
          <h3 style="margin:0 0 6px;">Final Cut Pro vs Premiere Pro vs DaVinci Resolve (2026)</h3>
          <p style="margin:0 0 10px;">Pricing, performance, toolsets and a full comparison chart across all three editors.</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a class="btn" href="/download-bridge?target=/final-cut-pro-vs-premiere-pro-vs-davinci-resolve-2026.html" style="margin-top:0;">Read the Guide</a>
            <a class="btn" href="/download-bridge?target=/The%202026%20NLE%20Master%20Comparison%20Guide.pdf" style="margin-top:0;">Get the PDF</a>
          </div>
        </div>
      </div>

      <h2 style="font-size:1.1rem; margin-top:24px;">DaVinci Resolve Guides</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;">
        <div style="border:1px solid var(--line);border-radius:12px;padding:14px;background:var(--bg);">
          <h3 style="margin:0 0 6px;">Resolve Shortcuts Cheat Sheet</h3>
          <p style="margin:0 0 10px;">Fast shortcut reference for editing and grading.</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a class="btn" href="/download-bridge?target=/davinci-resolve-shortcuts-cheatsheet-2026.html" style="margin-top:0;">Get the Guide</a>
          </div>
        </div>
        <div style="border:1px solid var(--line);border-radius:12px;padding:14px;background:var(--bg);">
          <h3 style="margin:0 0 6px;">Resolve System Requirements</h3>
          <p style="margin:0 0 10px;">Choose the right machine for editing and grading.</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a class="btn" href="/download-bridge?target=/davinci-resolve-system-requirements-2026.html" style="margin-top:0;">Get the Guide</a>
          </div>
        </div>
        <div style="border:1px solid var(--line);border-radius:12px;padding:14px;background:var(--bg);">
          <h3 style="margin:0 0 6px;">Resolve Tips &amp; Tricks</h3>
          <p style="margin:0 0 10px;">Useful workflow improvements and editing hacks.</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a class="btn" href="/download-bridge?target=/davinci-resolve-tips-2026.html" style="margin-top:0;">Get the Guide</a>
          </div>
        </div>
        <div style="border:1px solid var(--line);border-radius:12px;padding:14px;background:var(--bg);">
          <h3 style="margin:0 0 6px;">Resolve Shortcuts PDF</h3>
          <p style="margin:0 0 10px;">Download the PDF cheat sheet directly.</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a class="btn" href="/download-bridge?target=/davinci-resolve-shortcuts-cheatsheet-2026.pdf" style="margin-top:0;">Get the PDF</a>
          </div>
        </div>
      </div>

    </div>
  </div>
  



</Layout>
