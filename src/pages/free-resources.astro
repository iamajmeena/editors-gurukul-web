---
import Layout from '../layouts/Layout.astro';

export const title = "Free Resources | Editors Gurukul";
export const category = "free-resources";
---
<Layout title="Free Resources | Editors Gurukul" description="Every free filmmaking download on Editors Gurukul — camera guides, DaVinci Resolve cheat sheets, LUTs, and more, all in one place.">

  <div class="container max-w-[900px] mx-auto my-8">
    
    <!-- Step 1: Lead Capture Form Box -->
    <div class="card p-8 bg-gradient-to-br from-[#ffffff] via-[#f4f3ef] to-[#e4f3f2] border-2 border-[#0a5f61]/30 rounded-3xl shadow-xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#0a5f61]/10 text-[#0a5f61] font-mono text-xs font-bold rounded-full uppercase tracking-wider mb-3">
        🎁 FREE DIRECT DOWNLOAD
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#15181c] mb-2 tracking-tight">Free Filmmaker Resource Pack &amp; LUTs</h1>
      <p class="text-[#4b5058] text-base leading-relaxed mb-6">
        Enter your details below to instantly unlock DOP &amp; Colorist Ajay K Meena's <strong>DaVinci Resolve Cheat Sheet PDF</strong>, <strong>Camera Log Exposure Guide</strong>, and <strong>Rec.709 Conversion LUTs</strong>.
      </p>

      <form id="eg-lead-form" class="space-y-4 max-w-xl">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="lead-name" class="block text-xs font-bold uppercase tracking-wider text-[#15181c] mb-1">Full Name</label>
            <input type="text" id="lead-name" required placeholder="e.g. Rahul Sharma" class="w-full p-3.5 bg-white border border-[#e7e4dc] rounded-xl font-semibold text-[#15181c] focus:outline-none focus:border-[#0a5f61]" />
          </div>
          <div>
            <label for="lead-email" class="block text-xs font-bold uppercase tracking-wider text-[#15181c] mb-1">Email Address</label>
            <input type="email" id="lead-email" required placeholder="name@example.com" class="w-full p-3.5 bg-white border border-[#e7e4dc] rounded-xl font-semibold text-[#15181c] focus:outline-none focus:border-[#0a5f61]" />
          </div>
        </div>

        <div>
          <label for="lead-phone" class="block text-xs font-bold uppercase tracking-wider text-[#15181c] mb-1">WhatsApp Number <span class="text-gray-400 font-normal">(for instant PDF link)</span></label>
          <input type="tel" id="lead-phone" required placeholder="+91 9876543210" class="w-full p-3.5 bg-white border border-[#e7e4dc] rounded-xl font-semibold text-[#15181c] focus:outline-none focus:border-[#0a5f61]" />
        </div>

        <button type="submit" id="lead-submit-btn" class="w-full py-4 bg-[#0a5f61] text-white font-extrabold text-base rounded-full hover:bg-[#074749] transition-all shadow-lg cursor-pointer transform active:scale-95">
          📩 Unlock &amp; Download Free Resource Pack →
        </button>
      </form>

      <!-- Instant Unlocked Downloads (Hidden until form submitted) -->
      <div id="eg-downloads-unlocked" class="hidden mt-6 p-6 bg-white border-2 border-emerald-500 rounded-2xl shadow-md">
        <div class="flex items-center gap-3 text-emerald-700 font-bold text-lg mb-3">
          <span>✓</span> Downloads Unlocked Successfully!
        </div>
        <p class="text-sm text-[#4b5058] mb-4">Click below to download your cheat sheets and LUT files directly:</p>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a href="/assets/davinci-resolve-shortcuts-cheatsheet.pdf" download class="p-3 bg-[#e4f3f2] border border-[#0a5f61]/20 rounded-xl text-[#0a5f61] font-bold text-sm text-center hover:bg-[#0a5f61] hover:text-white transition-all no-underline">
            📥 DaVinci Resolve Cheat Sheet PDF
          </a>
          <a href="/assets/free-rec709-conversion-lut-pack.zip" download class="p-3 bg-[#fdece0] border border-[#e0692a]/20 rounded-xl text-[#e0692a] font-bold text-sm text-center hover:bg-[#e0692a] hover:text-white transition-all no-underline">
            🎨 Rec.709 Conversion LUT Pack (.cube)
          </a>
        </div>
      </div>

    </div>

    <script is:inline>
      (function() {
        var form = document.getElementById('eg-lead-form');
        var unlockedBox = document.getElementById('eg-downloads-unlocked');

        // Check if user already submitted
        if (localStorage.getItem('eg_lead_submitted') === 'true' && unlockedBox) {
          unlockedBox.classList.remove('hidden');
        }

        if (form) {
          form.addEventListener('submit', function(e) {
            e.preventDefault();

            var name = document.getElementById('lead-name').value;
            var email = document.getElementById('lead-email').value;
            var phone = document.getElementById('lead-phone').value;

            // Submit data to Google Sheets Apps Script Webhook / Endpoint
            var webhookUrl = 'https://script.google.com/macros/s/AKfycbz_placeholder_lead_webhook/exec';
            
            try {
              fetch(webhookUrl, {
                method: 'POST',
                mode: 'no-cors',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  name: name,
                  email: email,
                  phone: phone,
                  timestamp: new Date().toISOString(),
                  page: window.location.pathname
                })
              });
            } catch(err) {
              console.log('Lead captured locally');
            }

            // Store locally & unlock downloads
            localStorage.setItem('eg_lead_submitted', 'true');
            if (unlockedBox) {
              unlockedBox.classList.remove('hidden');
              unlockedBox.scrollIntoView({ behavior: 'smooth' });
            }
          });
        }
      })();
    </script>

    <div class="card p-6 bg-white border border-[#e7e4dc] rounded-2xl shadow-sm">

      <h1>Free Resources</h1>
      <p>Explore practical filmmaking guides for cameras, color, editing, and workflow improvement.</p>
      
      <h2 style="font-size:1.4rem; margin-top:24px;">Camera Guides</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px;">
        <div style="border:1px solid var(--line);border-radius:14px;padding:18px;background:var(--bg-alt);">
          <h3 style="margin:0 0 6px; font-size:1.1rem;">Best Camera Under ₹50,000</h3>
          <p style="margin:0 0 12px; font-size:0.92rem; color:var(--ink-soft);">Budget-friendly camera options for creators.</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a class="btn" href="/1-best-camera-under-50000" style="margin-top:0;">Read the Guide →</a>
          </div>
        </div>
        <div style="border:1px solid var(--line);border-radius:14px;padding:18px;background:var(--bg-alt);">
          <h3 style="margin:0 0 6px; font-size:1.1rem;">Master Your Camera</h3>
          <p style="margin:0 0 12px; font-size:0.92rem; color:var(--ink-soft);">Practical settings and technique advice.</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a class="btn" href="/5-master-your-camera" style="margin-top:0;">Read the Guide →</a>
          </div>
        </div>
      </div>

      <h2 style="font-size:1.4rem; margin-top:32px;">NLE Comparison Guides</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px;">
        <div style="border:1px solid var(--line);border-radius:14px;padding:18px;background:var(--bg-alt);">
          <h3 style="margin:0 0 6px; font-size:1.1rem;">Final Cut Pro vs Premiere Pro vs DaVinci Resolve</h3>
          <p style="margin:0 0 12px; font-size:0.92rem; color:var(--ink-soft);">Pricing, performance, toolsets and a full comparison chart across all three editors.</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a class="btn" href="/final-cut-pro-vs-premiere-pro-vs-davinci-resolve-2026" style="margin-top:0;">Read the Guide →</a>
          </div>
        </div>
      </div>

      <h2 style="font-size:1.4rem; margin-top:32px;">DaVinci Resolve Guides</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px;">
        <div style="border:1px solid var(--line);border-radius:14px;padding:18px;background:var(--bg-alt);">
          <h3 style="margin:0 0 6px; font-size:1.1rem;">Resolve Shortcuts Cheat Sheet</h3>
          <p style="margin:0 0 12px; font-size:0.92rem; color:var(--ink-soft);">Fast shortcut reference for editing and grading.</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a class="btn" href="/davinci-resolve-shortcuts-cheatsheet-2026" style="margin-top:0;">Read the Guide →</a>
          </div>
        </div>
        <div style="border:1px solid var(--line);border-radius:14px;padding:18px;background:var(--bg-alt);">
          <h3 style="margin:0 0 6px; font-size:1.1rem;">Resolve System Requirements</h3>
          <p style="margin:0 0 12px; font-size:0.92rem; color:var(--ink-soft);">Choose the right machine for editing and grading.</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a class="btn" href="/davinci-resolve-system-requirements-2026" style="margin-top:0;">Read the Guide →</a>
          </div>
        </div>
        <div style="border:1px solid var(--line);border-radius:14px;padding:18px;background:var(--bg-alt);">
          <h3 style="margin:0 0 6px; font-size:1.1rem;">Resolve Tips &amp; Tricks</h3>
          <p style="margin:0 0 12px; font-size:0.92rem; color:var(--ink-soft);">Useful workflow improvements and editing hacks.</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a class="btn" href="/davinci-resolve-tips-2026" style="margin-top:0;">Read the Guide →</a>
          </div>
        </div>
      </div>

    </div>
  </div>

</Layout>
