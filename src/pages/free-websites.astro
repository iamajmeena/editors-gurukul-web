---
import Layout from '../layouts/Layout.astro';
import BgVideoSwitcher from '../components/BgVideoSwitcher.astro';
import { freeWebsites, websiteCategories } from '../data/free-websites';

const title = "Free Websites for Video Editors & Filmmakers (2026) | Editors Gurukul";
const description = "Hand-picked, genuinely free websites for video editing, stock footage, music/SFX, design, and AI tools — no installs, no downloads. Curated by Editors Gurukul.";
---

<Layout title={title} description={description} enableAds={false} darkTheme={true}>
  <BgVideoSwitcher />

  <!-- Transparent wrapper — the video background shows through everywhere -->
  <div class="min-h-screen text-white relative overflow-hidden font-['Sora',sans-serif]">

    <!-- Header Section (no solid fill, just a soft blur so the video reads through) -->
    <div class="relative z-10 pt-14 pb-10 px-4">
      <div class="max-w-6xl mx-auto text-center">

        <!-- Header Pill Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-black/18 backdrop-blur-sm border border-white/15 text-white font-extrabold text-xs rounded-full uppercase tracking-wider mb-5 shadow-lg hover:scale-105 transition-transform cursor-default">
          <span class="w-2.5 h-2.5 rounded-full bg-[#c084fc] animate-ping"></span>
          EDITORS GURUKUL · 2026 CURATED FREE WEBSITES DIRECTORY
        </div>

        <!-- Main Title -->
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4 text-white leading-tight drop-shadow-[0_2px_20px_rgba(0,0,0,0.6)]">
          FREE WEBSITES FOR <br class="hidden sm:inline"/>
          <span class="italic font-light">Video Editors &amp; Filmmakers</span>
        </h1>

        <p class="text-sm sm:text-base text-white/80 font-medium max-w-2xl mx-auto mb-4 leading-relaxed drop-shadow-md">
          Zero installs, zero downloads — hand-picked browser tools for editing, stock footage, music, design, and AI, all genuinely free to use.
        </p>
      </div>
    </div>

    <!-- Main Content Section -->
    <section class="max-w-6xl mx-auto px-4 py-8 relative z-10">

      <!-- Filter Row -->
      <div class="mb-8 flex flex-wrap items-center justify-between gap-3 p-3 bg-black/18 border border-white/10 rounded-2xl backdrop-blur-md shadow-xl hover:border-white/25 transition-colors">

        <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
          <!-- Category Filter -->
          <div class="relative">
            <select id="category-select" class="appearance-none bg-black/20 border border-white/15 text-white font-bold text-xs px-4 py-2.5 pr-8 rounded-xl focus:outline-none focus:border-white/50 shadow-md cursor-pointer hover:bg-black/55 backdrop-blur-sm transition-all">
              {websiteCategories.map(cat => (
                <option value={cat.id} class="text-black">{cat.label}</option>
              ))}
            </select>
            <svg class="w-3.5 h-3.5 text-white absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
          </div>

          <!-- Clear Filters Reset Pill -->
          <button
            type="button"
            id="reset-filters-btn"
            class="px-3 py-2 bg-black/20 border border-white/20 hover:bg-black/55 text-white font-extrabold text-xs rounded-xl transition-all cursor-pointer hidden backdrop-blur-sm"
          >
            Clear Filters ✖
          </button>
        </div>

        <!-- Search Input Bar -->
        <div class="relative w-full sm:w-64">
          <input
            type="text"
            id="site-search-input"
            placeholder="Search free websites..."
            class="w-full pl-9 pr-3 py-2 bg-black/20 border border-white/15 rounded-xl text-xs font-semibold text-white placeholder-white/50 focus:outline-none focus:border-white/50 shadow-md backdrop-blur-sm transition-all"
          />
          <svg class="w-3.5 h-3.5 text-white/70 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
      </div>

      <!-- Website Cards Grid -->
      <div id="sites-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {freeWebsites.map((site) => (
          <article
            data-category={site.category}
            data-keywords={`${site.name} ${site.categoryLabel} ${site.alternativeTo} ${site.description} ${site.summaryHindi}`.toLowerCase()}
            class="site-card scroll-reveal p-6 bg-white/8 border border-white/15 rounded-3xl shadow-2xl backdrop-blur-md hover:border-white/40 hover:bg-white/12 hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group opacity-0 translate-y-8"
          >
            <div>
              <!-- Top Badges Row -->
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-black/20 text-white/90 border border-white/15 font-extrabold text-xs rounded-full shadow-md backdrop-blur-sm group-hover:scale-105 transition-transform">
                  {site.logoEmoji} {site.categoryLabel}
                </span>
                <span class="px-2.5 py-0.5 bg-black/20 text-emerald-300 font-mono font-bold text-[11px] rounded-md border border-white/15 backdrop-blur-sm">
                  100% Free
                </span>
              </div>

              <!-- Free Alternative To Badge -->
              <div class="mb-3">
                <span class="inline-block px-3 py-1 bg-black/20 border border-white/15 text-white/80 font-extrabold text-[11px] rounded-lg shadow-sm backdrop-blur-sm">
                  ✨ {site.alternativeTo}
                </span>
              </div>

              <!-- Site Title -->
              <h3 class="text-xl font-extrabold text-white mb-1">
                <a href={`/free-websites/${site.id}`} class="text-white group-hover:text-[#c084fc] transition-colors no-underline group-hover:translate-x-1 duration-200 inline-block">
                  {site.name}
                </a>
              </h3>

              <p class="text-xs text-[#e0c3ff] font-bold mb-3">{site.tagline}</p>

              <!-- English Overview -->
              <p class="text-xs text-white/85 font-normal mb-4 leading-relaxed line-clamp-2">
                {site.description}
              </p>

              <!-- Hinglish Practical Explanation Box -->
              <div class="p-4 bg-black/12 border border-white/10 rounded-2xl mb-4 text-xs text-white font-medium leading-relaxed shadow-inner backdrop-blur-md">
                <strong class="text-[#e0c3ff] block mb-1 font-extrabold">💡 Practical Use Case:</strong>
                <span class="text-white">{site.summaryHindi}</span>
              </div>
            </div>

            <!-- CTA Buttons -->
            <div class="pt-4 border-t border-white/15 flex flex-col sm:flex-row gap-2">
              <a
                href={`/free-websites/${site.id}`}
                class="flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 bg-white !text-[#1a0c33] hover:bg-white/90 font-extrabold text-xs sm:text-sm rounded-xl transition-all shadow-lg no-underline active:scale-95 text-center"
              >
                📖 View Full Guide
              </a>
              <a
                href={site.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 bg-white/10 border border-white/25 hover:bg-white/20 text-white font-extrabold text-xs sm:text-sm rounded-xl transition-all no-underline active:scale-95 text-center backdrop-blur-sm"
              >
                Visit Website ↗
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Empty State -->
      <div id="no-results-msg" class="hidden text-center py-20 bg-black/18 border border-white/10 rounded-3xl mt-6 backdrop-blur-sm">
        <div class="text-5xl mb-4 animate-bounce">🔍</div>
        <h3 class="text-xl font-bold text-white mb-2">No websites found</h3>
        <p class="text-xs text-white/70">Try adjusting your filters or search query.</p>
      </div>

    </section>
  </div>

  <script is:inline>
    (function() {
      const searchInput = document.getElementById('site-search-input');
      const categorySelect = document.getElementById('category-select');
      const resetBtn = document.getElementById('reset-filters-btn');
      const cards = document.querySelectorAll('.site-card');
      const noResultsMsg = document.getElementById('no-results-msg');
      const orb1 = document.getElementById('orb-1');
      const orb2 = document.getElementById('orb-2');

      let currentCategory = 'all-cat';
      let currentQuery = '';

      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const scrollObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.remove('opacity-0', 'translate-y-8');
            entry.target.classList.add('opacity-100', 'translate-y-0');
            scrollObserver.unobserve(entry.target);
          }
        });
      }, observerOptions);

      cards.forEach(card => scrollObserver.observe(card));

      window.addEventListener('scroll', () => {
        const scrolled = window.scrollY;
        if (orb1) orb1.style.transform = `translate(-50%, ${scrolled * 0.15}px)`;
        if (orb2) orb2.style.transform = `translateY(-${scrolled * 0.1}px)`;
      });

      function filterCards() {
        let visibleCount = 0;
        let isFiltered = (currentCategory !== 'all-cat' || currentQuery !== '');

        if (resetBtn) {
          if (isFiltered) resetBtn.classList.remove('hidden');
          else resetBtn.classList.add('hidden');
        }

        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          const keywords = card.getAttribute('data-keywords') || '';

          const matchesCat = (currentCategory === 'all-cat' || cardCat === currentCategory);
          const matchesQuery = (!currentQuery || keywords.includes(currentQuery));

          if (matchesCat && matchesQuery) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (visibleCount === 0) {
          noResultsMsg.classList.remove('hidden');
        } else {
          noResultsMsg.classList.add('hidden');
        }
      }

      if (categorySelect) categorySelect.addEventListener('change', (e) => { currentCategory = e.target.value; filterCards(); });
      if (searchInput) searchInput.addEventListener('input', (e) => { currentQuery = e.target.value.toLowerCase().trim(); filterCards(); });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          currentCategory = 'all-cat';
          currentQuery = '';
          if (categorySelect) categorySelect.value = 'all-cat';
          if (searchInput) searchInput.value = '';
          filterCards();
        });
      }

      filterCards();
    })();
  </script>
</Layout>
