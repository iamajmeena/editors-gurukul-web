---
import Layout from '../layouts/Layout.astro';

const allPages = Object.values(import.meta.glob('./*.astro', { eager: true })) as any[];

const categoryLabels: Record<string, string> = {
  "davinci-resolve": "DaVinci Resolve",
  "camera": "Camera & Gear",
  "editing-fundamentals": "Editing Fundamentals",
  "nle-comparison": "NLE Comparison",
  "career": "Career & Industry"
};

const categoryOrder = ["davinci-resolve", "camera", "editing-fundamentals", "nle-comparison", "career"];

const excludeList = ['index.astro', 'about-contact.astro', 'privacy-policy.astro', 'terms.astro', 'guides.astro', 'free-resources.astro', 'my-gear.astro', 'camera-guides.astro'];

const guides = allPages.filter(page => {
  const filename = page.file.split('/').pop() || '';
  return !excludeList.includes(filename);
}).map(page => {
  const filename = page.file.split('/').pop() || '';
  const path = '/' + filename.replace('.astro', '');
  return {
    path,
    title: page.title || filename.replace(/-/g, ' ').replace('.astro', ''),
    category: page.category || 'camera',
    desc: page.description || ''
  };
});
---

<Layout title="All Guides | Editors Gurukul" description="Every free filmmaking, camera, editing and DaVinci Resolve guide on Editors Gurukul, organized by topic in one place.">

<section class="hero text-center">
  <div class="wrap">
    <span class="tag">EVERY GUIDE, ONE PLACE</span>
    <h1>All Guides</h1>
    <p class="dek">Every free camera, editing, and DaVinci Resolve guide on Editors Gurukul — grouped by topic so you can find what you actually need.</p>
  </div>
</section>

<div class="wrap guides-index space-y-12">
  {categoryOrder.map(cat => {
    const catGuides = guides.filter(g => g.category === cat);
    if (catGuides.length === 0) return null;
    return (
      <section class="cat-section" id={cat}>
        <h2>{categoryLabels[cat] || cat}</h2>
        <div class="cat-grid">
          {catGuides.map(g => (
            <a class="cat-card" href={g.path}>
              <div class="cc-title">{g.title}</div>
              {g.desc && <div class="cc-desc">{g.desc}</div>}
            </a>
          ))}
        </div>
      </section>
    );
  })}
</div>

</Layout>
