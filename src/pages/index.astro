            <!-- All Guides Grid -->
            {guides.map((guide) => {
                const slug = guide.file.split('/').pop().replace('.astro', '');
                
                let pageTitle = guide.title || slug.replace(/-/g, ' ');
                pageTitle = pageTitle.replace(/2026/g, '').trim();
                
                let category = guide.category || 'editing-fundamentals';
                if (!guide.category) {
                    if (slug.includes('davinci')) category = 'davinci-resolve';
                    if (slug.includes('camera') || slug.includes('log') || slug.includes('codec') || slug.includes('hdr')) category = 'camera';
                    if (slug.includes('tripod') || slug.includes('mic') || slug.includes('light') || slug.includes('gimbal') || slug.includes('monitor') || slug.includes('gear')) category = 'gear';
