    max-height: 0 !important;
    overflow: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    pointer-events: none !important;
  }
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  var btn = document.getElementById('eg-back-to-top');
  if (!btn) return;
  window.addEventListener('scroll', function() {
    if (window.scrollY > 400) { btn.classList.remove('hidden'); btn.classList.add('flex'); }
    else { btn.classList.add('hidden'); btn.classList.remove('flex'); }
  });
  btn.addEventListener('click', function() { window.scrollTo({ top: 0, behavior: 'smooth' }); });
});
</script>

<!-- Floating Back To Top Button -->
<button type="button" id="eg-back-to-top" class="fixed bottom-6 right-6 z-50 hidden px-4 py-3 bg-[#0a5f61] text-white font-bold text-xs rounded-full shadow-2xl hover:bg-[#0f8b8d] transition-all transform hover:scale-105 items-center gap-2 uppercase tracking-wider border border-white/20 cursor-pointer" aria-label="Back to top">
    <span>↑</span> Back To Top
</button>

<link rel="stylesheet" href="/assets/glyph-currency.css" />
<script is:inline type="module" src="/assets/glyph-currency.js"></script>
</Layout>

