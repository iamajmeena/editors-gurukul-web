<style is:inline>
  @keyframes egApplePopIn {
    0% {
      opacity: 0;
      transform: translateY(50px) scale(0.88);
    }
    65% {
      opacity: 0.95;
      transform: translateY(-6px) scale(1.025);
    }
    85% {
      transform: translateY(2px) scale(0.995);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .asset-card.eg-pop-in {
    animation: egApplePopIn 0.48s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards !important;
    will-change: transform, opacity;
  }

  .eg-filter-pill {
    transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s, color 0.2s, box-shadow 0.2s !important;
  }

  .eg-filter-pill:active {
    transform: scale(0.92) !important;
  }

  #eg-assets-grid .asset-card.eg-hide-card,
  .eg-hide-card {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    height: 0 !important;
    max-height: 0 !important;
    overflow: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    pointer-events: none !important;
  }
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  var searchInput = document.getElementById('eg-search-input');
  var searchClearBtn = document.getElementById('eg-search-clear');
  var searchFeedback = document.getElementById('eg-search-feedback');
  var filterPills = document.querySelectorAll('.eg-filter-pill');
  var noResultsBox = document.getElementById('eg-no-results');
  var resetSearchBtn = document.getElementById('eg-reset-search-btn');
  var bottomSections = document.getElementById('eg-homepage-bottom-sections');
  var currentCategory = 'all';

  function filterContent(isFromUserEnter) {
    var query = (searchInput ? searchInput.value : '').toLowerCase().trim();
    var keywords = query.length > 0 ? query.split(/\s+/).filter(Boolean) : [];

    // Toggle Clear Button
    if (searchClearBtn) {
      if (query.length > 0) {
        searchClearBtn.classList.remove('hidden');
      } else {
        searchClearBtn.classList.add('hidden');
      }
    }

    var visibleCount = 0;
    var animDelay = 0;
    var gridCards = document.querySelectorAll('#eg-assets-grid .asset-card');

    gridCards.forEach(function(card) {
      if (card.classList.contains('store-banner')) return;

      var text = card.textContent.toLowerCase();
      var category = (card.getAttribute('data-category') || '').toLowerCase();
      
      // Multi-word smart matching logic
      var matchesQuery = true;
      if (keywords.length > 0) {
        matchesQuery = keywords.every(function(kw) {
          return text.indexOf(kw) !== -1 || category.indexOf(kw) !== -1;
        });
      }
      
      var matchesCategory = false;
      if (currentCategory === 'all') {
          matchesCategory = true;
      } else if (currentCategory === 'apps') {
          matchesCategory = (category === 'apps' || text.indexOf('movie') !== -1 || text.indexOf('music') !== -1 || text.indexOf('app') !== -1);
      } else if (currentCategory === 'davinci-resolve') {
          matchesCategory = (category === 'davinci-resolve' || text.indexOf('davinci') !== -1 || text.indexOf('resolve') !== -1);
      } else if (currentCategory === 'camera') {
          matchesCategory = (category === 'camera' || text.indexOf('camera') !== -1 || text.indexOf('sensor') !== -1 || text.indexOf('iso') !== -1 || text.indexOf('codec') !== -1 || text.indexOf('log') !== -1);
      } else if (currentCategory === 'lens') {
          matchesCategory = (category === 'lens' || text.indexOf('lens') !== -1 || text.indexOf('focal') !== -1 || text.indexOf('aperture') !== -1 || text.indexOf('50mm') !== -1);
      } else if (currentCategory === 'lighting') {
          matchesCategory = (category === 'lighting' || text.indexOf('light') !== -1 || text.indexOf('cob') !== -1 || text.indexOf('rgb') !== -1 || text.indexOf('softbox') !== -1);
      } else if (currentCategory === 'filmmaking') {
          matchesCategory = (category === 'filmmaking' || category === 'gear' || text.indexOf('filmmaking') !== -1 || text.indexOf('gear') !== -1 || text.indexOf('mic') !== -1 || text.indexOf('tripod') !== -1 || text.indexOf('gimbal') !== -1 || text.indexOf('monitor') !== -1);
      } else if (currentCategory === 'storytelling') {
          matchesCategory = (category === 'storytelling' || text.indexOf('story') !== -1 || text.indexOf('script') !== -1 || text.indexOf('hook') !== -1);
      } else if (currentCategory === 'career') {
          matchesCategory = (category === 'career' || text.indexOf('career') !== -1 || text.indexOf('client') !== -1 || text.indexOf('rate') !== -1 || text.indexOf('business') !== -1);
      } else if (currentCategory === 'luts') {
          matchesCategory = (category === 'luts' || text.indexOf('lut') !== -1 || text.indexOf('pack') !== -1 || text.indexOf('free-resources') !== -1);
      } else {
          matchesCategory = (category === currentCategory);
      }

      if (matchesQuery && matchesCategory) {
        card.classList.remove('eg-hide-card');
        card.classList.remove('hidden');
        
        // Trigger Apple Reel-style spring pop animation
        card.classList.remove('eg-pop-in');
        card.style.cssText = 'display: flex !important; animation-delay: ' + animDelay + 'ms;';
        void card.offsetWidth; // Force reflow
        card.classList.add('eg-pop-in');

        visibleCount++;
        animDelay += 28; // 28ms ultra-smooth spring micro-cascade
      } else {
        card.classList.remove('eg-pop-in');
        card.classList.add('eg-hide-card');
        card.classList.add('hidden');
        card.style.cssText = 'display: none !important; visibility: hidden !important; height: 0 !important; overflow: hidden !important; margin: 0 !important; padding: 0 !important; border: none !important;';
      }
    });

    var isFiltered = query.length > 0 || currentCategory !== 'all';

    // Feedback Counter Bar
    if (searchFeedback) {
      if (isFiltered) {
        searchFeedback.classList.remove('hidden');
        var catName = currentCategory === 'all' ? 'All Resources' : currentCategory.replace(/-/g, ' ').toUpperCase();
        searchFeedback.textContent = '🔎 Found ' + visibleCount + ' guide(s)' + (query ? ' for "' + query + '"' : '') + ' in ' + catName;
      } else {
        searchFeedback.classList.add('hidden');
      }
    }

    // Toggle Bottom Branding Sections during active search/filter
    if (bottomSections) {
      if (isFiltered) {
        bottomSections.style.display = 'none';
      } else {
        bottomSections.style.display = '';
      }
    }

    // No Results Box Toggle
    if (noResultsBox) {
      if (visibleCount === 0) {
        noResultsBox.classList.remove('hidden');
      } else {
        noResultsBox.classList.add('hidden');
      }
    }

    // Smooth scroll on Enter key or query submit
    if (isFromUserEnter && visibleCount > 0) {
      var assetsContainer = document.getElementById('free-assets');
      if (assetsContainer) {
        assetsContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', function() { filterContent(false); });
    searchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        filterContent(true);
      }
    });
  }

  if (searchClearBtn) {
    searchClearBtn.addEventListener('click', function() {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
      }
      filterContent(false);
    });
  }

  if (resetSearchBtn) {
    resetSearchBtn.addEventListener('click', function() {
      if (searchInput) searchInput.value = '';
      currentCategory = 'all';
      filterPills.forEach(function(p) { p.classList.remove('active'); });
      var allPill = document.querySelector('.eg-filter-pill[data-filter="all"]');
      if (allPill) allPill.classList.add('active');
      filterContent(false);
    });
  }

  filterPills.forEach(function(pill) {
    pill.addEventListener('click', function() {
      filterPills.forEach(function(p) { p.classList.remove('active'); });
      pill.classList.add('active');
      currentCategory = pill.getAttribute('data-filter');
      filterContent(false);
    });
  });

  // Quick Chips Click Handler
  var quickChips = document.querySelectorAll('.eg-quick-chip');
  quickChips.forEach(function(chip) {
    chip.addEventListener('click', function() {
      var searchTerm = chip.getAttribute('data-search') || '';
      if (searchInput) {
        searchInput.value = searchTerm;
        filterContent(true);
      }
    });
  });

  // Floating Back-To-Top Button Logic
  var backToTopBtn = document.getElementById('eg-back-to-top');
  if (backToTopBtn) {
    window.addEventListener('scroll', function() {
      if (window.scrollY > 400) {
        backToTopBtn.classList.remove('hidden');
        backToTopBtn.classList.add('flex');
      } else {
        backToTopBtn.classList.add('hidden');
        backToTopBtn.classList.remove('flex');
      }
    });

    backToTopBtn.addEventListener('click', function() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
});
</script>

<!-- Floating Back To Top Button -->
<button type="button" id="eg-back-to-top" class="fixed bottom-6 right-6 z-50 hidden px-4 py-3 bg-[#0a5f61] text-white font-bold text-xs rounded-full shadow-2xl hover:bg-[#0f8b8d] transition-all transform hover:scale-105 items-center gap-2 uppercase tracking-wider border border-white/20 cursor-pointer" aria-label="Back to top">
    <span>↑</span> Back To Top
</button>

