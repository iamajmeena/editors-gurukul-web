                let badge = 'Guide';
                if (category === 'free-resources') badge = 'Free Download';
                if (category === 'davinci-resolve') badge = 'DaVinci Resolve';
                if (category === 'camera') badge = 'Camera Setup';
                if (category === 'gear') badge = 'Gear Guide';
                if (category === 'lens') badge = 'Lens Guide';
                if (category === 'lighting') badge = 'Lighting Guide';
                if (category === 'filmmaking') badge = 'Filmmaking Guide';
                if (category === 'storytelling') badge = 'Storytelling';
                if (category === 'career') badge = 'Career & Business';

                const desc = guideDescriptions[slug] || `Learn practical tips and master your workflow in ${pageTitle}.`;

                return (
                    <div class="asset-card eg-glass-card" data-category={category}>
