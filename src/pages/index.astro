---
import Layout from '../layouts/Layout.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';

const allPages = Object.values(import.meta.glob('./*.astro', { eager: true }));

// Filter out utility pages and index
const guides = allPages.filter(page => {
  const path = page.file.split('/').pop() || '';
  const excludeList = ['index.astro', 'about-contact.astro', 'privacy-policy.astro', 'terms.astro', 'download-bridge.astro', 'guides.astro', 'decoding-davinci-20-course.astro', 'camera-guides.astro', 'lens-guides.astro', 'lighting-guides.astro', 'filmmaking-guides.astro', 'storytelling-guides.astro', 'career-guides.astro'];
  return !excludeList.includes(path);
});

// Map custom descriptions for guides
const guideDescriptions: Record<string, string> = {
  'davinci-resolve-21-new-features-2026': 'Explore all new AI tools, color page updates, and Fairlight upgrades in DaVinci Resolve 21.',
  'davinci-resolve-fix-common-errors-2026': 'Step-by-step solutions for media offline, GPU memory full, audio sync lag, and render crashes.',
  'davinci-resolve-hidden-methods-2026': 'Pro colorist techniques for fast node management, secret power windows, and custom keyboard workflows.',
  'davinci-resolve-low-end-pc-2026': 'Optimize playback on 8GB/16GB RAM laptops with proxy generator, timeline resolution scaling, and render cache.',
  'davinci-resolve-nodes-explained-2026': 'Master serial, parallel, layer mixer, and keyer nodes for clean non-destructive color grading.',
  'davinci-resolve-shortcuts-cheatsheet-2026': 'Essential keyboard shortcuts reference sheet for editing, ripple cutting, and color node management.',
  'davinci-resolve-studio-vs-free': 'Detailed feature comparison between DaVinci Resolve Free and Studio edition (Noise reduction, 4K 120fps, Neural Engine).',
  'davinci-resolve-system-requirements-2026': 'Recommended CPU, GPU VRAM, RAM, and SSD storage specs for smooth 4K editing in DaVinci Resolve.',
  'davinci-resolve-tips-2026': '10 fast editing and color grading hacks to double your timeline speed.',
  'davinci-resolve-white-balance-method-2026': 'Accurate 3-click white balance method using chromatic adaptation and tint correction nodes.',
  '1-best-camera-under-50000': 'Top budget camera recommendations for video creators under ₹50,000 in India.',
  '2-what-is-codec': 'Understanding H.264 vs H.265 vs ProRes vs All-Intra for smooth playback.',
  '3-what-is-log': 'Why shooting in S-Log3, C-Log, or V-Log gives maximum dynamic range and how to expose it.',
  '4-what-is-hdr': 'HDR10 vs HLG vs Dolby Vision filmmaking guide for colorists.',
  '5-master-your-camera': 'Master shutter angle, ISO native ISO dual gain, and aperture for cinematic depth of field.',
  'best-rgb-stick-light-2026': 'Tested comparison of budget RGB stick lights — Digitek vs Godox LC500R.',
  'best-video-tripod-under-5000-2026': 'Digitek DTR-545VD vs Simpex 880 Pro video tripods & ₹1,400 fluid head hack.',
  'best-wireless-mic-under-5000-2026': 'Hollyland Lark A1 vs Boya BY-V20 vs Grenaro J13 wireless mic comparison.',
  'best-studio-cob-light-under-12000-2026': 'Digitek DCL-250WBC vs Godox SL60IID COB studio lights breakdown.',
  'best-gimbal-for-filmmaking-2026': 'DJI RS 3 Mini vs Zhiyun Weebill S 3-axis camera gimbals test.',
  'best-field-monitor-under-15000-2026': 'Feelworld F6 Plus vs Portkeys PT5 vs Desview R6 2800 Nits monitor review.',
  'final-cut-pro-vs-premiere-pro-vs-davinci-resolve-2026': 'Pricing, performance, toolsets, and full NLE comparison chart across all three video editors.',
  'best-free-movie-apps-for-iphone-2026': 'Top 7 safe and 100% legal free movie streaming apps for iPhone and iPad in 2026.',
  'davinci-resolve-color-management-cst-vs-aces': 'Master Color Space Transforms (CST), ACEScct, and DaVinci YRGB Color Managed.',
  'davinci-resolve-skin-tone-grading-vectorscope-guide': 'Dial in natural skin tones using Vectorscope skin line, HSL Qualifiers, and skin smoothing.',
  'davinci-resolve-ai-tools-relight-depth-map-magic-mask': 'Master AI Relight 3D, Depth Map isolating backgrounds, and Magic Mask 2.0 subject tracking.',
  'davinci-resolve-fairlight-audio-post-lufs-standards': 'Fairlight audio mastering: AI Voice Isolation, Dialogue Leveller, and target LUFS standards.',
  'viral-short-form-reels-shorts-editing-guide': 'Build high-retention 9:16 Instagram Reels & Shorts: Hook formulas, animated captions, and sound stacks.'
};
---
<Layout title="Editors Gurukul | Free Filmmaking Guides, LUTs & Courses" description="Editors Gurukul offers free filmmaking guides, LUT resources, camera cheat sheets, and premium courses for creators and editors.">

    <!-- 1. VERY TOP HERO: Flagship Course Showcase Banner -->
    <section class="max-w-6xl mx-auto px-6 pt-6 mb-8">
        <div class="relative overflow-hidden p-8 sm:p-10 rounded-3xl border border-[#e4f3f2] shadow-2xl transition-all duration-300 hover:shadow-[0_20px_50px_rgba(10,95,97,0.3)] hover:border-[#0a5f61]" style="background: linear-gradient(135deg, #0a5f61 0%, #0f8b8d 60%, #15181c 100%);">
            
            <!-- Glowing Ambient Accent -->
            <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-[#e0692a] opacity-20 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-8">
                <div class="flex-1 text-left">
                    <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 text-white font-mono text-xs font-bold uppercase tracking-wider mb-4 border border-white/20">
                        <span class="w-2 h-2 rounded-full bg-[#e0692a] animate-pulse"></span>
                        FLAGSHIP COURSE BY AJAY K. MEENA
                    </span>
                    
                    <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-3 tracking-tight border-none p-0 m-0">
                        Decoding DaVinci Resolve 2.0
                    </h2>
                    
                    <p class="text-lg sm:text-xl font-semibold text-[#e4f5f4] mb-3 leading-relaxed">
                        If you want to master professional color grading, video editing, and build a high-income creative career...
                    </p>
                    
                    <p class="text-sm sm:text-base text-white/80 mb-6 leading-relaxed">
                        Learn real production node trees, CST color management, skin tone grading, Fairlight audio post, and AI tools directly from a working DOP.
                    </p>

                    <!-- Value Chips -->
                    <div class="flex flex-wrap gap-2 mb-2 text-xs sm:text-sm font-semibold text-white/90">
                        <span class="px-3 py-1 bg-white/10 rounded-lg border border-white/15">✓ Node-Based Grading</span>
                        <span class="px-3 py-1 bg-white/10 rounded-lg border border-white/15">✓ Log to Rec.709 Transforms</span>
                        <span class="px-3 py-1 bg-white/10 rounded-lg border border-white/15">✓ AI Neural Engine Tools</span>
                        <span class="px-3 py-1 bg-white/10 rounded-lg border border-white/15">✓ Real Project Files</span>
                    </div>
                </div>

                <!-- CTA Actions -->
                <div class="flex flex-col sm:flex-row lg:flex-col gap-4 w-full lg:w-auto shrink-0">
                    <a href="https://www.ajaykmeena.com/courses/Decoding-DaVinci-Resolve-20--The-Ultimate-course-for-Video-Editing-Color-Grading--AI-Powered-Filmmaking-69b89bb32c97f8fb76db7ee8" target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-[#e0692a] text-white font-extrabold text-base sm:text-lg rounded-full text-center hover:bg-[#c85720] transition-all transform hover:-translate-y-1 shadow-lg hover:shadow-orange-500/40 no-underline">
                        Enroll in Decoding DaVinci 2.0 🎓
                    </a>
                    <a href="/decoding-davinci-20-course" class="px-8 py-3.5 bg-white/10 text-white font-bold text-sm sm:text-base rounded-full text-center hover:bg-white/20 transition-all border border-white/20 no-underline">
                        Explore Course Curriculum →
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. SECOND HERO & INTEGRATED SEARCH SECTION -->
    <section class="hero-section text-center max-w-4xl mx-auto px-4 pt-2 pb-4">
        <span class="hero-pill shadow-sm">🎥 EDITORS GURUKUL KNOWLEDGE HUB</span>
        <h1 class="hero-title text-4xl sm:text-5xl font-extrabold tracking-tight mb-4">
            READ OUR BLOGS, MASTER FILMMAKING &amp; VIDEO EDITING
        </h1>
        <p class="hero-subtitle text-lg sm:text-xl text-[#4b5058] max-w-2xl mx-auto mb-6 leading-relaxed">
            Explore 50+ free filmmaking guides, camera cheat sheets, DaVinci Resolve tutorials, LUTs, and legal iOS apps by DOP Ajay K. Meena.
        </p>

        <!-- Integrated Hero Glass Search Box & Category Pills -->
        <div class="eg-search-section eg-glass-card shadow-2xl rounded-3xl p-6 border border-[#e4f3f2] bg-white/80 backdrop-blur-md mb-6">
            <div class="eg-search-input-wrapper relative flex items-center">
                <span class="eg-search-icon absolute left-4 text-xl">🔍</span>
                <input type="text" id="eg-search-input" class="eg-search-input pl-12 pr-10 py-4 text-base sm:text-lg border-2 border-[#e7e4dc] focus:border-[#0a5f61] rounded-full w-full shadow-inner" placeholder="Search DaVinci tips, camera guides, LUTs, movie/music apps..." aria-label="Search guides and resources">
                <button type="button" id="eg-search-clear" class="hidden absolute right-4 text-gray-400 hover:text-gray-700 font-bold text-xl cursor-pointer">✕</button>
            </div>

            <!-- Search Feedback Counter Bar -->
            <div id="eg-search-feedback" class="hidden mt-3 text-xs sm:text-sm font-bold text-[#0a5f61] px-2 text-left"></div>

            <!-- Category Filter Pills -->
            <div class="eg-filter-pills mt-5 flex flex-wrap justify-center gap-2" id="eg-filter-pills">
                <button type="button" class="eg-filter-pill active" data-filter="all">All Resources</button>
                <button type="button" class="eg-filter-pill" data-filter="apps">📱 Mobile Apps &amp; Guides</button>
                <button type="button" class="eg-filter-pill" data-filter="davinci-resolve">🎨 DaVinci Resolve</button>
                <button type="button" class="eg-filter-pill" data-filter="camera">📷 Camera Guides</button>
                <button type="button" class="eg-filter-pill" data-filter="lens">🔎 Lens Guides</button>
                <button type="button" class="eg-filter-pill" data-filter="lighting">💡 Lighting Guides</button>
                <button type="button" class="eg-filter-pill" data-filter="filmmaking">🎥 Filmmaking &amp; Gear</button>
                <button type="button" class="eg-filter-pill" data-filter="storytelling">✍️ Storytelling</button>
                <button type="button" class="eg-filter-pill" data-filter="career">💼 Career &amp; Business</button>
                <button type="button" class="eg-filter-pill" data-filter="luts">🎁 LUTs &amp; Packs</button>
            </div>
        </div>
    </section>

    <!-- 3. CLEAN DIRECT RESOURCE GRID SECTION -->
    <main class="max-w-6xl mx-auto px-6 pb-16" id="free-assets">
        
        <!-- No Results Fallback Card -->
        <div id="eg-no-results" class="hidden p-8 bg-white border-2 border-dashed border-[#e0692a] rounded-3xl text-center my-6">
            <div class="text-4xl mb-3">🔍</div>
            <h3 class="text-xl font-extrabold text-[#15181c] mb-2">No Guides Found</h3>
            <p class="text-sm text-[#4b5058] max-w-md mx-auto mb-4">
                We couldn't find any resources matching your search. Try searching for <strong>"davinci"</strong>, <strong>"camera"</strong>, <strong>"movie"</strong>, or <strong>"music"</strong>.
            </p>
            <button type="button" id="eg-reset-search-btn" class="px-6 py-2.5 bg-[#0a5f61] text-white font-bold text-sm rounded-full cursor-pointer hover:bg-[#074749]">
                View All Resources
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="eg-assets-grid">

            <!-- All Guides Grid -->
            {guides.map((guide) => {
                const slug = guide.file.split('/').pop().replace('.astro', '');
                
                let rawTitle = slug.split('-').map(w => w.length <= 3 && !['new', 'log', 'hdr', 'cob', 'rgb', 'mic', 'pdf', '50mm', '24fps'].includes(w) ? w.toUpperCase() : w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
                let pageTitle = guide.title || rawTitle.replace(/2026/g, '').replace(/Davinci/g, 'DaVinci').trim();
                
                let category = guide.category || 'editing-fundamentals';
                if (!guide.category) {
                    if (slug.includes('davinci')) category = 'davinci-resolve';
                    if (slug.includes('camera') || slug.includes('log') || slug.includes('codec') || slug.includes('hdr') || slug.includes('iso') || slug.includes('sensor')) category = 'camera';
                    if (slug.includes('tripod') || slug.includes('mic') || slug.includes('light') || slug.includes('gimbal') || slug.includes('monitor') || slug.includes('gear')) category = 'gear';
                    if (slug.includes('lens')) category = 'lens';
                    if (slug.includes('lighting')) category = 'lighting';
                    if (slug.includes('storytelling') || slug.includes('character') || slug.includes('three-act') || slug.includes('hook') || slug.includes('visual-storytelling')) category = 'storytelling';
                    if (slug.includes('career') || slug.includes('editor-rates') || slug.includes('client-wedding')) category = 'career';
                    if (slug.includes('movie') || slug.includes('music') || slug.includes('app')) category = 'apps';
                }

                let badge = 'Guide';
                if (category === 'apps') badge = 'Mobile App & PDF';
                if (category === 'free-resources') badge = 'Free Download';
                if (category === 'davinci-resolve') badge = 'DaVinci Resolve';
                if (category === 'camera') badge = 'Camera Setup';
                if (category === 'gear') badge = 'Gear Guide';
                if (category === 'lens') badge = 'Lens Guide';
                if (category === 'lighting') badge = 'Lighting Guide';
                if (category === 'filmmaking') badge = 'Filmmaking Guide';
                if (category === 'storytelling') badge = 'Storytelling';
                if (category === 'career') badge = 'Career & Business';

                const desc = guideDescriptions[slug] || `Learn practical tips and master your workflow in ${pageTitle}.`;

                return (
                    <div class="asset-card eg-glass-card" data-category={category}>
                        <div>
                            <span class="asset-card__badge">{badge}</span>
                            <h3 style="font-size:1.1rem; font-weight:700; color:var(--ink); margin:8px 0;">{pageTitle}</h3>
                            <p style="color:var(--ink-soft); font-size:0.92rem; line-height:1.6; margin-bottom:16px;">{desc}</p>
                        </div>
                        <div style="margin-top:auto;">
                            <a href={`/${slug}`} style="background:#0a5f61; color:#ffffff; padding:10px 20px; border-radius:999px; font-weight:700; text-decoration:none; font-size:0.9rem; display:inline-block;">Read Guide →</a>
                        </div>
                    </div>
                );
            })}

        </div>
    </main>

    <!-- Bottom Static Branding Sections Container -->
    <div id="eg-homepage-bottom-sections">
        <!-- Featured Work Section -->
        <section class="max-w-6xl mx-auto px-6 pb-8">
            <div class="eg-glass-card p-6 sm:p-8 rounded-3xl" style="border:1px solid var(--line); background: linear-gradient(135deg, var(--teal-soft) 0%, var(--bg-alt) 100%);">
                <span class="asset-card__badge">Featured Work</span>
                <h3 style="margin-bottom:8px; font-size:1.25rem; font-weight:700;">My best projects</h3>
                <p style="margin-bottom:12px; color:var(--ink-soft);">These are some of my strongest cinematic and editing projects, gathered in one playlist for easy viewing.</p>
                <a href="https://www.youtube.com/playlist?list=PLED7bDIOW7ZnDXOoEiinpNija78mIcyTX" target="_blank" style="display:inline-block; width:auto;" rel="noopener noreferrer">Watch the playlist ↗</a>
            </div>
        </section>

        <!-- Cinematic Color Grading Section with Slider -->
        <section class="max-w-6xl mx-auto px-6 pb-8">
            <div class="eg-glass-card p-6 sm:p-8 rounded-3xl" style="border:1px solid var(--line); background: linear-gradient(135deg, var(--bg) 0%, var(--bg-alt) 100%);">
                <h3 style="margin-bottom:10px; font-size:1.25rem; font-weight:700;">Cinematic Color Grading</h3>
                <p style="margin-bottom:16px; color:var(--ink-soft);">Explore a premium before-and-after color grading experience with a split-view concept built for cinematic storytelling and modern post-production.</p>
                
                <BeforeAfterSlider 
                    beforeImage="/assets/davinci-resolve-wb-portrait-before.webp"
                    afterImage="/assets/davinci-resolve-wb-portrait-after.webp"
                    beforeLabel="Flat LOG"
                    afterLabel="Graded"
                />
                
                <div style="margin-top:20px;">
                    <a href="https://www.ajaykmeena.com/courses/Decoding-DaVinci-Resolve-20--The-Ultimate-course-for-Video-Editing-Color-Grading--AI-Powered-Filmmaking-69b89bb32c97f8fb76db7ee8" target="_blank" style="display:inline-block;padding:10px 18px;background:var(--teal-deep);color:#ffffff;border-radius:999px;text-decoration:none;font-weight:700;" rel="noopener noreferrer">Master Color Grading ↗</a>
                </div>
            </div>
        </section>

        <!-- About Ajay K. Meena Section -->
        <section class="max-w-6xl mx-auto px-6 pb-16">
            <div class="p-6 sm:p-8 rounded-3xl" style="border:1px solid var(--line); background:var(--bg-alt);">
                <h3 style="margin-bottom:8px; font-size:1.25rem; font-weight:700;">About Ajay K. Meena</h3>
                <p style="margin-bottom:12px; color:var(--ink-soft);">I’m a Director of Photography, cinematographer, and colorist based in Jaipur, Rajasthan. My work focuses on cinematic storytelling, moody lighting, and practical filmmaking education for creators who want to improve their craft.</p>
                <p style="margin-bottom:12px; color:var(--ink-soft);">I created Editors Gurukul to share real camera settings, lighting ideas, and professional workflows in a simple, useful format.</p>
                <div style="display:flex;flex-wrap:wrap;gap:10px; align-items:center;">
                    <a href="https://youtube.com/@ajaykmeenaa" target="_blank" style="display:inline-block;padding:10px 14px;background:var(--teal-deep);color:#ffffff;border-radius:999px;text-decoration:none;font-weight:700;" rel="noopener noreferrer">YouTube</a>
                    <a href="https://instagram.com/iamajmeena" target="_blank" style="display:inline-block;padding:10px 14px;background:var(--orange);color:#ffffff;border-radius:999px;text-decoration:none;font-weight:700;" rel="noopener noreferrer">Instagram</a>
                    <a href="mailto:editorsgurukul@gmail.com" style="display:inline-block;padding:10px 14px;background:var(--teal-soft);color:var(--teal-deep);border-radius:999px;text-decoration:none;font-weight:700;">Email</a>
                </div>
            </div>
        </section>

        <!-- Work with Wedream Production Section -->
        <section class="max-w-6xl mx-auto px-6 pb-16">
            <div class="p-6 sm:p-8 rounded-3xl" style="border:1px solid var(--line); background: linear-gradient(135deg, #0a5f61 0%, #0f8b8d 100%) !important; color:#ffffff !important;">
                <h3 style="margin-bottom:8px; color:#ffffff !important; font-size:1.25rem; font-weight:700;">Work with Wedream Production</h3>
                <p style="margin-bottom:12px; color:#e4f5f4 !important;">We offer professional DOP, cinematography, and commercial shoot services for brands, campaigns, and premium storytelling projects.</p>
                <a href="mailto:editorsgurukul@gmail.com" style="display:inline-block;padding:10px 18px;background:#ffffff !important;color:#0a5f61 !important;border-radius:999px;text-decoration:none;font-weight:700;">Contact for Shoots</a>
            </div>
        </section>
    </div>

    <!-- Mobile Sticky Navigation Bar -->
    <nav class="mobile-sticky-bar">
        <a href="#free-assets">Free Assets</a>
        <a href="/camera-guides">Camera Guides</a>
        <a href="https://www.ajaykmeena.com/courses/Decoding-DaVinci-Resolve-20--The-Ultimate-course-for-Video-Editing-Color-Grading--AI-Powered-Filmmaking-69b89bb32c97f8fb76db7ee8" target="_blank" class="store-pill" rel="noopener noreferrer">Store ↗</a>
    </nav>

<style is:inline>
  @keyframes egApplePopIn {
    0% {
      opacity: 0;
      transform: translateY(50px) scale(0.88);
    }
    65% {
      opacity: 0.95;
      transform: translateY(-6px) scale(1.025);
    }
    85% {
      transform: translateY(2px) scale(0.995);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .asset-card.eg-pop-in {
    animation: egApplePopIn 0.48s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards !important;
    will-change: transform, opacity;
  }

  .eg-filter-pill {
    transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s, color 0.2s, box-shadow 0.2s !important;
  }

  .eg-filter-pill:active {
    transform: scale(0.92) !important;
  }

  #eg-assets-grid .asset-card.eg-hide-card,
  .eg-hide-card {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    height: 0 !important;
    max-height: 0 !important;
    overflow: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    pointer-events: none !important;
  }
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  var searchInput = document.getElementById('eg-search-input');
  var searchClearBtn = document.getElementById('eg-search-clear');
  var searchFeedback = document.getElementById('eg-search-feedback');
  var filterPills = document.querySelectorAll('.eg-filter-pill');
  var noResultsBox = document.getElementById('eg-no-results');
  var resetSearchBtn = document.getElementById('eg-reset-search-btn');
  var bottomSections = document.getElementById('eg-homepage-bottom-sections');
  var currentCategory = 'all';

  function filterContent(isFromUserEnter) {
    var query = (searchInput ? searchInput.value : '').toLowerCase().trim();
    var keywords = query.length > 0 ? query.split(/\s+/).filter(Boolean) : [];

    // Toggle Clear Button
    if (searchClearBtn) {
      if (query.length > 0) {
        searchClearBtn.classList.remove('hidden');
      } else {
        searchClearBtn.classList.add('hidden');
      }
    }

    var visibleCount = 0;
    var animDelay = 0;
    var gridCards = document.querySelectorAll('#eg-assets-grid .asset-card');

    gridCards.forEach(function(card) {
      if (card.classList.contains('store-banner')) return;

      var text = card.textContent.toLowerCase();
      var category = (card.getAttribute('data-category') || '').toLowerCase();
      
      // Multi-word smart matching logic
      var matchesQuery = true;
      if (keywords.length > 0) {
        matchesQuery = keywords.every(function(kw) {
          return text.indexOf(kw) !== -1 || category.indexOf(kw) !== -1;
        });
      }
      
      var matchesCategory = false;
      if (currentCategory === 'all') {
          matchesCategory = true;
      } else if (currentCategory === 'apps') {
          matchesCategory = (category === 'apps' || text.indexOf('movie') !== -1 || text.indexOf('music') !== -1 || text.indexOf('app') !== -1);
      } else if (currentCategory === 'davinci-resolve') {
          matchesCategory = (category === 'davinci-resolve' || text.indexOf('davinci') !== -1 || text.indexOf('resolve') !== -1);
      } else if (currentCategory === 'camera') {
          matchesCategory = (category === 'camera' || text.indexOf('camera') !== -1 || text.indexOf('sensor') !== -1 || text.indexOf('iso') !== -1 || text.indexOf('codec') !== -1 || text.indexOf('log') !== -1);
      } else if (currentCategory === 'lens') {
          matchesCategory = (category === 'lens' || text.indexOf('lens') !== -1 || text.indexOf('focal') !== -1 || text.indexOf('aperture') !== -1 || text.indexOf('50mm') !== -1);
      } else if (currentCategory === 'lighting') {
          matchesCategory = (category === 'lighting' || text.indexOf('light') !== -1 || text.indexOf('cob') !== -1 || text.indexOf('rgb') !== -1 || text.indexOf('softbox') !== -1);
      } else if (currentCategory === 'filmmaking') {
          matchesCategory = (category === 'filmmaking' || category === 'gear' || text.indexOf('filmmaking') !== -1 || text.indexOf('gear') !== -1 || text.indexOf('mic') !== -1 || text.indexOf('tripod') !== -1 || text.indexOf('gimbal') !== -1 || text.indexOf('monitor') !== -1);
      } else if (currentCategory === 'storytelling') {
          matchesCategory = (category === 'storytelling' || text.indexOf('story') !== -1 || text.indexOf('script') !== -1 || text.indexOf('hook') !== -1);
      } else if (currentCategory === 'career') {
          matchesCategory = (category === 'career' || text.indexOf('career') !== -1 || text.indexOf('client') !== -1 || text.indexOf('rate') !== -1 || text.indexOf('business') !== -1);
      } else if (currentCategory === 'luts') {
          matchesCategory = (category === 'luts' || text.indexOf('lut') !== -1 || text.indexOf('pack') !== -1 || text.indexOf('free-resources') !== -1);
      } else {
          matchesCategory = (category === currentCategory);
      }

      if (matchesQuery && matchesCategory) {
        card.classList.remove('eg-hide-card');
        card.classList.remove('hidden');
        
        // Trigger Apple Reel-style spring pop animation
        card.classList.remove('eg-pop-in');
        card.style.cssText = 'display: flex !important; animation-delay: ' + animDelay + 'ms;';
        void card.offsetWidth; // Force reflow
        card.classList.add('eg-pop-in');

        visibleCount++;
        animDelay += 28; // 28ms ultra-smooth spring micro-cascade
      } else {
        card.classList.remove('eg-pop-in');
        card.classList.add('eg-hide-card');
        card.classList.add('hidden');
        card.style.cssText = 'display: none !important; visibility: hidden !important; height: 0 !important; overflow: hidden !important; margin: 0 !important; padding: 0 !important; border: none !important;';
      }
    });

    var isFiltered = query.length > 0 || currentCategory !== 'all';

    // Feedback Counter Bar
    if (searchFeedback) {
      if (isFiltered) {
        searchFeedback.classList.remove('hidden');
        var catName = currentCategory === 'all' ? 'All Resources' : currentCategory.replace(/-/g, ' ').toUpperCase();
        searchFeedback.textContent = '🔎 Found ' + visibleCount + ' guide(s)' + (query ? ' for "' + query + '"' : '') + ' in ' + catName;
      } else {
        searchFeedback.classList.add('hidden');
      }
    }

    // Toggle Bottom Branding Sections during active search/filter
    if (bottomSections) {
      if (isFiltered) {
        bottomSections.style.display = 'none';
      } else {
        bottomSections.style.display = '';
      }
    }

    // No Results Box Toggle
    if (noResultsBox) {
      if (visibleCount === 0) {
        noResultsBox.classList.remove('hidden');
      } else {
        noResultsBox.classList.add('hidden');
      }
    }

    // Smooth scroll on Enter key or query submit
    if (isFromUserEnter && visibleCount > 0) {
      var assetsContainer = document.getElementById('free-assets');
      if (assetsContainer) {
        assetsContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', function() { filterContent(false); });
    searchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        filterContent(true);
      }
    });
  }

  if (searchClearBtn) {
    searchClearBtn.addEventListener('click', function() {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
      }
      filterContent(false);
    });
  }

  if (resetSearchBtn) {
    resetSearchBtn.addEventListener('click', function() {
      if (searchInput) searchInput.value = '';
      currentCategory = 'all';
      filterPills.forEach(function(p) { p.classList.remove('active'); });
      var allPill = document.querySelector('.eg-filter-pill[data-filter="all"]');
      if (allPill) allPill.classList.add('active');
      filterContent(false);
    });
  }

  filterPills.forEach(function(pill) {
    pill.addEventListener('click', function() {
      filterPills.forEach(function(p) { p.classList.remove('active'); });
      pill.classList.add('active');
      currentCategory = pill.getAttribute('data-filter');
      filterContent(false);
    });
  });
});
</script>

</Layout>
