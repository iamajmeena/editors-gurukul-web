            <h3 style="margin-bottom:8px; color:#ffffff !important;">Work with Wedream Production</h3>
            <p style="margin-bottom:12px; color:#e4f5f4 !important;">We offer professional DOP, cinematography, and commercial shoot services for brands, campaigns, and premium storytelling projects.</p>
            <a href="mailto:editorsgurukul@gmail.com" style="display:inline-block;padding:10px 18px;background:#ffffff !important;color:#0a5f61 !important;border-radius:999px;text-decoration:none;font-weight:700;">Contact for Shoots</a>
        </div>
    </section>

    <!-- Mobile Sticky Navigation Bar -->
    <nav class="mobile-sticky-bar">
        <a href="#free-assets">Free Assets</a>
        <a href="/camera-guides">Camera Guides</a>
        <a href="https://www.ajaykmeena.com/courses/Decoding-DaVinci-Resolve-20--The-Ultimate-course-for-Video-Editing-Color-Grading--AI-Powered-Filmmaking-69b89bb32c97f8fb76db7ee8" target="_blank" class="store-pill" rel="noopener noreferrer">Store ↗</a>
    </nav>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  var searchInput = document.getElementById('eg-search-input');
  var filterPills = document.querySelectorAll('.eg-filter-pill');
  var assetCards = document.querySelectorAll('.asset-card');
  var currentCategory = 'all';

  function filterContent() {
    var query = (searchInput ? searchInput.value : '').toLowerCase().trim();

    assetCards.forEach(function(card) {
      if (card.classList.contains('store-banner')) return;
      if (!card.hasAttribute('data-category')) return;

      var text = card.textContent.toLowerCase();
      var category = (card.getAttribute('data-category') || '').toLowerCase();
      
      var matchesQuery = !query || text.indexOf(query) !== -1;
      
      var matchesCategory = false;
      if (currentCategory === 'all') {
          matchesCategory = true;
      } else if (currentCategory === 'davinci-resolve') {
          matchesCategory = (category === 'davinci-resolve' || text.indexOf('davinci') !== -1 || text.indexOf('resolve') !== -1);
      } else if (currentCategory === 'camera') {
          matchesCategory = (category === 'camera' || category === 'gear' || text.indexOf('camera') !== -1);
      } else if (currentCategory === 'luts') {
          matchesCategory = (category === 'luts' || text.indexOf('lut') !== -1 || text.indexOf('pack') !== -1);
      } else if (currentCategory === 'lens' || currentCategory === 'lighting' || currentCategory === 'filmmaking' || currentCategory === 'storytelling' || currentCategory === 'career') {
          matchesCategory = (category === currentCategory);
      } else {
          matchesCategory = (category === currentCategory);
      }

      if (matchesQuery && matchesCategory) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', filterContent);
  }

  filterPills.forEach(function(pill) {
    pill.addEventListener('click', function() {
      filterPills.forEach(function(p) { p.classList.remove('active'); });
      pill.classList.add('active');
      currentCategory = pill.getAttribute('data-filter');
      filterContent();
    });
  });
});
</script>

</Layout>
