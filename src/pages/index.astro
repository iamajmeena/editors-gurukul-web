        <div class="relative overflow-hidden p-8 sm:p-10 rounded-3xl border border-[#e4f3f2] shadow-2xl transition-all duration-300 hover:shadow-[0_20px_50px_rgba(10,95,97,0.3)] hover:border-[#0a5f61]" style="background: linear-gradient(135deg, #0a5f61 0%, #0f8b8d 60%, #15181c 100%);">
            
            <!-- Glowing Ambient Accent -->
            <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-[#e0692a] opacity-20 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-8">
                <div class="flex-1 text-left">
                    <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 text-white font-mono text-xs font-bold uppercase tracking-wider mb-4 border border-white/20">
                        <span class="w-2 h-2 rounded-full bg-[#e0692a] animate-pulse"></span>
                        FLAGSHIP COURSE BY AJAY K. MEENA
                    </span>
                    
                    <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-3 tracking-tight border-none p-0 m-0">
                        Decoding DaVinci Resolve 2.0
