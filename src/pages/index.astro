                <a href="https://instagram.com/iamajmeena" target="_blank" style="display:inline-block;padding:10px 14px;background:var(--orange);color:#ffffff;border-radius:999px;text-decoration:none;font-weight:700;" rel="noopener noreferrer">Instagram</a>
                <a href="mailto:editorsgurukul@gmail.com" style="display:inline-block;padding:10px 14px;background:var(--teal-soft);color:var(--teal-deep);border-radius:999px;text-decoration:none;font-weight:700;">Email</a>
