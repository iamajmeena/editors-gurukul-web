---
import Layout from '../layouts/Layout.astro';

const title = "Live Instagram Follower Counter & Growth Simulator (2026) | Editors Gurukul";
const description = "Real-time Instagram live follower count tracker and viral growth simulator with instant speed controls and milestone celebrations.";
---

<Layout title={title} description={description} enableAds={false} darkTheme={true}>
  <!-- Main Wrapper -->
  <div class="min-h-screen bg-[#0d0714] text-white relative overflow-hidden font-['Sora',sans-serif]">
    
    <!-- Instagram Ambient Gradient Orbs -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[450px] bg-gradient-to-tr from-[#f09433] via-[#e6683c] to-[#bc1888] opacity-20 blur-[160px] pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 py-12 relative z-10 space-y-8">
      
      <!-- Top Title Header -->
      <div class="text-center space-y-3">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-gradient-to-r from-[#f09433]/20 via-[#dc2743]/20 to-[#bc1888]/20 border border-[#e1306c]/40 text-[#fcf font-extrabold text-xs rounded-full uppercase tracking-wider shadow-lg">
          <span class="w-2.5 h-2.5 rounded-full bg-[#e1306c] animate-ping"></span>
          REAL-TIME INSTAGRAM GROWTH SIMULATOR
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
          LIVE INSTAGRAM <br class="hidden sm:inline"/>
          <span class="bg-gradient-to-r from-[#f09433] via-[#dc2743] to-[#bc1888] bg-clip-text text-transparent drop-shadow-[0_0_30px_rgba(225,48,108,0.5)]">
            FOLLOWER COUNTER 🚀
          </span>
        </h1>
        <p class="text-xs sm:text-sm text-[#e9d5ff] max-w-lg mx-auto">
          Type any handle, simulate viral subscriber spikes, and watch your follower count tick up live with real-time statistics!
        </p>
      </div>

      <!-- Handle Input & Controls Card -->
      <div class="p-6 bg-[#160a2b]/90 border-2 border-[#e1306c]/40 rounded-3xl shadow-2xl backdrop-blur-xl space-y-4">
        <form id="ig-form" class="flex flex-col sm:flex-row items-center gap-3">
          <div class="relative w-full">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-extrabold text-sm">@</span>
            <input 
              type="text" 
              id="ig-handle" 
              placeholder="ajaykmeena" 
              value="ajaykmeena"
              class="w-full pl-9 pr-4 py-3 bg-[#0d0714] border border-[#e1306c]/50 rounded-2xl text-sm font-bold text-white placeholder-gray-500 focus:outline-none focus:border-[#e1306c] shadow-inner"
            />
          </div>
          <button 
            type="submit" 
            class="w-full sm:w-auto px-8 py-3 bg-gradient-to-r from-[#f09433] via-[#dc2743] to-[#bc1888] hover:opacity-90 text-white font-black text-sm rounded-2xl transition-all shadow-xl hover:shadow-[0_0_25px_rgba(225,48,108,0.5)] shrink-0 cursor-pointer border-0 whitespace-nowrap"
          >
            TRACK LIVE ➔
          </button>
        </form>

        <!-- Speed Preset Pills -->
        <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-[#3b1d5c]/60 text-xs">
          <span class="text-gray-400 font-bold">Growth Mode:</span>
          <div class="flex items-center gap-2 flex-wrap">
            <button type="button" data-speed="organic" class="speed-btn px-3 py-1 bg-[#25103a] border border-[#e1306c]/40 text-purple-200 font-bold text-xs rounded-xl hover:bg-[#e1306c]/20 transition-all cursor-pointer">🌱 Normal</button>
            <button type="button" data-speed="viral" class="speed-btn active px-3 py-1 bg-[#e1306c] text-white font-extrabold text-xs rounded-xl shadow-lg cursor-pointer border-0">🔥 Viral Reel Mode</button>
            <button type="button" data-speed="ultra" class="speed-btn px-3 py-1 bg-gradient-to-r from-[#f09433] to-[#e0692a] text-white font-black text-xs rounded-xl hover:scale-105 transition-all cursor-pointer border-0">⚡ Ultra Beast Mode</button>
          </div>
        </div>
      </div>

      <!-- MAIN LIVE FOLLOWER DISPLAY COUNTER CARD -->
      <div class="p-8 sm:p-12 bg-gradient-to-b from-[#1c0d38] via-[#150a29] to-[#0f071e] border-2 border-[#e1306c]/60 rounded-3xl shadow-[0_0_50px_rgba(225,48,108,0.25)] text-center relative overflow-hidden">
        
        <!-- Live Indicator Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-red-600/20 border border-red-500/50 text-red-400 font-extrabold text-[11px] rounded-full uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
          LIVE INCREASING
        </div>

        <!-- Profile Avatar & Handle Header -->
        <div class="flex items-center justify-center gap-4 mb-6">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full p-1 bg-gradient-to-tr from-[#f09433] via-[#dc2743] to-[#bc1888] shadow-xl">
            <div class="w-full h-full rounded-full bg-[#160a2b] flex items-center justify-center text-2xl font-black text-white uppercase border-2 border-white/20" id="avatar-text">
              AK
            </div>
          </div>
          <div class="text-left">
            <div class="flex items-center gap-1.5">
              <h2 id="display-handle" class="text-xl sm:text-2xl font-black text-white m-0">@ajaykmeena</h2>
              <span class="text-sky-400 text-sm" title="Verified Creator">✓</span>
            </div>
            <span id="growth-status" class="text-xs font-bold text-emerald-400 flex items-center gap-1">
              <span class="animate-bounce">▲</span> +<span id="rate-display">14</span> followers / sec
            </span>
          </div>
        </div>

        <!-- BIG LIVE NUMBER COUNTER -->
        <div class="my-6">
          <div id="follower-count" class="text-5xl sm:text-7xl font-black font-mono tracking-tight text-white drop-shadow-[0_0_35px_rgba(255,255,255,0.4)] transition-all duration-300">
            104,280
          </div>
          <span class="text-xs font-bold text-purple-300 tracking-widest uppercase mt-2 block">TOTAL FOLLOWERS</span>
        </div>

        <!-- Quick Action Controller Bar -->
        <div class="flex flex-wrap items-center justify-center gap-3 pt-6 border-t border-[#3b1d5c]">
          <button id="btn-add-100" type="button" class="px-4 py-2 bg-[#25103a] hover:bg-[#3d1b6e] border border-[#c084fc]/50 text-white font-extrabold text-xs rounded-xl transition-all cursor-pointer active:scale-95">
            +100 Boost ⚡
          </button>
          <button id="btn-add-1000" type="button" class="px-4 py-2 bg-gradient-to-r from-[#e0692a] to-[#f59e0b] text-white font-extrabold text-xs rounded-xl hover:opacity-90 transition-all cursor-pointer shadow-md active:scale-95 border-0">
            +1,000 Spurt 🚀
          </button>
          <button id="btn-pause" type="button" class="px-4 py-2 bg-[#331742] hover:bg-[#4a2260] text-purple-200 font-bold text-xs rounded-xl transition-all cursor-pointer">
            ⏸️ Pause / Resume
          </button>
          <button id="btn-reset" type="button" class="px-4 py-2 bg-[#200c30] hover:bg-[#301348] text-gray-400 font-bold text-xs rounded-xl transition-all cursor-pointer">
            🔄 Reset
          </button>
        </div>

      </div>

      <!-- Live Analytics Stats Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
        <div class="p-4 bg-[#160a2b] border border-[#3b1d5c] rounded-2xl space-y-1">
          <span class="text-[11px] font-bold text-gray-400 uppercase">Gained Today</span>
          <div id="stat-today" class="text-xl font-black text-emerald-400 font-mono">+1,420</div>
        </div>
        <div class="p-4 bg-[#160a2b] border border-[#3b1d5c] rounded-2xl space-y-1">
          <span class="text-[11px] font-bold text-gray-400 uppercase">Growth Velocity</span>
          <div id="stat-speed" class="text-xl font-black text-amber-300 font-mono">⚡ High (Viral)</div>
        </div>
        <div class="p-4 bg-[#160a2b] border border-[#3b1d5c] rounded-2xl space-y-1">
          <span class="text-[11px] font-bold text-gray-400 uppercase">Next Milestone</span>
          <div id="stat-next" class="text-xl font-black text-[#c084fc] font-mono">110,000</div>
        </div>
      </div>

    </div>
  </div>

  <script is:inline>
    (function() {
      let count = 104280;
      let gainedToday = 1420;
      let isRunning = true;
      let currentMode = 'viral';
      let intervalId = null;

      const countEl = document.getElementById('follower-count');
      const handleInput = document.getElementById('ig-handle');
      const handleForm = document.getElementById('ig-form');
      const displayHandle = document.getElementById('display-handle');
      const avatarText = document.getElementById('avatar-text');
      const rateDisplay = document.getElementById('rate-display');
      const statToday = document.getElementById('stat-today');
      const statSpeed = document.getElementById('stat-speed');
      const statNext = document.getElementById('stat-next');
      const speedBtns = document.querySelectorAll('.speed-btn');
      const btnAdd100 = document.getElementById('btn-add-100');
      const btnAdd1000 = document.getElementById('btn-add-1000');
      const btnPause = document.getElementById('btn-pause');
      const btnReset = document.getElementById('btn-reset');

      function formatNumber(num) {
        return new Intl.NumberFormat('en-US').format(num);
      }

      function updateDisplay() {
        if (countEl) {
          countEl.textContent = formatNumber(count);
          countEl.classList.add('scale-105', 'text-[#f09433]');
          setTimeout(() => {
            countEl.classList.remove('scale-105', 'text-[#f09433]');
          }, 150);
        }
        if (statToday) statToday.textContent = '+' + formatNumber(gainedToday);
        
        let nextMilestone = Math.ceil((count + 1) / 10000) * 10000;
        if (statNext) statNext.textContent = formatNumber(nextMilestone);
      }

      function getTickDelayAndIncrement() {
        if (currentMode === 'organic') {
          return { delay: 1200, inc: Math.floor(Math.random() * 3) + 1 };
        } else if (currentMode === 'viral') {
          return { delay: 400, inc: Math.floor(Math.random() * 5) + 2 };
        } else if (currentMode === 'ultra') {
          return { delay: 180, inc: Math.floor(Math.random() * 12) + 5 };
        }
        return { delay: 500, inc: 2 };
      }

      function tick() {
        if (!isRunning) return;
        const { delay, inc } = getTickDelayAndIncrement();
        count += inc;
        gainedToday += inc;
        
        const perSec = Math.round((1000 / delay) * inc);
        if (rateDisplay) rateDisplay.textContent = perSec;

        updateDisplay();
      }

      function startTimer() {
        if (intervalId) clearInterval(intervalId);
        intervalId = setInterval(tick, 350);
      }

      if (handleForm) {
        handleForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const val = handleInput.value.trim().replace(/^@/, '');
          if (!val) return;
          displayHandle.textContent = '@' + val;
          avatarText.textContent = val.substring(0, 2).toUpperCase();
        });
      }

      speedBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          speedBtns.forEach(b => {
            b.classList.remove('active', 'bg-[#e1306c]', 'bg-gradient-to-r', 'from-[#f09433]', 'to-[#e0692a]', 'text-white');
            b.classList.add('bg-[#25103a]', 'text-purple-200');
          });
          btn.classList.remove('bg-[#25103a]', 'text-purple-200');
          btn.classList.add('active', 'bg-[#e1306c]', 'text-white');
          currentMode = btn.getAttribute('data-speed');

          if (statSpeed) {
            if (currentMode === 'organic') statSpeed.textContent = '🌱 Steady';
            else if (currentMode === 'viral') statSpeed.textContent = '🔥 High (Viral)';
            else if (currentMode === 'ultra') statSpeed.textContent = '⚡ Ultra Surge';
          }
        });
      });

      if (btnAdd100) {
        btnAdd100.addEventListener('click', () => {
          count += 100;
          gainedToday += 100;
          updateDisplay();
        });
      }

      if (btnAdd1000) {
        btnAdd1000.addEventListener('click', () => {
          count += 1000;
          gainedToday += 1000;
          updateDisplay();
        });
      }

      if (btnPause) {
        btnPause.addEventListener('click', () => {
          isRunning = !isRunning;
          btnPause.textContent = isRunning ? '⏸️ Pause' : '▶️ Resume';
        });
      }

      if (btnReset) {
        btnReset.addEventListener('click', () => {
          count = 104280;
          gainedToday = 1420;
          updateDisplay();
        });
      }

      updateDisplay();
      startTimer();
    })();
  </script>
</Layout>
