---
import Layout from '../layouts/Layout.astro';

const title = "100K Instagram Follower Live Counter & Celebration Blaster (2026) | Editors Gurukul";
const description = "Real-time 100K Instagram follower milestone simulator with epic live confetti blasters, fireworks, and live profile picture support.";
---

<Layout title={title} description={description} enableAds={false} darkTheme={true}>
  <!-- Canvas for Confetti & Fireworks Blast -->
  <canvas id="confetti-canvas" class="fixed inset-0 pointer-events-none z-[99999] w-full h-full"></canvas>

  <!-- Main Wrapper -->
  <div class="min-h-screen bg-[#0d0714] text-white relative overflow-hidden font-['Sora',sans-serif]">
    
    <!-- Instagram Ambient Gradient Orbs -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[450px] bg-gradient-to-tr from-[#f09433] via-[#e6683c] to-[#bc1888] opacity-25 blur-[160px] pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 py-10 relative z-10 space-y-6">
      
      <!-- Top Title Header -->
      <div class="text-center space-y-2">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-gradient-to-r from-[#f09433]/20 via-[#dc2743]/20 to-[#bc1888]/20 border border-[#e1306c]/40 text-purple-200 font-extrabold text-xs rounded-full uppercase tracking-wider shadow-lg">
          <span class="w-2.5 h-2.5 rounded-full bg-[#e1306c] animate-ping"></span>
          100,000 MILESTONE LIVE SIMULATOR
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
          ROAD TO <span class="bg-gradient-to-r from-amber-300 via-orange-400 to-[#e1306c] bg-clip-text text-transparent drop-shadow-[0_0_30px_rgba(245,158,11,0.6)]">100,000 FOLLOWERS</span> 🎉
        </h1>
        <p class="text-xs sm:text-sm text-[#e9d5ff] max-w-lg mx-auto">
          Watch followers climb live from 99.8K to 100,000 — epic confetti blasters &amp; celebration fireworks trigger the exact second you hit 100K!
        </p>
      </div>

      <!-- Handle Input & Controls Card -->
      <div class="p-6 bg-[#160a2b]/90 border-2 border-[#e1306c]/40 rounded-3xl shadow-2xl backdrop-blur-xl space-y-4">
        <form id="ig-form" class="flex flex-col sm:flex-row items-center gap-3">
          <div class="relative w-full">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-extrabold text-sm">@</span>
            <input 
              type="text" 
              id="ig-handle" 
              placeholder="iampoojariya" 
              value="iampoojariya"
              class="w-full pl-9 pr-4 py-3 bg-[#0d0714] border border-[#e1306c]/50 rounded-2xl text-sm font-bold text-white placeholder-gray-500 focus:outline-none focus:border-[#e1306c] shadow-inner"
            />
          </div>
          <button 
            type="submit" 
            class="w-full sm:w-auto px-8 py-3 bg-gradient-to-r from-[#f09433] via-[#dc2743] to-[#bc1888] hover:opacity-90 text-white font-black text-sm rounded-2xl transition-all shadow-xl hover:shadow-[0_0_25px_rgba(225,48,108,0.5)] shrink-0 cursor-pointer border-0 whitespace-nowrap"
          >
            LOAD PROFILE &amp; TRACK ➔
          </button>
        </form>

        <!-- Speed Preset Pills -->
        <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-[#3b1d5c]/60 text-xs">
          <span class="text-gray-400 font-bold">Growth Mode:</span>
          <div class="flex items-center gap-2 flex-wrap">
            <button type="button" data-speed="organic" class="speed-btn px-3 py-1 bg-[#25103a] border border-[#e1306c]/40 text-purple-200 font-bold text-xs rounded-xl hover:bg-[#e1306c]/20 transition-all cursor-pointer">🌱 Steady (+2/s)</button>
            <button type="button" data-speed="viral" class="speed-btn active px-3 py-1 bg-[#e1306c] text-white font-extrabold text-xs rounded-xl shadow-lg cursor-pointer border-0">🔥 Viral Reel (+12/s)</button>
            <button type="button" data-speed="ultra" class="speed-btn px-3 py-1 bg-gradient-to-r from-[#f09433] to-[#e0692a] text-white font-black text-xs rounded-xl hover:scale-105 transition-all cursor-pointer border-0">⚡ Beast Surge (+35/s)</button>
          </div>
        </div>
      </div>

      <!-- MAIN LIVE FOLLOWER DISPLAY COUNTER CARD -->
      <div id="main-counter-card" class="p-8 sm:p-12 bg-gradient-to-b from-[#1c0d38] via-[#150a29] to-[#0f071e] border-2 border-[#e1306c]/60 rounded-3xl shadow-[0_0_50px_rgba(225,48,108,0.25)] text-center relative overflow-hidden transition-all duration-500">
        
        <!-- Live Indicator Pill -->
        <div id="live-badge" class="inline-flex items-center gap-2 px-3.5 py-1 bg-red-600/20 border border-red-500/50 text-red-400 font-extrabold text-[11px] rounded-full uppercase tracking-wider mb-4 shadow-sm">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-ping"></span>
          LIVE 99K TO 100K COUNTDOWN
        </div>

        <!-- Profile Avatar & Handle Header -->
        <div class="flex items-center justify-center gap-4 mb-6">
          <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full p-1 bg-gradient-to-tr from-[#f09433] via-[#dc2743] to-[#bc1888] shadow-2xl relative shrink-0">
            <!-- Dynamic Avatar Image -->
            <img 
              id="avatar-img" 
              src="https://unavatar.io/instagram/iampoojariya" 
              alt="iampoojariya Instagram Profile Picture" 
              class="w-full h-full rounded-full object-cover border-2 border-white/20"
              onerror="this.style.display='none'; document.getElementById('avatar-text').style.display='flex';"
            />
            <!-- Fallback Initials Avatar -->
            <div class="w-full h-full rounded-full bg-[#160a2b] hidden items-center justify-center text-2xl font-black text-white uppercase border-2 border-white/20" id="avatar-text">
              IP
            </div>
          </div>
          <div class="text-left">
            <div class="flex items-center gap-1.5">
              <h2 id="display-handle" class="text-xl sm:text-2xl font-black text-white m-0">@iampoojariya</h2>
              <span class="text-sky-400 text-sm" title="Verified Creator">✓</span>
            </div>
            <span id="growth-status" class="text-xs font-bold text-emerald-400 flex items-center gap-1 mt-1">
              <span class="animate-bounce">▲</span> +<span id="rate-display">12</span> followers / sec
            </span>
          </div>
        </div>

        <!-- BIG LIVE NUMBER COUNTER -->
        <div class="my-6">
          <div id="follower-count" class="text-5xl sm:text-8xl font-black font-mono tracking-tight text-white drop-shadow-[0_0_40px_rgba(255,255,255,0.5)] transition-all duration-200">
            99,880
          </div>
          <span id="counter-sublabel" class="text-xs font-bold text-purple-300 tracking-widest uppercase mt-2 block">
            🎯 TARGET: 100,000 FOLLOWERS
          </span>
        </div>

        <!-- 100K CELEBRATION POPUP BANNER (HIDDEN UNTIL 100K) -->
        <div id="celebration-banner" class="hidden my-4 p-6 bg-gradient-to-r from-amber-500/20 via-orange-500/20 to-purple-500/20 border-2 border-amber-400 rounded-2xl shadow-2xl text-center space-y-2 animate-bounce">
          <div class="text-3xl sm:text-4xl font-black text-amber-300 drop-shadow-md">
            🎉 CONGRATULATIONS @<span id="celeb-handle">iampoojariya</span>! 100K HIT! 🏆
          </div>
          <p class="text-xs sm:text-sm text-white font-extrabold m-0">
            Official 100,000 Creator Milestone Reached! Fireworks &amp; Blasters Active! 💥
          </p>
        </div>

        <!-- Quick Action Controller Bar -->
        <div class="flex flex-wrap items-center justify-center gap-3 pt-6 border-t border-[#3b1d5c]">
          <button id="btn-jump-99990" type="button" class="px-4 py-2.5 bg-gradient-to-r from-amber-500 to-orange-500 text-white font-extrabold text-xs rounded-xl hover:scale-105 transition-all cursor-pointer shadow-lg border-0 active:scale-95">
            ⚡ Jump to 99,980 (Climax!)
          </button>
          <button id="btn-blast-now" type="button" class="px-4 py-2.5 bg-[#e1306c] hover:bg-[#c12459] text-white font-extrabold text-xs rounded-xl transition-all cursor-pointer shadow-lg border-0 active:scale-95">
            💥 Trigger 100K Blast Now!
          </button>
          <button id="btn-pause" type="button" class="px-4 py-2.5 bg-[#331742] hover:bg-[#4a2260] text-purple-200 font-bold text-xs rounded-xl transition-all cursor-pointer border-0">
            ⏸️ Pause / Resume
          </button>
          <button id="btn-reset" type="button" class="px-4 py-2.5 bg-[#200c30] hover:bg-[#301348] text-gray-400 font-bold text-xs rounded-xl transition-all cursor-pointer border-0">
            🔄 Reset to 99,850
          </button>
        </div>

      </div>

      <!-- Live Analytics Stats Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
        <div class="p-4 bg-[#160a2b] border border-[#3b1d5c] rounded-2xl space-y-1">
          <span class="text-[11px] font-bold text-gray-400 uppercase">Distance to 100K</span>
          <div id="stat-needed" class="text-xl font-black text-amber-300 font-mono">120 Left</div>
        </div>
        <div class="p-4 bg-[#160a2b] border border-[#3b1d5c] rounded-2xl space-y-1">
          <span class="text-[11px] font-bold text-gray-400 uppercase">Growth Velocity</span>
          <div id="stat-speed" class="text-xl font-black text-emerald-400 font-mono">🔥 Fast (Viral)</div>
        </div>
        <div class="p-4 bg-[#160a2b] border border-[#3b1d5c] rounded-2xl space-y-1">
          <span class="text-[11px] font-bold text-gray-400 uppercase">Status</span>
          <div id="stat-status" class="text-xl font-black text-[#c084fc] font-mono">⚡ 99K ➔ 100K</div>
        </div>
      </div>

    </div>
  </div>

  <script is:inline>
    (function() {
      let count = 99880;
      let target = 100000;
      let isRunning = true;
      let currentMode = 'viral';
      let intervalId = null;
      let hasBlasted = false;

      const countEl = document.getElementById('follower-count');
      const handleInput = document.getElementById('ig-handle');
      const handleForm = document.getElementById('ig-form');
      const displayHandle = document.getElementById('display-handle');
      const celebHandle = document.getElementById('celeb-handle');
      const avatarImg = document.getElementById('avatar-img');
      const avatarText = document.getElementById('avatar-text');
      const rateDisplay = document.getElementById('rate-display');
      const statNeeded = document.getElementById('stat-needed');
      const statSpeed = document.getElementById('stat-speed');
      const statStatus = document.getElementById('stat-status');
      const speedBtns = document.querySelectorAll('.speed-btn');
      const btnJump = document.getElementById('btn-jump-99990');
      const btnBlast = document.getElementById('btn-blast-now');
      const btnPause = document.getElementById('btn-pause');
      const btnReset = document.getElementById('btn-reset');
      const celebBanner = document.getElementById('celebration-banner');
      const liveBadge = document.getElementById('live-badge');
      const counterSublabel = document.getElementById('counter-sublabel');

      // CONFETTI BLASTER SYSTEM
      const canvas = document.getElementById('confetti-canvas');
      const ctx = canvas.getContext('2d');
      let particles = [];

      function resizeCanvas() {
        if (canvas) {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
        }
      }
      window.addEventListener('resize', resizeCanvas);
      resizeCanvas();

      function createConfettiBlast() {
        const colors = ['#f09433', '#e6683c', '#dc2743', '#cc2366', '#bc1888', '#fbbf24', '#38bdf8', '#ffffff'];
        for (let i = 0; i < 250; i++) {
          particles.push({
            x: canvas.width / 2,
            y: canvas.height / 2 + 100,
            vx: (Math.random() - 0.5) * 28,
            vy: (Math.random() - 0.8) * 28,
            size: Math.random() * 10 + 6,
            color: colors[Math.floor(Math.random() * colors.length)],
            rotation: Math.random() * 360,
            rSpeed: (Math.random() - 0.5) * 12,
            opacity: 1,
            gravity: 0.35
          });
        }
      }

      function updateAndDrawConfetti() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (let i = 0; i < particles.length; i++) {
          let p = particles[i];
          p.x += p.vx;
          p.y += p.vy;
          p.vy += p.gravity;
          p.rotation += p.rSpeed;
          p.opacity -= 0.005;

          ctx.save();
          ctx.globalAlpha = Math.max(0, p.opacity);
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rotation * Math.PI) / 180);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
          ctx.restore();
        }
        particles = particles.filter(p => p.opacity > 0);
        requestAnimationFrame(updateAndDrawConfetti);
      }
      requestAnimationFrame(updateAndDrawConfetti);

      function trigger100KBlast() {
        if (hasBlasted) return;
        hasBlasted = true;

        // Fire multiple confetti waves
        createConfettiBlast();
        setTimeout(createConfettiBlast, 400);
        setTimeout(createConfettiBlast, 800);
        setTimeout(createConfettiBlast, 1400);

        if (celebBanner) celebBanner.classList.remove('hidden');
        if (counterSublabel) {
          counterSublabel.textContent = "🏆 100,000 OFFICIAL MILESTONE REACHED!";
          counterSublabel.classList.remove('text-purple-300');
          counterSublabel.classList.add('text-amber-300', 'font-black', 'text-sm');
        }
        if (liveBadge) {
          liveBadge.className = "inline-flex items-center gap-2 px-4 py-1.5 bg-amber-500/20 border border-amber-400 text-amber-300 font-black text-xs rounded-full uppercase tracking-wider mb-4 shadow-xl animate-pulse";
          liveBadge.innerHTML = "🏆 100K VERIFIED MILESTONE!";
        }
        if (countEl) {
          countEl.className = "text-6xl sm:text-9xl font-black font-mono tracking-tight text-amber-300 drop-shadow-[0_0_50px_rgba(251,191,36,0.9)] animate-pulse";
        }
        if (statStatus) statStatus.textContent = '👑 100K CREATOR!';
        if (statNeeded) statNeeded.textContent = '0 Left 🎉';
      }

      function formatNumber(num) {
        return new Intl.NumberFormat('en-US').format(num);
      }

      function updateDisplay() {
        if (countEl) {
          countEl.textContent = formatNumber(count);
        }

        let needed = Math.max(0, target - count);
        if (statNeeded) {
          statNeeded.textContent = needed === 0 ? '0 Left 🎉' : formatNumber(needed) + ' Left';
        }

        if (count >= target && !hasBlasted) {
          trigger100KBlast();
        }
      }

      function loadProfile(username) {
        const clean = username.trim().replace(/^@/, '');
        if (!clean) return;
        if (displayHandle) displayHandle.textContent = '@' + clean;
        if (celebHandle) celebHandle.textContent = clean;
        if (avatarText) avatarText.textContent = clean.substring(0, 2).toUpperCase();

        if (avatarImg) {
          avatarImg.style.display = 'block';
          if (avatarText) avatarText.style.display = 'none';
          avatarImg.src = 'https://unavatar.io/instagram/' + clean;
        }
      }

      function getTickIncrement() {
        if (currentMode === 'organic') return Math.floor(Math.random() * 2) + 1;
        if (currentMode === 'viral') return Math.floor(Math.random() * 4) + 2;
        if (currentMode === 'ultra') return Math.floor(Math.random() * 10) + 5;
        return 2;
      }

      function tick() {
        if (!isRunning) return;
        
        if (count < target) {
          const inc = getTickIncrement();
          count = Math.min(target, count + inc);
          updateDisplay();
        } else if (!hasBlasted) {
          trigger100KBlast();
        }
      }

      function startTimer() {
        if (intervalId) clearInterval(intervalId);
        intervalId = setInterval(tick, 300);
      }

      if (handleForm) {
        handleForm.addEventListener('submit', (e) => {
          e.preventDefault();
          loadProfile(handleInput.value);
        });
      }

      speedBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          speedBtns.forEach(b => {
            b.classList.remove('active', 'bg-[#e1306c]', 'bg-gradient-to-r', 'from-[#f09433]', 'to-[#e0692a]', 'text-white');
            b.classList.add('bg-[#25103a]', 'text-purple-200');
          });
          btn.classList.remove('bg-[#25103a]', 'text-purple-200');
          btn.classList.add('active', 'bg-[#e1306c]', 'text-white');
          currentMode = btn.getAttribute('data-speed');

          if (statSpeed) {
            if (currentMode === 'organic') statSpeed.textContent = '🌱 Steady (+2/s)';
            else if (currentMode === 'viral') statSpeed.textContent = '🔥 Fast (+12/s)';
            else if (currentMode === 'ultra') statSpeed.textContent = '⚡ Beast (+35/s)';
          }
        });
      });

      if (btnJump) {
        btnJump.addEventListener('click', () => {
          count = 99980;
          hasBlasted = false;
          if (celebBanner) celebBanner.classList.add('hidden');
          updateDisplay();
        });
      }

      if (btnBlast) {
        btnBlast.addEventListener('click', () => {
          count = 100000;
          updateDisplay();
          trigger100KBlast();
        });
      }

      if (btnPause) {
        btnPause.addEventListener('click', () => {
          isRunning = !isRunning;
          btnPause.textContent = isRunning ? '⏸️ Pause' : '▶️ Resume';
        });
      }

      if (btnReset) {
        btnReset.addEventListener('click', () => {
          count = 99850;
          hasBlasted = false;
          if (celebBanner) celebBanner.classList.add('hidden');
          if (counterSublabel) {
            counterSublabel.textContent = "🎯 TARGET: 100,000 FOLLOWERS";
            counterSublabel.className = "text-xs font-bold text-purple-300 tracking-widest uppercase mt-2 block";
          }
          if (liveBadge) {
            liveBadge.className = "inline-flex items-center gap-2 px-3.5 py-1 bg-red-600/20 border border-red-500/50 text-red-400 font-extrabold text-[11px] rounded-full uppercase tracking-wider mb-4 shadow-sm";
            liveBadge.innerHTML = '<span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-ping"></span> LIVE 99K TO 100K COUNTDOWN';
          }
          if (countEl) {
            countEl.className = "text-5xl sm:text-8xl font-black font-mono tracking-tight text-white drop-shadow-[0_0_40px_rgba(255,255,255,0.5)] transition-all duration-200";
          }
          if (statStatus) statStatus.textContent = '⚡ 99K ➔ 100K';
          updateDisplay();
        });
      }

      loadProfile('iampoojariya');
      updateDisplay();
      startTimer();
    })();
  </script>
</Layout>
