---
import Layout from '../layouts/Layout.astro';

const title = "Live Instagram Follower Count Tracker | Editors Gurukul";
const description = "Real-time live Instagram follower count tracker with instant statistics and milestone updates.";
---

<Layout title={title} description={description} enableAds={false} darkTheme={true}>
  <!-- Canvas for Confetti & Fireworks Blast -->
  <canvas id="confetti-canvas" class="fixed inset-0 pointer-events-none z-[99999] w-full h-full"></canvas>

  <!-- Main Wrapper -->
  <div class="min-h-screen bg-[#0d0714] text-white relative overflow-hidden font-['Sora',sans-serif]">
    
    <!-- Instagram Ambient Gradient Orbs -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[450px] bg-gradient-to-tr from-[#f09433] via-[#e6683c] to-[#bc1888] opacity-25 blur-[160px] pointer-events-none"></div>

    <div class="max-w-3xl mx-auto px-4 py-10 relative z-10 space-y-6">
      
      <!-- Top Title Header -->
      <div class="text-center space-y-2">
        <div class="inline-flex items-center gap-2 px-4 py-1 bg-[#1a0a2e] border border-[#e1306c]/40 text-purple-200 font-bold text-xs rounded-full uppercase tracking-wider shadow-md">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
          INSTAGRAM REAL-TIME LIVE TRACKER
        </div>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
          LIVE INSTAGRAM <span class="bg-gradient-to-r from-[#f09433] via-[#dc2743] to-[#bc1888] bg-clip-text text-transparent">FOLLOWER COUNT</span>
        </h1>
      </div>

      <!-- Handle Search Input Card (Clean & Official) -->
      <div class="p-4 bg-[#160a2b]/90 border border-[#3b1d5c] rounded-2xl shadow-xl backdrop-blur-xl">
        <form id="ig-form" class="flex items-center gap-3">
          <div class="relative w-full">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-bold text-sm">@</span>
            <input 
              type="text" 
              id="ig-handle" 
              placeholder="iampoojariya" 
              value="iampoojariya"
              class="w-full pl-9 pr-4 py-2.5 bg-[#0d0714] border border-[#4c247d] rounded-xl text-xs font-semibold text-white placeholder-gray-500 focus:outline-none focus:border-[#e1306c]"
            />
          </div>
          <button 
            type="submit" 
            class="px-6 py-2.5 bg-gradient-to-r from-[#f09433] via-[#dc2743] to-[#bc1888] hover:opacity-90 text-white font-bold text-xs rounded-xl transition-all shadow-md shrink-0 cursor-pointer border-0 whitespace-nowrap"
          >
            TRACK LIVE
          </button>
        </form>
      </div>

      <!-- MAIN LIVE FOLLOWER DISPLAY COUNTER CARD (100% AUTHENTIC LOOK) -->
      <div id="main-counter-card" class="p-8 sm:p-12 bg-gradient-to-b from-[#1a0c33] via-[#140826] to-[#0d0619] border-2 border-[#e1306c]/50 rounded-3xl shadow-[0_0_50px_rgba(225,48,108,0.2)] text-center relative overflow-hidden transition-all duration-500">
        
        <!-- Live Status Pill -->
        <div id="live-badge" class="inline-flex items-center gap-2 px-3.5 py-1 bg-red-600/20 border border-red-500/40 text-red-400 font-bold text-[11px] rounded-full uppercase tracking-wider mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
          REAL-TIME COUNTER
        </div>

        <!-- Profile Avatar & Handle Header -->
        <div class="flex items-center justify-center gap-4 mb-6">
          <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full p-1.5 bg-gradient-to-tr from-[#f09433] via-[#dc2743] to-[#bc1888] shadow-2xl relative shrink-0">
            <!-- Profile Image -->
            <img 
              id="avatar-img" 
              src="/assets/iampoojariya_dp.jpg" 
              alt="iampoojariya Instagram Profile Picture" 
              class="w-full h-full rounded-full object-cover border-2 border-white/30"
              onerror="this.src='https://unavatar.io/instagram/iampoojariya';"
            />
            <!-- Fallback Initials Avatar -->
            <div class="w-full h-full rounded-full bg-[#160a2b] hidden items-center justify-center text-2xl font-black text-white uppercase border-2 border-white/20" id="avatar-text">
              IP
            </div>
          </div>
          <div class="text-left">
            <div class="flex items-center gap-1.5">
              <h2 id="display-handle" class="text-xl sm:text-2xl font-black text-white m-0">@iampoojariya</h2>
              <svg class="w-5 h-5 text-sky-400 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            </div>
            <span id="growth-status" class="text-xs font-semibold text-emerald-400 flex items-center gap-1 mt-1">
              <span class="animate-bounce">▲</span> <span id="rate-display">Gaining Followers</span>
            </span>
          </div>
        </div>

        <!-- BIG LIVE NUMBER COUNTER -->
        <div class="my-6">
          <div id="follower-count" class="text-6xl sm:text-8xl font-black font-mono tracking-tight text-white drop-shadow-[0_0_40px_rgba(255,255,255,0.4)] transition-all duration-300">
            99,920
          </div>
          <span id="counter-sublabel" class="text-xs font-bold text-gray-400 tracking-widest uppercase mt-2 block">
            TOTAL FOLLOWERS
          </span>
        </div>

        <!-- 100K CELEBRATION POPUP BANNER (HIDDEN UNTIL 100K) -->
        <div id="celebration-banner" class="hidden my-4 p-6 bg-gradient-to-r from-amber-500/20 via-orange-500/20 to-purple-500/20 border-2 border-amber-400 rounded-2xl shadow-2xl text-center space-y-2 animate-bounce">
          <div class="text-3xl sm:text-4xl font-black text-amber-300 drop-shadow-md">
            🎉 100,000 MILESTONE REACHED! 🏆
          </div>
          <p class="text-xs sm:text-sm text-white font-extrabold m-0">
            Congratulations @<span id="celeb-handle">iampoojariya</span> on hitting 100K followers! 💥
          </p>
        </div>

        <!-- Official Profile Stats Bar (Real Look) -->
        <div class="grid grid-cols-3 gap-2 pt-6 border-t border-[#3b1d5c] text-center text-xs">
          <div>
            <span class="text-gray-400 font-bold block text-[10px] uppercase">Posts</span>
            <span class="text-white font-extrabold text-sm">248</span>
          </div>
          <div>
            <span class="text-gray-400 font-bold block text-[10px] uppercase">Followers</span>
            <span id="stat-followers-mini" class="text-white font-extrabold text-sm">99.9K</span>
          </div>
          <div>
            <span class="text-gray-400 font-bold block text-[10px] uppercase">Following</span>
            <span class="text-white font-extrabold text-sm">412</span>
          </div>
        </div>

      </div>

      <!-- Live Analytics Overview Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
        <div class="p-4 bg-[#160a2b] border border-[#3b1d5c] rounded-2xl space-y-1">
          <span class="text-[10px] font-bold text-gray-400 uppercase">Followers Gained Today</span>
          <div id="stat-today" class="text-lg font-bold text-emerald-400 font-mono">+1,420</div>
        </div>
        <div class="p-4 bg-[#160a2b] border border-[#3b1d5c] rounded-2xl space-y-1">
          <span class="text-[10px] font-bold text-gray-400 uppercase">Growth Rate</span>
          <div id="stat-rate" class="text-lg font-bold text-amber-300 font-mono">High</div>
        </div>
        <div class="p-4 bg-[#160a2b] border border-[#3b1d5c] rounded-2xl space-y-1">
          <span class="text-[10px] font-bold text-gray-400 uppercase">Distance to 100K</span>
          <div id="stat-needed" class="text-lg font-bold text-[#c084fc] font-mono">80 Left</div>
        </div>
      </div>

    </div>
  </div>

  <script is:inline>
    (function() {
      let count = 99920;
      let target = 100000;
      let gainedToday = 1420;
      let isRunning = true;
      let timeoutId = null;
      let hasBlasted = false;

      const countEl = document.getElementById('follower-count');
      const miniFollowersEl = document.getElementById('stat-followers-mini');
      const handleInput = document.getElementById('ig-handle');
      const handleForm = document.getElementById('ig-form');
      const displayHandle = document.getElementById('display-handle');
      const celebHandle = document.getElementById('celeb-handle');
      const avatarImg = document.getElementById('avatar-img');
      const avatarText = document.getElementById('avatar-text');
      const rateDisplay = document.getElementById('rate-display');
      const statNeeded = document.getElementById('stat-needed');
      const statToday = document.getElementById('stat-today');
      const celebBanner = document.getElementById('celebration-banner');
      const liveBadge = document.getElementById('live-badge');
      const counterSublabel = document.getElementById('counter-sublabel');

      // CONFETTI BLASTER SYSTEM
      const canvas = document.getElementById('confetti-canvas');
      const ctx = canvas.getContext('2d');
      let particles = [];

      function resizeCanvas() {
        if (canvas) {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
        }
      }
      window.addEventListener('resize', resizeCanvas);
      resizeCanvas();

      function createConfettiBlast() {
        const colors = ['#f09433', '#e6683c', '#dc2743', '#cc2366', '#bc1888', '#fbbf24', '#38bdf8', '#ffffff'];
        for (let i = 0; i < 300; i++) {
          particles.push({
            x: canvas.width / 2,
            y: canvas.height / 2 + 100,
            vx: (Math.random() - 0.5) * 32,
            vy: (Math.random() - 0.85) * 32,
            size: Math.random() * 12 + 6,
            color: colors[Math.floor(Math.random() * colors.length)],
            rotation: Math.random() * 360,
            rSpeed: (Math.random() - 0.5) * 14,
            opacity: 1,
            gravity: 0.35
          });
        }
      }

      function updateAndDrawConfetti() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (let i = 0; i < particles.length; i++) {
          let p = particles[i];
          p.x += p.vx;
          p.y += p.vy;
          p.vy += p.gravity;
          p.rotation += p.rSpeed;
          p.opacity -= 0.005;

          ctx.save();
          ctx.globalAlpha = Math.max(0, p.opacity);
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rotation * Math.PI) / 180);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
          ctx.restore();
        }
        particles = particles.filter(p => p.opacity > 0);
        requestAnimationFrame(updateAndDrawConfetti);
      }
      requestAnimationFrame(updateAndDrawConfetti);

      function trigger100KBlast() {
        if (hasBlasted) return;
        hasBlasted = true;

        createConfettiBlast();
        setTimeout(createConfettiBlast, 400);
        setTimeout(createConfettiBlast, 900);
        setTimeout(createConfettiBlast, 1500);

        if (celebBanner) celebBanner.classList.remove('hidden');
        if (counterSublabel) {
          counterSublabel.textContent = "🏆 100,000 OFFICIAL MILESTONE REACHED!";
          counterSublabel.className = "text-[#fbbf24] font-black text-sm tracking-widest uppercase mt-2 block animate-pulse";
        }
        if (liveBadge) {
          liveBadge.className = "inline-flex items-center gap-2 px-4 py-1.5 bg-amber-500/20 border border-amber-400 text-amber-300 font-black text-xs rounded-full uppercase tracking-wider mb-6 shadow-xl animate-pulse";
          liveBadge.innerHTML = "🏆 100K VERIFIED MILESTONE!";
        }
        if (countEl) {
          countEl.className = "text-6xl sm:text-9xl font-black font-mono tracking-tight text-amber-300 drop-shadow-[0_0_60px_rgba(251,191,36,0.95)] animate-pulse";
        }
        if (statNeeded) statNeeded.textContent = '0 Left 🎉';
      }

      function formatNumber(num) {
        return new Intl.NumberFormat('en-US').format(num);
      }

      function updateDisplay() {
        if (countEl) {
          countEl.textContent = formatNumber(count);
        }
        if (miniFollowersEl) {
          miniFollowersEl.textContent = (count / 1000).toFixed(1) + 'K';
        }
        if (statToday) {
          statToday.textContent = '+' + formatNumber(gainedToday);
        }

        let needed = Math.max(0, target - count);
        if (statNeeded) {
          statNeeded.textContent = needed === 0 ? '0 Left 🎉' : formatNumber(needed) + ' Left';
        }

        // DRAMATIC SUSPENSE STYLING (LAST 50 FOLLOWERS)
        if (count >= 99950 && count < 100000) {
          if (rateDisplay) rateDisplay.textContent = '1 follower / 1.5s (Climax)';
          if (countEl && !hasBlasted) {
            countEl.className = "text-6xl sm:text-8xl font-black font-mono tracking-tight text-amber-300 drop-shadow-[0_0_40px_rgba(251,191,36,0.6)] transition-all duration-300 scale-105";
          }
        }

        if (count >= target && !hasBlasted) {
          trigger100KBlast();
        }
      }

      function loadProfile(username) {
        const clean = username.trim().replace(/^@/, '');
        if (!clean) return;
        if (displayHandle) displayHandle.textContent = '@' + clean;
        if (celebHandle) celebHandle.textContent = clean;
        if (avatarText) avatarText.textContent = clean.substring(0, 2).toUpperCase();

        if (avatarImg) {
          avatarImg.style.display = 'block';
          if (avatarText) avatarText.style.display = 'none';
          if (clean.toLowerCase() === 'iampoojariya') {
            avatarImg.src = '/assets/iampoojariya_dp.jpg';
          } else {
            avatarImg.src = 'https://unavatar.io/instagram/' + clean;
          }
        }
      }

      function scheduleNextTick() {
        if (timeoutId) clearTimeout(timeoutId);

        if (!isRunning) {
          timeoutId = setTimeout(scheduleNextTick, 500);
          return;
        }

        let delay = 350;
        let inc = 1;

        if (count < 99950) {
          // Normal approach (from 99,920 to 99,950)
          delay = 350;
          inc = Math.floor(Math.random() * 3) + 2;
        } else if (count >= 99950 && count < 99990) {
          // Suspense Phase (99,950 to 99,990): 1 follower every 1.2 seconds
          delay = 1200;
          inc = 1;
        } else if (count >= 99990 && count < 100000) {
          // Climax Final 10 (99,990 to 100,000): 1 follower every 1.6 seconds
          delay = 1600;
          inc = 1;
        }

        if (count < target) {
          count = Math.min(target, count + inc);
          gainedToday += inc;
          updateDisplay();
          timeoutId = setTimeout(scheduleNextTick, delay);
        } else if (!hasBlasted) {
          trigger100KBlast();
        }
      }

      // HIDDEN KEYBOARD CONTROLS (For Screen Recording / Control without showing any buttons on screen!)
      window.addEventListener('keydown', (e) => {
        const key = e.key.toLowerCase();
        if (key === ' ') {
          isRunning = !isRunning;
        } else if (key === 'j') {
          count = 99950;
          hasBlasted = false;
          if (celebBanner) celebBanner.classList.add('hidden');
          updateDisplay();
        } else if (key === 'k') {
          count = 99995;
          hasBlasted = false;
          if (celebBanner) celebBanner.classList.add('hidden');
          updateDisplay();
        } else if (key === 'b') {
          count = 100000;
          updateDisplay();
          trigger100KBlast();
        } else if (key === 'r') {
          count = 99920;
          gainedToday = 1420;
          hasBlasted = false;
          if (celebBanner) celebBanner.classList.add('hidden');
          if (counterSublabel) {
            counterSublabel.textContent = "TOTAL FOLLOWERS";
            counterSublabel.className = "text-xs font-bold text-gray-400 tracking-widest uppercase mt-2 block";
          }
          if (liveBadge) {
            liveBadge.className = "inline-flex items-center gap-2 px-3.5 py-1 bg-red-600/20 border border-red-500/40 text-red-400 font-bold text-[11px] rounded-full uppercase tracking-wider mb-6 shadow-sm";
            liveBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span> REAL-TIME COUNTER';
          }
          if (countEl) {
            countEl.className = "text-6xl sm:text-8xl font-black font-mono tracking-tight text-white drop-shadow-[0_0_40px_rgba(255,255,255,0.4)] transition-all duration-300";
          }
          updateDisplay();
          scheduleNextTick();
        }
      });

      if (handleForm) {
        handleForm.addEventListener('submit', (e) => {
          e.preventDefault();
          loadProfile(handleInput.value);
        });
      }

      loadProfile('iampoojariya');
      updateDisplay();
      scheduleNextTick();
    })();
  </script>
</Layout>
