---
import Layout from '../layouts/Layout.astro';

export const title = "Payment Successful — Instant Download | Editors Gurukul";
export const description = "Thank you for your purchase! Here is your instant Google Drive download link.";
---
<Layout title={title} description={description}>

  <main class="max-w-3xl mx-auto px-6 py-16 text-center">

    <!-- Success Icon -->
    <div class="w-20 h-20 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-6 text-4xl shadow-lg border-2 border-emerald-500">
      ✓
    </div>

    <span class="px-4 py-1.5 bg-emerald-100 text-emerald-800 text-xs font-mono font-bold uppercase tracking-wider rounded-full border border-emerald-300">
      PAYMENT CONFIRMED
    </span>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-[#15181c] mt-4 mb-3">
      Thank You For Your Purchase! 🎉
    </h1>
    <p class="text-base text-[#4b5058] max-w-lg mx-auto mb-8 leading-relaxed">
      Your payment was completed successfully via Razorpay UPI. You have full lifetime access to your digital files below.
    </p>

    <!-- Download Card Box -->
    <div id="download-card" class="bg-white border-2 border-[#0a5f61] p-8 rounded-3xl shadow-2xl max-w-xl mx-auto mb-10">
      <h2 id="product-title" class="text-2xl font-bold text-[#15181c] mb-2">Digital Asset Package</h2>
      <p class="text-xs font-mono text-[#0a5f61] font-bold mb-6" id="tx-id">Transaction ID: Confirmed</p>

      <!-- Instant High-Speed Download Link -->
      <a 
        id="drive-download-btn"
        href="https://drive.google.com" 
        target="_blank" 
        rel="noopener"
        class="w-full py-4 bg-[#0a5f61] text-white font-extrabold text-lg rounded-2xl hover:bg-[#074749] transition-all shadow-xl flex items-center justify-center gap-3 no-underline transform active:scale-95 mb-4"
      >
        <span>📥 INSTANT GOOGLE DRIVE DOWNLOAD</span>
      </a>

      <p class="text-xs text-gray-500 m-0">✓ Direct High-Speed Download · No Password Required</p>
    </div>

    <!-- WhatsApp VIP Support Box -->
    <div class="bg-[#faf9f6] border border-[#e7e4dc] p-6 rounded-2xl max-w-xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-left">
        <div class="font-extrabold text-[#15181c] text-sm">Need help or missing files?</div>
        <div class="text-xs text-gray-500">Contact Ajay K Meena on WhatsApp VIP Support</div>
      </div>
      <a 
        href="https://wa.me/919999999999?text=Hi%20Ajay,%20I%20just%20completed%20a%20digital%20purchase!" 
        target="_blank" 
        rel="noopener"
        class="px-5 py-2.5 bg-emerald-600 text-white font-bold text-xs rounded-xl hover:bg-emerald-700 transition-colors no-underline whitespace-nowrap shadow-md"
      >
        💬 WhatsApp VIP Support
      </a>
    </div>

  </main>

  <script is:inline>
    (function() {
      var urlParams = new URLSearchParams(window.location.search);
      var tx = urlParams.get('tx');
      var product = urlParams.get('product');

      if (tx) {
        document.getElementById('tx-id').innerText = 'Razorpay Tx ID: ' + tx;
      }
      if (product) {
        document.getElementById('product-title').innerText = product.replace(/-/g, ' ').toUpperCase();
      }
    })();
  </script>

</Layout>
