---
import Layout from '../layouts/Layout.astro';
import { trendingRepos, repoCategories, repoTimeframes, repoUseCases } from '../data/trending-repos';

const title = "Trending GitHub Repos & Open-Source Creator Tools (2026) | Editors Gurukul";
const description = "Explore top open-source GitHub repositories for Video Editing, AI Video Generation, Audio Stem Separation, VFX, and Creator Utilities with live Star counts.";
---

<Layout title={title} description={description} enableAds={false} darkTheme={true}>
  <!-- Deep Blue-Purple Cyber Background Wrapper -->
  <div class="min-h-screen bg-[#0d0714] text-white relative overflow-hidden font-['Sora',sans-serif]">
    
    <!-- Animated Glowing Background Orbs -->
    <div id="orb-1" class="absolute top-0 left-1/2 -translate-x-1/2 w-[1100px] h-[500px] bg-gradient-to-tr from-[#7c3aed]/30 via-[#a855f7]/30 to-[#3b82f6]/20 blur-[150px] pointer-events-none transition-transform duration-1000 ease-out"></div>
    <div id="orb-2" class="absolute top-[600px] right-0 w-[700px] h-[700px] bg-[#8b5cf6]/20 blur-[170px] pointer-events-none transition-transform duration-1000 ease-out"></div>

    <!-- Header Section -->
    <div class="relative z-10 pt-14 pb-10 px-4 border-b border-[#3b1d5c] bg-gradient-to-b from-[#160b2d] to-[#0d0714]">
      <div class="max-w-6xl mx-auto text-center">
        
        <!-- Header Pill Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#2a134a] border border-[#c084fc]/50 text-[#f3e8ff] font-extrabold text-xs rounded-full uppercase tracking-wider mb-5 shadow-[0_0_20px_rgba(168,85,247,0.4)] hover:scale-105 transition-transform cursor-default">
          <span class="w-2.5 h-2.5 rounded-full bg-[#c084fc] animate-ping"></span>
          EDITORS GURUKUL · 2026 CURATED OPEN-SOURCE DIRECTORY
        </div>
        
        <!-- Main Title -->
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4 text-white leading-tight">
          <span class="text-white drop-shadow-md">TRENDING GITHUB REPOS FOR</span> <br class="hidden sm:inline"/>
          <span class="bg-gradient-to-r from-[#f3e8ff] via-[#c084fc] to-[#38bdf8] bg-clip-text text-transparent drop-shadow-[0_0_30px_rgba(192,132,252,0.6)]">
            CREATORS, EDITORS &amp; AI ARTISTS
          </span>
        </h1>
        
        <p class="text-xs sm:text-sm text-[#e9d5ff] font-medium max-w-2xl mx-auto mb-6 leading-relaxed">
          Hand-picked open-source AI video tools, video editors, audio stem splitters, and media utilities on GitHub.
        </p>

      </div>
    </div>

    <!-- Main Content Section - FULL WIDE CONTAINER (max-w-6xl) -->
    <section class="max-w-6xl mx-auto px-4 py-10 relative z-10">
      
      <!-- SINGLE HORIZONTAL FILTER ROW -->
      <div class="mb-10 flex flex-wrap items-center justify-between gap-3 p-3 bg-[#160a2b]/90 border border-[#3b1d5c] rounded-2xl backdrop-blur-xl shadow-xl hover:border-[#c084fc]/40 transition-colors">
        
        <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
          
          <!-- Dropdown 1: Timeframe Filter -->
          <div class="relative">
            <select id="timeframe-select" class="appearance-none bg-[#0f071f] border-2 border-[#4c247d] text-white font-extrabold text-xs px-4 py-2.5 pr-8 rounded-xl focus:outline-none focus:border-[#c084fc] shadow-md cursor-pointer hover:bg-[#1a0c36] transition-all">
              <option value="month" selected>📅 This Month</option>
              <option value="today">🔥 Today</option>
              <option value="week">⚡ This Week</option>
              <option value="quarter">📆 Past 3 Months</option>
              <option value="alltime">👑 All-Time Top</option>
            </select>
            <svg class="w-3.5 h-3.5 text-[#c084fc] absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
          </div>

          <!-- Dropdown 2: Category Filter -->
          <div class="relative">
            <select id="category-select" class="appearance-none bg-[#0f071f] border-2 border-[#4c247d] text-[#e9d5ff] font-bold text-xs px-4 py-2.5 pr-8 rounded-xl focus:outline-none focus:border-[#c084fc] shadow-md cursor-pointer hover:bg-[#1a0c36] transition-all">
              {repoCategories.map(cat => (
                <option value={cat.id}>{cat.label}</option>
              ))}
            </select>
            <svg class="w-3.5 h-3.5 text-[#c084fc] absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
          </div>

          <!-- Dropdown 3: Problem Solved / Use Case Filter -->
          <div class="relative">
            <select id="usecase-select" class="appearance-none bg-[#0f071f] border-2 border-[#4c247d] text-[#e9d5ff] font-bold text-xs px-4 py-2.5 pr-8 rounded-xl focus:outline-none focus:border-[#c084fc] shadow-md cursor-pointer hover:bg-[#1a0c36] transition-all">
              {repoUseCases.map(uc => (
                <option value={uc.id}>{uc.label}</option>
              ))}
            </select>
            <svg class="w-3.5 h-3.5 text-[#c084fc] absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
          </div>

        </div>

        <!-- Right Side: Search Input Bar -->
        <div class="relative w-full sm:w-64">
          <input 
            type="text" 
            id="repo-search-input" 
            placeholder="Search repositories..." 
            class="w-full pl-9 pr-3 py-2 bg-[#0f071f] border border-[#4c247d] rounded-xl text-xs font-semibold text-white placeholder-[#d8b4fe]/60 focus:outline-none focus:border-[#c084fc] shadow-md transition-all"
          />
          <svg class="w-3.5 h-3.5 text-[#c084fc] absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>

      </div>

      <!-- Repository Cards Grid -->
      <div id="repos-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {trendingRepos.map((repo) => (
          <article 
            data-category={repo.category}
            data-skill={repo.skillLevel}
            data-timeframe={repo.timeframe}
            data-usecase={repo.useCase}
            data-keywords={`${repo.name} ${repo.repoOwner} ${repo.language} ${repo.categoryLabel} ${repo.alternativeTo} ${repo.description} ${repo.summaryHindi}`.toLowerCase()}
            class="repo-card scroll-reveal p-6 bg-[#1f113a] border-2 border-[#3b1d5c] rounded-3xl shadow-2xl hover:border-[#c084fc] hover:shadow-[0_0_35px_rgba(192,132,252,0.35)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group opacity-0 translate-y-8"
          >
            <div>
              <!-- Top Badges Row -->
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#321754] text-amber-300 border border-amber-400/60 font-extrabold text-xs rounded-full shadow-md group-hover:scale-105 transition-transform">
                  <svg class="w-3.5 h-3.5 fill-amber-400" viewBox="0 0 24 24"><path d="M12 .587l3.668 7.431 8.2 1.192-5.934 5.784 1.399 8.165L12 18.896l-7.333 3.863 1.399-8.165-5.934-5.784 8.2-1.192z"/></svg>
                  {repo.stars} stars
                </span>

                <div class="flex items-center gap-1.5 flex-wrap">
                  {repo.trendingBadge && (
                    <span class="px-2.5 py-0.5 bg-[#361858] border border-purple-400/50 text-[#f3e8ff] font-extrabold text-[11px] rounded-full">
                      {repo.trendingBadge}
                    </span>
                  )}
                  <span class="px-2.5 py-0.5 bg-[#172554] text-cyan-300 font-mono font-bold text-[11px] rounded-md border border-cyan-400/50">
                    {repo.language}
                  </span>
                </div>
              </div>

              <!-- Free Alternative To Badge -->
              <div class="mb-3">
                <span class="inline-block px-3 py-1 bg-[#1e1b4b] border border-indigo-400/60 text-[#a5b4fc] font-extrabold text-[11px] rounded-lg shadow-sm">
                  ✨ {repo.alternativeTo}
                </span>
              </div>

              <!-- Repo Title -->
              <h3 class="text-xl font-extrabold text-white mb-1 flex items-center gap-2">
                <a href={`/trending-github-repos/${repo.id}`} class="text-white group-hover:text-[#c084fc] transition-colors no-underline group-hover:translate-x-1 duration-200 inline-block">
                  {repo.name}
                </a>
                <span class="text-xs font-mono text-[#c084fc] font-bold">({repo.repoOwner})</span>
              </h3>

              <!-- Problem Solved Badge -->
              <div class="mb-3">
                <span class="px-2.5 py-0.5 bg-[#14233c] text-[#38bdf8] font-bold text-[11px] rounded-md border border-[#38bdf8]/40">
                  {repo.useCaseLabel}
                </span>
              </div>

              <!-- English Overview -->
              <p class="text-xs text-[#f3e8ff] font-normal mb-4 leading-relaxed line-clamp-2">
                {repo.description}
              </p>

              <!-- Hinglish Practical Explanation Box -->
              <div class="p-4 bg-[#140a28] border border-[#4c247d] rounded-2xl mb-4 text-xs text-white font-medium leading-relaxed shadow-inner">
                <strong class="text-[#c084fc] block mb-1 font-extrabold">💡 Practical Use Case:</strong>
                <span class="text-white">{repo.summaryHindi}</span>
              </div>

              <!-- Tailored Inline Product Cross-Sell Pill -->
              {repo.recommendedProduct && (
                <a 
                  href={repo.recommendedProduct.url} 
                  class="flex items-center justify-between p-3 bg-[#170a2c] border border-[#c084fc]/40 hover:border-[#c084fc] hover:bg-[#25103d] rounded-xl text-xs text-[#f3e8ff] font-bold transition-all no-underline mb-4 group/prod shadow-md hover:scale-[1.02]"
                >
                  <span class="truncate mr-2 group-hover/prod:text-white">{repo.recommendedProduct.badge}</span>
                  <span class="px-2.5 py-1 bg-gradient-to-r from-[#e0692a] to-[#f59e0b] text-white text-[10px] font-extrabold rounded-lg shrink-0 whitespace-nowrap shadow-sm group-hover/prod:scale-105 transition-transform">
                    {repo.recommendedProduct.price} ➔
                  </span>
                </a>
              )}
            </div>

            <!-- SINGLE PROMINENT INTERNAL CTA BUTTON (Forces user to visit Detail Page!) -->
            <div class="pt-4 border-t border-[#3b1d5c]">
              <a 
                href={`/trending-github-repos/${repo.id}`} 
                class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 bg-gradient-to-r from-[#8b5cf6] to-[#a855f7] hover:from-[#7c3aed] hover:to-[#9333ea] text-white font-extrabold text-xs sm:text-sm rounded-xl transition-all shadow-lg hover:shadow-[0_0_25px_rgba(192,132,252,0.5)] no-underline active:scale-95 text-center"
              >
                📖 View Full Setup Guide &amp; Commands ➔
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Empty State -->
      <div id="no-results-msg" class="hidden text-center py-20 bg-[#1c0f35] border border-[#4c247d] rounded-3xl mt-6">
        <div class="text-5xl mb-4 animate-bounce">🔍</div>
        <h3 class="text-xl font-bold text-white mb-2">No repositories found</h3>
        <p class="text-xs text-[#e9d5ff]">Try adjusting your filters or search query.</p>
      </div>

    </section>
  </div>

  <script is:inline>
    (function() {
      const searchInput = document.getElementById('repo-search-input');
      const timeframeSelect = document.getElementById('timeframe-select');
      const categorySelect = document.getElementById('category-select');
      const usecaseSelect = document.getElementById('usecase-select');
      const cards = document.querySelectorAll('.repo-card');
      const noResultsMsg = document.getElementById('no-results-msg');
      const orb1 = document.getElementById('orb-1');
      const orb2 = document.getElementById('orb-2');

      let currentTimeframe = 'month';
      let currentCategory = 'all-cat';
      let currentUseCase = 'all-use';
      let currentQuery = '';

      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const scrollObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.remove('opacity-0', 'translate-y-8');
            entry.target.classList.add('opacity-100', 'translate-y-0');
            scrollObserver.unobserve(entry.target);
          }
        });
      }, observerOptions);

      cards.forEach(card => scrollObserver.observe(card));

      window.addEventListener('scroll', () => {
        const scrolled = window.scrollY;
        if (orb1) orb1.style.transform = `translate(-50%, ${scrolled * 0.15}px)`;
        if (orb2) orb2.style.transform = `translateY(-${scrolled * 0.1}px)`;
      });

      function filterCards() {
        let visibleCount = 0;

        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          const cardSkill = card.getAttribute('data-skill');
          const cardTf = card.getAttribute('data-timeframe');
          const cardUc = card.getAttribute('data-usecase');
          const keywords = card.getAttribute('data-keywords') || '';

          let matchesTf = (currentTimeframe === 'alltime' || cardTf === currentTimeframe);
          let matchesUc = (currentUseCase === 'all-use' || cardUc === currentUseCase);
          let matchesCat = false;
          if (currentCategory === 'all-cat') {
            matchesCat = true;
          } else if (currentCategory === 'skill-gui' && cardSkill === 'gui') {
            matchesCat = true;
          } else if (currentCategory === 'skill-cli' && cardSkill === 'cli') {
            matchesCat = true;
          } else if (cardCat === currentCategory) {
            matchesCat = true;
          }

          const matchesQuery = (!currentQuery || keywords.includes(currentQuery));

          if (matchesTf && matchesUc && matchesCat && matchesQuery) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (visibleCount === 0) {
          noResultsMsg.classList.remove('hidden');
        } else {
          noResultsMsg.classList.add('hidden');
        }
      }

      if (timeframeSelect) timeframeSelect.addEventListener('change', (e) => { currentTimeframe = e.target.value; filterCards(); });
      if (categorySelect) categorySelect.addEventListener('change', (e) => { currentCategory = e.target.value; filterCards(); });
      if (usecaseSelect) usecaseSelect.addEventListener('change', (e) => { currentUseCase = e.target.value; filterCards(); });
      if (searchInput) searchInput.addEventListener('input', (e) => { currentQuery = e.target.value.toLowerCase().trim(); filterCards(); });

      filterCards();
    })();
  </script>
</Layout>
