---
import Layout from '../../layouts/Layout.astro';
import { trendingRepos, type GitHubRepo } from '../../data/trending-repos';

export async function getStaticPaths() {
  return trendingRepos.map((repo) => ({
    params: { id: repo.id },
    props: { repo },
  }));
}

interface Props {
  repo: GitHubRepo;
}

const { repo } = Astro.props;

// Targeted High-Volume Google Search Intent SEO Metadata
const title = `${repo.name} Guide: ${repo.alternativeTo} (2026 Free Open Source)`;
const description = `Looking for a ${repo.alternativeTo}? Learn how to install & use ${repo.name} (${repo.stars} GitHub stars) 100% free with step-by-step commands and creator breakdown.`;

// Get related repos in same category
const relatedRepos = trendingRepos.filter(r => r.id !== repo.id && (r.category === repo.category || r.useCase === repo.useCase)).slice(0, 3);

// Structured Data JSON-LD Schema (SoftwareApplication, FAQPage & BreadcrumbList)
const jsonLdSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": repo.name,
      "operatingSystem": "Windows, macOS, Linux",
      "applicationCategory": "MultimediaApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "ratingCount": "1250"
      },
      "author": {
        "@type": "Organization",
        "name": repo.repoOwner
      },
      "downloadUrl": repo.githubUrl,
      "description": repo.description
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://editorsgurukul.com/" },
        { "@type": "ListItem", "position": 2, "name": "Trending GitHub Repos", "item": "https://editorsgurukul.com/trending-github-repos" },
        { "@type": "ListItem", "position": 3, "name": repo.name, "item": `https://editorsgurukul.com/trending-github-repos/${repo.id}` }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": `Is ${repo.name} a good ${repo.alternativeTo}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Yes, ${repo.name} is one of the highest-rated open-source alternatives with ${repo.stars} stars on GitHub. It delivers pro-level features completely free without monthly fees.`
          }
        },
        {
          "@type": "Question",
          "name": `How to install ${repo.name} on Windows and Mac?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `For Windows, open Command Prompt and run Winget or Pip command. For Mac, open Terminal and use Homebrew or Git clone.`
          }
        },
        {
          "@type": "Question",
          "name": `Is ${repo.name} completely free and open-source?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Yes, ${repo.name} is 100% free and open-source software hosted on GitHub. You can run it locally without any subscription fees.`
          }
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} enableAds={false} darkTheme={true}>
  
  <!-- Structured Data JSON-LD Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />

  <div class="min-h-screen bg-[#0d0714] text-white relative overflow-hidden font-['Sora',sans-serif]">
    
    <!-- Toast Notification Popup for 1-Click Copy -->
    <div id="copy-toast" class="fixed bottom-6 right-6 z-50 bg-[#7c3aed] text-white px-5 py-3 rounded-2xl shadow-2xl font-bold text-xs flex items-center gap-2 transition-all duration-300 opacity-0 translate-y-10 pointer-events-none border border-[#c084fc]">
      <span>📋 Command copied to clipboard!</span>
    </div>

    <!-- Background Ambient Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1100px] h-[500px] bg-gradient-to-tr from-[#7c3aed]/30 via-[#a855f7]/20 to-[#38bdf8]/10 blur-[160px] pointer-events-none"></div>

    <!-- Main Container - FULL WIDE CONTAINER (max-w-6xl) -->
    <div class="max-w-6xl mx-auto px-4 py-8 relative z-10 space-y-8">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-purple-300">
        <a href="/" class="hover:text-white transition-colors no-underline">Home</a>
        <span>/</span>
        <a href="/trending-github-repos" class="hover:text-white transition-colors no-underline">GitHub Repos Directory</a>
        <span>/</span>
        <span class="text-white font-extrabold">{repo.name}</span>
      </nav>

      <!-- Full-Width Hero Header Section -->
      <header class="bg-[#190d33] border-2 border-[#4c247d] p-6 sm:p-8 rounded-3xl shadow-2xl space-y-4">
        
        <!-- SEO Target Search Intent Badge -->
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1 bg-gradient-to-r from-[#e0692a] to-[#f59e0b] text-white font-extrabold text-xs rounded-full shadow-md">
            🔥 {repo.alternativeTo}
          </span>

          <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#321754] text-amber-300 border border-amber-400/60 font-extrabold text-xs rounded-full shadow-sm">
            <svg class="w-3.5 h-3.5 fill-amber-400" viewBox="0 0 24 24"><path d="M12 .587l3.668 7.431 8.2 1.192-5.934 5.784 1.399 8.165L12 18.896l-7.333 3.863 1.399-8.165-5.934-5.784 8.2-1.192z"/></svg>
            {repo.stars} GitHub Stars
          </span>

          <span class="px-3 py-1 bg-[#2b1747] text-[#e9d5ff] border border-[#5b21b6]/60 font-bold text-xs rounded-lg">
            {repo.skillLevelLabel}
          </span>

          <span class="px-3 py-1 bg-[#172554] text-cyan-300 font-mono font-bold text-xs rounded-md border border-cyan-400/50">
            {repo.language}
          </span>
        </div>

        <!-- Repo Title -->
        <h1 class="text-2xl sm:text-4xl font-extrabold text-white leading-tight flex flex-wrap items-baseline gap-3 m-0">
          {repo.name}
          <span class="text-sm sm:text-lg font-mono text-[#c084fc] font-semibold">by {repo.repoOwner}</span>
        </h1>

        <!-- English Overview -->
        <p class="text-xs sm:text-sm text-[#f3e8ff] leading-relaxed font-normal m-0">
          If you are searching on Google for a <strong>{repo.alternativeTo}</strong>, <strong>{repo.name}</strong> is the #1 open-source tool recommended by creators and DOPs. {repo.description}
        </p>

        <!-- Quick Jump Anchor Bar -->
        <div class="flex flex-wrap items-center gap-2 pt-3 border-t border-[#3b1d5c] text-xs font-bold">
          <span class="text-purple-300 mr-1">Quick Jump:</span>
          <a href="#install-commands" class="px-3 py-1 bg-[#2a134a] hover:bg-[#3d1b6e] text-cyan-300 rounded-lg no-underline transition-colors">⚡ Commands</a>
          <a href="#beginner-guide" class="px-3 py-1 bg-[#2a134a] hover:bg-[#3d1b6e] text-emerald-300 rounded-lg no-underline transition-colors">💻 How to Install (Win &amp; Mac)</a>
          <a href="#seo-breakdown" class="px-3 py-1 bg-[#2a134a] hover:bg-[#3d1b6e] text-[#c084fc] rounded-lg no-underline transition-colors">💡 Why {repo.name}?</a>
          <a href="#comparison" class="px-3 py-1 bg-[#2a134a] hover:bg-[#3d1b6e] text-amber-300 rounded-lg no-underline transition-colors">📊 Comparison Table</a>
          <a href="#faqs" class="px-3 py-1 bg-[#2a134a] hover:bg-[#3d1b6e] text-purple-200 rounded-lg no-underline transition-colors">❓ FAQs</a>
        </div>
      </header>

      <!-- FULL-WIDTH 1-CLICK SETUP COMMAND BANNER -->
      <section id="install-commands" class="bg-[#180d30] border-2 border-[#8b5cf6]/60 p-6 sm:p-8 rounded-3xl shadow-2xl space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[#3b1d5c] pb-3">
          <h2 class="text-lg sm:text-xl font-extrabold text-white m-0 border-none">
            ⚡ 1-Click Setup Commands for {repo.name}
          </h2>
          <span class="text-xs text-purple-300">Copy &amp; paste in Terminal or Command Prompt:</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          {repo.installCommand && (
            <div class="p-4 bg-[#0c051a] border border-[#4c247d] rounded-2xl flex flex-col justify-between gap-3">
              <div>
                <span class="block text-[11px] font-bold text-cyan-300 uppercase tracking-wider mb-1">Python / Pip / Git Command:</span>
                <code class="font-mono text-xs text-cyan-300 block break-all">{repo.installCommand}</code>
              </div>
              <button 
                onclick={`copyCommand('${repo.installCommand}')`}
                class="w-full py-2 bg-[#8b5cf6] hover:bg-[#7c3aed] text-white font-sans font-extrabold text-xs rounded-xl transition-all cursor-pointer shadow-md"
              >
                📋 Copy Command
              </button>
            </div>
          )}

          {repo.brewCommand && (
            <div class="p-4 bg-[#0c051a] border border-[#4c247d] rounded-2xl flex flex-col justify-between gap-3">
              <div>
                <span class="block text-[11px] font-bold text-purple-300 uppercase tracking-wider mb-1">macOS Homebrew:</span>
                <code class="font-mono text-xs text-purple-300 block break-all">{repo.brewCommand}</code>
              </div>
              <button 
                onclick={`copyCommand('${repo.brewCommand}')`}
                class="w-full py-2 bg-[#8b5cf6] hover:bg-[#7c3aed] text-white font-sans font-extrabold text-xs rounded-xl transition-all cursor-pointer shadow-md"
              >
                📋 Copy Command
              </button>
            </div>
          )}

          {repo.wingetCommand && (
            <div class="p-4 bg-[#0c051a] border border-[#4c247d] rounded-2xl flex flex-col justify-between gap-3">
              <div>
                <span class="block text-[11px] font-bold text-amber-300 uppercase tracking-wider mb-1">Windows Winget:</span>
                <code class="font-mono text-xs text-amber-300 block break-all">{repo.wingetCommand}</code>
              </div>
              <button 
                onclick={`copyCommand('${repo.wingetCommand}')`}
                class="w-full py-2 bg-[#8b5cf6] hover:bg-[#7c3aed] text-white font-sans font-extrabold text-xs rounded-xl transition-all cursor-pointer shadow-md"
              >
                📋 Copy Command
              </button>
            </div>
          )}

          <!-- Store Cross-Sell Box -->
          <div class="p-4 bg-gradient-to-br from-[#2a134d] to-[#160a2b] border border-[#c084fc]/50 rounded-2xl flex flex-col justify-between gap-3">
            <div>
              <span class="px-2.5 py-0.5 bg-[#e0692a] text-white font-extrabold text-[10px] rounded-full uppercase">₹49 READY APPS</span>
              <p class="text-xs text-white font-bold mt-1">Want pre-compiled 1-click ready installers?</p>
            </div>
            <a href="/digital-store" class="w-full py-2 bg-gradient-to-r from-[#e0692a] to-[#f59e0b] text-white font-extrabold text-xs text-center rounded-xl no-underline hover:opacity-90 shadow-md">
              🛒 Visit Digital Store ➔
            </a>
          </div>
        </div>
      </section>

      <!-- BEGINNER-FRIENDLY OS-SPECIFIC INSTALLATION GUIDE (NEW CARD FOR BEGINNERS) -->
      <section id="beginner-guide" class="bg-[#180d30] border-2 border-[#10b981]/50 p-6 sm:p-8 rounded-3xl shadow-xl space-y-5">
        <div class="flex items-center gap-3 border-b border-[#3b1d5c] pb-3">
          <span class="text-2xl">📖</span>
          <div>
            <h2 class="text-lg sm:text-xl font-extrabold text-emerald-300 m-0 border-none">
              Beginner Installation Guide (Windows &amp; Mac)
            </h2>
            <p class="text-xs text-purple-200 m-0">Naye creators ke liye bilkul simple step-by-step tareeka:</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm text-white">
          
          <!-- Windows Installation Card -->
          <div class="p-5 bg-[#0e1f20]/90 border border-emerald-500/40 rounded-2xl space-y-3">
            <h3 class="text-base font-extrabold text-emerald-300 flex items-center gap-2 m-0 border-none">
              💻 Windows Install Steps:
            </h3>
            <ol class="space-y-2 pl-4 m-0 text-[#e9d5ff]">
              <li><strong>Step 1:</strong> Press <code>Win + R</code> keys together, type <code>cmd</code> and hit Enter to open Command Prompt.</li>
              <li><strong>Step 2:</strong> Copy the <code>{repo.wingetCommand || repo.installCommand}</code> command from the top banner.</li>
              <li><strong>Step 3:</strong> Right-click in Command Prompt to paste the command and press Enter. Installation complete!</li>
            </ol>
          </div>

          <!-- macOS Installation Card -->
          <div class="p-5 bg-[#1e0f35]/90 border border-purple-400/40 rounded-2xl space-y-3">
            <h3 class="text-base font-extrabold text-purple-300 flex items-center gap-2 m-0 border-none">
              🍏 Mac Install Steps (Apple Silicon &amp; Intel):
            </h3>
            <ol class="space-y-2 pl-4 m-0 text-[#e9d5ff]">
              <li><strong>Step 1:</strong> Press <code>Cmd + Space</code>, type <code>Terminal</code> and hit Enter.</li>
              <li><strong>Step 2:</strong> Copy the <code>{repo.brewCommand || repo.installCommand}</code> command from the top banner.</li>
              <li><strong>Step 3:</strong> Paste into Terminal and press Enter. If Mac blocks opening: Go to <em>System Settings &gt; Privacy &amp; Security &gt; Click "Open Anyway"</em>.</li>
            </ol>
          </div>

        </div>
      </section>

      <!-- Practical & In-Depth Creator Analysis -->
      <section id="seo-breakdown" class="bg-[#180d30] border border-[#4c247d] p-6 sm:p-8 rounded-3xl shadow-xl space-y-4">
        <h2 class="text-lg sm:text-xl font-extrabold text-[#c084fc] border-none p-0 m-0">
          💡 Why {repo.name} is the Best {repo.alternativeTo}
        </h2>
        <div class="text-xs sm:text-sm text-white font-medium leading-relaxed space-y-3">
          <p class="m-0">
            {repo.summaryHindi}
          </p>
          <p class="text-[#e9d5ff] m-0">
            If you are tired of expensive monthly subscription fees and privacy concerns, <strong>{repo.name}</strong> offers a completely free, open-source alternative. Running 100% locally on your computer (Windows, Mac, or Linux), it delivers high performance without export limits or cloud dependencies.
          </p>
        </div>
      </section>

      <!-- SEO COMPARISON TABLE -->
      <section id="comparison" class="bg-[#180d30] border border-[#4c247d] p-6 sm:p-8 rounded-3xl shadow-xl space-y-4">
        <h2 class="text-lg sm:text-xl font-extrabold text-white border-none p-0 m-0">
          📊 Comparison: {repo.name} vs {repo.alternativeTo}
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm border-collapse">
            <thead>
              <tr class="border-b border-[#3b1d5c] text-purple-300 font-extrabold">
                <th class="py-3 px-4">Feature / Metric</th>
                <th class="py-3 px-4 text-[#c084fc]">{repo.name} (Free Open-Source)</th>
                <th class="py-3 px-4 text-amber-300">{repo.alternativeTo} (Paid)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#3b1d5c]/60 text-white">
              <tr>
                <td class="py-3 px-4 font-bold">Pricing Model</td>
                <td class="py-3 px-4 text-emerald-400 font-bold">100% Free Forever (₹0)</td>
                <td class="py-3 px-4 text-red-300">Paid Monthly Subscription</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-bold">Data Privacy &amp; Security</td>
                <td class="py-3 px-4 text-emerald-400">100% Offline Local Computer</td>
                <td class="py-3 px-4 text-amber-200">Cloud Server Upload Required</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-bold">System Control</td>
                <td class="py-3 px-4 text-emerald-400">Full Source Code &amp; Custom Scripts</td>
                <td class="py-3 px-4 text-amber-200">Restricted Closed Code</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-bold">Community Extensions</td>
                <td class="py-3 px-4 text-emerald-400">Unlimited GitHub Plugins</td>
                <td class="py-3 px-4 text-amber-200">Limited Official Marketplace</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Key Features List -->
      <section class="bg-[#180d30] border border-[#4c247d] p-6 sm:p-8 rounded-3xl shadow-xl">
        <h2 class="text-lg sm:text-xl font-extrabold text-white mb-4 border-none p-0 m-0">
          🚀 Key Features &amp; Technical Capabilities
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {repo.features.map(feat => (
            <div class="flex items-start gap-3 p-3.5 bg-[#120726] border border-[#3b1d5c] rounded-2xl text-xs sm:text-sm text-[#f3e8ff]">
              <span class="text-[#c084fc] font-bold text-base shrink-0">✓</span>
              <span>{feat}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- System Requirements Card -->
      <section class="bg-[#180d30] border border-[#4c247d] p-6 sm:p-8 rounded-3xl shadow-xl">
        <h2 class="text-lg sm:text-xl font-extrabold text-[#38bdf8] mb-3 border-none p-0 m-0 flex items-center gap-2">
          ⚙️ Hardware &amp; System Requirements
        </h2>
        <p class="text-xs sm:text-sm text-white font-medium leading-relaxed m-0">
          {repo.requirements}
        </p>
      </section>

      <!-- Frequently Asked Questions (FAQ Section for SEO) -->
      <section id="faqs" class="bg-[#180d30] border border-[#4c247d] p-6 sm:p-8 rounded-3xl shadow-xl space-y-4">
        <h2 class="text-lg sm:text-xl font-extrabold text-white border-none p-0 m-0">
          ❓ Frequently Asked Questions (FAQs)
        </h2>
        <div class="space-y-4">
          <div class="p-4 bg-[#120726] border border-[#3b1d5c] rounded-2xl">
            <h3 class="text-sm font-extrabold text-[#c084fc] mb-1.5 border-none p-0 m-0">
              Is {repo.name} a good {repo.alternativeTo}?
            </h3>
            <p class="text-xs sm:text-sm text-[#e9d5ff] leading-relaxed m-0">
              Yes, {repo.name} is one of the highest-rated open-source alternatives with {repo.stars} stars on GitHub. It delivers pro-level performance without monthly subscription fees.
            </p>
          </div>

          <div class="p-4 bg-[#120726] border border-[#3b1d5c] rounded-2xl">
            <h3 class="text-sm font-extrabold text-[#c084fc] mb-1.5 border-none p-0 m-0">
              Is {repo.name} completely free to use?
            </h3>
            <p class="text-xs sm:text-sm text-[#e9d5ff] leading-relaxed m-0">
              Yes, {repo.name} is 100% free and open-source under open license terms. You can download, modify, and run it locally on your computer without subscription fees.
            </p>
          </div>

          <div class="p-4 bg-[#120726] border border-[#3b1d5c] rounded-2xl">
            <h3 class="text-sm font-extrabold text-[#c084fc] mb-1.5 border-none p-0 m-0">
              Can I use {repo.name} for commercial projects?
            </h3>
            <p class="text-xs sm:text-sm text-[#e9d5ff] leading-relaxed m-0">
              Yes! Most open-source GitHub repositories allow commercial creation, YouTube monetization, and client work. Check the official GitHub license for specific terms.
            </p>
          </div>
        </div>
      </section>

      <!-- EXTERNAL REPOSITORY LINKS BOX (PLACED AT THE VERY BOTTOM OF THE PAGE FOR MAXIMUM USER RETENTION) -->
      <section class="bg-gradient-to-r from-[#200e3f] via-[#180d30] to-[#120726] border-2 border-[#8b5cf6] p-6 sm:p-8 rounded-3xl shadow-2xl text-center space-y-4">
        <h2 class="text-lg sm:text-xl font-extrabold text-white m-0 border-none">
          🔗 Source Code &amp; Official Links
        </h2>
        <p class="text-xs sm:text-sm text-[#e9d5ff] max-w-xl mx-auto m-0">
          Finished reading the guide? You can inspect the source code or star the repository directly on GitHub below:
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
          <a 
            href={repo.githubUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-8 py-3.5 bg-gradient-to-r from-[#8b5cf6] to-[#a855f7] hover:from-[#7c3aed] hover:to-[#9333ea] text-white font-extrabold text-sm rounded-xl transition-all shadow-lg hover:shadow-[0_0_25px_rgba(192,132,252,0.5)] no-underline flex items-center gap-2"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            Visit Official GitHub Repository ↗
          </a>

          {repo.websiteUrl && (
            <a 
              href={repo.websiteUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-8 py-3.5 bg-[#2e1552] border border-[#c084fc]/50 text-[#f3e8ff] font-extrabold text-sm rounded-xl hover:bg-[#3d1b6e] transition-colors no-underline"
            >
              Visit Official Website 🌐
            </a>
          )}
        </div>
      </section>

      <!-- Related Open-Source Tools Section -->
      {relatedRepos.length > 0 && (
        <section class="pt-6 border-t border-[#3b1d5c]">
          <h2 class="text-xl sm:text-2xl font-extrabold text-white mb-6 border-none p-0 m-0">
            🔥 Related Open-Source Tools
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedRepos.map(rel => (
              <a href={`/trending-github-repos/${rel.id}`} class="p-5 bg-[#180d30] border border-[#4c247d] rounded-2xl hover:border-[#c084fc] transition-all no-underline block group">
                <span class="text-xs text-amber-300 font-extrabold block mb-1">★ {rel.stars} stars</span>
                <h3 class="text-base font-extrabold text-white group-hover:text-[#c084fc] transition-colors m-0 mb-2">{rel.name}</h3>
                <p class="text-xs text-[#f3e8ff] line-clamp-2 m-0 mb-3">{rel.description}</p>
                <span class="text-xs text-[#c084fc] font-bold">View Guide ➔</span>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </div>

  <script is:inline>
    function copyCommand(text) {
      navigator.clipboard.writeText(text).then(() => {
        const toast = document.getElementById('copy-toast');
        if (toast) {
          toast.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
          toast.classList.add('opacity-100', 'translate-y-0');
          setTimeout(() => {
            toast.classList.remove('opacity-100', 'translate-y-0');
            toast.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
          }, 2500);
        }
      });
    }
  </script>
</Layout>
