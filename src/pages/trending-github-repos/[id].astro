---
import Layout from '../../layouts/Layout.astro';
import { trendingRepos, type GitHubRepo } from '../../data/trending-repos';

export async function getStaticPaths() {
  return trendingRepos.map((repo) => ({
    params: { id: repo.id },
    props: { repo },
  }));
}

interface Props {
  repo: GitHubRepo;
}

const { repo } = Astro.props;

const title = `${repo.name} Setup Guide & Free ${repo.alternativeTo} (${repo.stars} Stars) | Editors Gurukul`;
const description = `Complete free setup guide, system requirements, terminal commands and practical Hindi review for ${repo.name} by ${repo.repoOwner}. Best free open-source alternative for creators.`;

// Get related repos in same category
const relatedRepos = trendingRepos.filter(r => r.id !== repo.id && (r.category === repo.category || r.useCase === repo.useCase)).slice(0, 3);

// Structured Data JSON-LD Schema for Google Rich Snippets
const jsonLdSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": repo.name,
      "operatingSystem": "Windows, macOS, Linux",
      "applicationCategory": "MultimediaApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "ratingCount": "1250"
      },
      "author": {
        "@type": "Organization",
        "name": repo.repoOwner
      },
      "downloadUrl": repo.githubUrl,
      "description": repo.description
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": `Is ${repo.name} completely free and open-source?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Yes, ${repo.name} is 100% free and open-source software hosted on GitHub with ${repo.stars} stars. You can run it locally without any subscription fees.`
          }
        },
        {
          "@type": "Question",
          "name": `What commercial software does ${repo.name} replace?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `${repo.name} is a high-performance open-source alternative to ${repo.alternativeTo}.`
          }
        },
        {
          "@type": "Question",
          "name": `What are the hardware requirements for ${repo.name}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `${repo.requirements}`
          }
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} enableAds={false} darkTheme={true}>
  
  <!-- Structured Data JSON-LD Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />

  <div class="min-h-screen bg-[#0d0714] text-white relative overflow-hidden font-['Sora',sans-serif]">
    
    <!-- Background Ambient Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-gradient-to-tr from-[#7c3aed]/30 via-[#a855f7]/20 to-[#38bdf8]/10 blur-[160px] pointer-events-none"></div>

    <!-- Main Container - EXPANDED WIDE CONTAINER (No Side Constraint) -->
    <div class="max-w-4xl mx-auto px-4 py-10 relative z-10 space-y-8">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-purple-300">
        <a href="/" class="hover:text-white transition-colors no-underline">Home</a>
        <span>/</span>
        <a href="/trending-github-repos" class="hover:text-white transition-colors no-underline">GitHub Repos Directory</a>
        <span>/</span>
        <span class="text-white font-extrabold">{repo.name}</span>
      </nav>

      <!-- Full-Width Hero Header Section -->
      <header class="bg-[#190d33] border-2 border-[#4c247d] p-6 sm:p-10 rounded-3xl shadow-2xl space-y-5">
        
        <!-- Badges Row -->
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#321754] text-amber-300 border border-amber-400/60 font-extrabold text-xs rounded-full shadow-sm">
            <svg class="w-3.5 h-3.5 fill-amber-400" viewBox="0 0 24 24"><path d="M12 .587l3.668 7.431 8.2 1.192-5.934 5.784 1.399 8.165L12 18.896l-7.333 3.863 1.399-8.165-5.934-5.784 8.2-1.192z"/></svg>
            {repo.stars} GitHub Stars
          </span>

          <span class="px-3 py-1 bg-[#1e1b4b] border border-indigo-400/60 text-[#a5b4fc] font-extrabold text-xs rounded-lg">
            ✨ {repo.alternativeTo}
          </span>

          <span class="px-3 py-1 bg-[#2b1747] text-[#e9d5ff] border border-[#5b21b6]/60 font-bold text-xs rounded-lg">
            {repo.skillLevelLabel}
          </span>

          <span class="px-3 py-1 bg-[#172554] text-cyan-300 font-mono font-bold text-xs rounded-md border border-cyan-400/50">
            {repo.language}
          </span>
        </div>

        <!-- Repo Title -->
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white leading-tight flex flex-wrap items-baseline gap-3 m-0">
          {repo.name}
          <span class="text-base sm:text-xl font-mono text-[#c084fc] font-semibold">by {repo.repoOwner}</span>
        </h1>

        <!-- English Overview -->
        <p class="text-base sm:text-lg text-[#f3e8ff] leading-relaxed font-normal m-0">
          {repo.description}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-[#3b1d5c]">
          <a 
            href={repo.githubUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-6 py-3.5 bg-gradient-to-r from-[#8b5cf6] to-[#a855f7] hover:from-[#7c3aed] hover:to-[#9333ea] text-white font-extrabold text-sm rounded-xl transition-all shadow-lg hover:shadow-[0_0_25px_rgba(192,132,252,0.5)] no-underline flex items-center gap-2"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            Official GitHub Repository ↗
          </a>

          {repo.websiteUrl && (
            <a 
              href={repo.websiteUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-6 py-3.5 bg-[#2e1552] border border-[#c084fc]/50 text-[#f3e8ff] font-extrabold text-sm rounded-xl hover:bg-[#3d1b6e] transition-colors no-underline"
            >
              Official Website 🌐
            </a>
          )}
        </div>
      </header>

      <!-- FULL-WIDTH 1-CLICK SETUP COMMAND BANNER (INTEGRATED FRONT & CENTER) -->
      <section class="bg-[#180d30] border-2 border-[#8b5cf6]/60 p-6 sm:p-8 rounded-3xl shadow-2xl space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[#3b1d5c] pb-3">
          <h2 class="text-xl font-extrabold text-white m-0 border-none">
            ⚡ 1-Click Install Commands
          </h2>
          <span class="text-xs text-purple-300">Copy &amp; paste in Terminal or Command Prompt:</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          {repo.installCommand && (
            <div class="p-4 bg-[#0c051a] border border-[#4c247d] rounded-2xl flex flex-col justify-between gap-3">
              <div>
                <span class="block text-[11px] font-bold text-cyan-300 uppercase tracking-wider mb-1">Python / Pip / Git Command:</span>
                <code class="font-mono text-xs text-cyan-300 block break-all">{repo.installCommand}</code>
              </div>
              <button 
                onclick={`navigator.clipboard.writeText('${repo.installCommand}').then(() => { this.innerText = '✅ Copied!'; setTimeout(() => this.innerText = '📋 Copy Command', 2000); })`}
                class="w-full py-2 bg-[#8b5cf6] hover:bg-[#7c3aed] text-white font-sans font-extrabold text-xs rounded-xl transition-all cursor-pointer shadow-md"
              >
                📋 Copy Command
              </button>
            </div>
          )}

          {repo.brewCommand && (
            <div class="p-4 bg-[#0c051a] border border-[#4c247d] rounded-2xl flex flex-col justify-between gap-3">
              <div>
                <span class="block text-[11px] font-bold text-purple-300 uppercase tracking-wider mb-1">macOS Homebrew:</span>
                <code class="font-mono text-xs text-purple-300 block break-all">{repo.brewCommand}</code>
              </div>
              <button 
                onclick={`navigator.clipboard.writeText('${repo.brewCommand}').then(() => { this.innerText = '✅ Copied!'; setTimeout(() => this.innerText = '📋 Copy Command', 2000); })`}
                class="w-full py-2 bg-[#8b5cf6] hover:bg-[#7c3aed] text-white font-sans font-extrabold text-xs rounded-xl transition-all cursor-pointer shadow-md"
              >
                📋 Copy Command
              </button>
            </div>
          )}

          {repo.wingetCommand && (
            <div class="p-4 bg-[#0c051a] border border-[#4c247d] rounded-2xl flex flex-col justify-between gap-3">
              <div>
                <span class="block text-[11px] font-bold text-amber-300 uppercase tracking-wider mb-1">Windows Winget:</span>
                <code class="font-mono text-xs text-amber-300 block break-all">{repo.wingetCommand}</code>
              </div>
              <button 
                onclick={`navigator.clipboard.writeText('${repo.wingetCommand}').then(() => { this.innerText = '✅ Copied!'; setTimeout(() => this.innerText = '📋 Copy Command', 2000); })`}
                class="w-full py-2 bg-[#8b5cf6] hover:bg-[#7c3aed] text-white font-sans font-extrabold text-xs rounded-xl transition-all cursor-pointer shadow-md"
              >
                📋 Copy Command
              </button>
            </div>
          )}

          <!-- Store Cross-Sell Box -->
          <div class="p-4 bg-gradient-to-br from-[#2a134d] to-[#160a2b] border border-[#c084fc]/50 rounded-2xl flex flex-col justify-between gap-3">
            <div>
              <span class="px-2.5 py-0.5 bg-[#e0692a] text-white font-extrabold text-[10px] rounded-full uppercase">₹49 READY APPS</span>
              <p class="text-xs text-white font-bold mt-1">Want pre-compiled 1-click ready installers?</p>
            </div>
            <a href="/digital-store" class="w-full py-2 bg-gradient-to-r from-[#e0692a] to-[#f59e0b] text-white font-extrabold text-xs text-center rounded-xl no-underline hover:opacity-90 shadow-md">
              🛒 Visit Digital Store ➔
            </a>
          </div>
        </div>
      </section>

      <!-- STREAMLINED FULL-WIDTH CONTENT SECTIONS (No Narrow Sidebar Constraints) -->
      
      <!-- Practical Editor Explanation Card -->
      <section class="bg-[#180d30] border border-[#4c247d] p-6 sm:p-8 rounded-3xl shadow-xl">
        <h2 class="text-xl font-extrabold text-[#c084fc] mb-3 flex items-center gap-2 border-none p-0 m-0">
          💡 Creator Practical Breakdown (Hinglish)
        </h2>
        <p class="text-sm sm:text-base text-white font-medium leading-relaxed m-0">
          {repo.summaryHindi}
        </p>
      </section>

      <!-- Key Features List -->
      <section class="bg-[#180d30] border border-[#4c247d] p-6 sm:p-8 rounded-3xl shadow-xl">
        <h2 class="text-xl font-extrabold text-white mb-4 border-none p-0 m-0">
          🚀 Key Features &amp; Technical Capabilities
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {repo.features.map(feat => (
            <div class="flex items-start gap-3 p-3.5 bg-[#120726] border border-[#3b1d5c] rounded-2xl text-sm text-[#f3e8ff]">
              <span class="text-[#c084fc] font-bold text-base shrink-0">✓</span>
              <span>{feat}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Step-by-Step Installation Guide for Creators -->
      <section class="bg-[#180d30] border border-[#4c247d] p-6 sm:p-8 rounded-3xl shadow-xl space-y-4">
        <h2 class="text-xl font-extrabold text-white border-none p-0 m-0 flex items-center gap-2">
          🛠️ Step-by-Step Installation Guide
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs sm:text-sm text-[#e9d5ff]">
          <div class="p-4 bg-[#110722] border border-[#3b1d5c] rounded-2xl">
            <strong class="text-[#c084fc] block mb-1 font-bold text-sm">Step 1: Check System</strong>
            Make sure you have {repo.requirements} installed on your computer.
          </div>
          <div class="p-4 bg-[#110722] border border-[#3b1d5c] rounded-2xl">
            <strong class="text-[#c084fc] block mb-1 font-bold text-sm">Step 2: Copy Command</strong>
            Copy the 1-click command from the top banner for your OS (Windows / macOS).
          </div>
          <div class="p-4 bg-[#110722] border border-[#3b1d5c] rounded-2xl">
            <strong class="text-[#c084fc] block mb-1 font-bold text-sm">Step 3: Run &amp; Enjoy</strong>
            Open Terminal or Command Prompt, paste the command and hit Enter!
          </div>
        </div>
      </section>

      <!-- System Requirements Card -->
      <section class="bg-[#180d30] border border-[#4c247d] p-6 sm:p-8 rounded-3xl shadow-xl">
        <h2 class="text-xl font-extrabold text-[#38bdf8] mb-3 border-none p-0 m-0 flex items-center gap-2">
          ⚙️ Hardware &amp; System Requirements
        </h2>
        <p class="text-sm sm:text-base text-white font-medium leading-relaxed m-0">
          {repo.requirements}
        </p>
      </section>

      <!-- Frequently Asked Questions (FAQ Section for SEO) -->
      <section class="bg-[#180d30] border border-[#4c247d] p-6 sm:p-8 rounded-3xl shadow-xl space-y-4">
        <h2 class="text-xl font-extrabold text-white border-none p-0 m-0">
          ❓ Frequently Asked Questions (FAQs)
        </h2>
        <div class="space-y-4">
          <div class="p-4 bg-[#120726] border border-[#3b1d5c] rounded-2xl">
            <h3 class="text-sm font-extrabold text-[#c084fc] mb-1.5 border-none p-0 m-0">
              Is {repo.name} completely free to use?
            </h3>
            <p class="text-xs sm:text-sm text-[#e9d5ff] leading-relaxed m-0">
              Yes, {repo.name} is 100% free and open-source under open license terms. You can download, modify, and run it locally on your computer without subscription fees.
            </p>
          </div>

          <div class="p-4 bg-[#120726] border border-[#3b1d5c] rounded-2xl">
            <h3 class="text-sm font-extrabold text-[#c084fc] mb-1.5 border-none p-0 m-0">
              How does {repo.name} compare to {repo.alternativeTo}?
            </h3>
            <p class="text-xs sm:text-sm text-[#e9d5ff] leading-relaxed m-0">
              While {repo.alternativeTo} requires monthly subscriptions, {repo.name} provides powerful open-source capabilities with full local privacy and zero cloud fees.
            </p>
          </div>

          <div class="p-4 bg-[#120726] border border-[#3b1d5c] rounded-2xl">
            <h3 class="text-sm font-extrabold text-[#c084fc] mb-1.5 border-none p-0 m-0">
              Can I use {repo.name} for commercial projects?
            </h3>
            <p class="text-xs sm:text-sm text-[#e9d5ff] leading-relaxed m-0">
              Yes! Most open-source GitHub repositories allow commercial creation, YouTube monetization, and client work. Check the official GitHub license for specific terms.
            </p>
          </div>
        </div>
      </section>

      <!-- Related Open-Source Tools Section -->
      {relatedRepos.length > 0 && (
        <section class="pt-6 border-t border-[#3b1d5c]">
          <h2 class="text-2xl font-extrabold text-white mb-6 border-none p-0 m-0">
            🔥 Related Open-Source Tools
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedRepos.map(rel => (
              <a href={`/trending-github-repos/${rel.id}`} class="p-5 bg-[#180d30] border border-[#4c247d] rounded-2xl hover:border-[#c084fc] transition-all no-underline block group">
                <span class="text-xs text-amber-300 font-extrabold block mb-1">★ {rel.stars} stars</span>
                <h3 class="text-lg font-extrabold text-white group-hover:text-[#c084fc] transition-colors m-0 mb-2">{rel.name}</h3>
                <p class="text-xs text-[#f3e8ff] line-clamp-2 m-0 mb-3">{rel.description}</p>
                <span class="text-xs text-[#c084fc] font-bold">View Guide ➔</span>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </div>
</Layout>
